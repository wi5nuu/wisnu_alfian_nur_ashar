# Example environment file - COPY ini ke .env dan isi dengan values yang sebenarnya
# JANGAN commit .env ke git!

# OpenRouter API Configuration
# Dapatkan dari: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model gratis (100% $0): google/gemma-4-26b-a4b-it:free (default)
# Alternatif: nvidia/nemotron-3-nano-30b-a3b:free, inclusionai/ling-3.0-tiny:free
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REFERER=https://wisnualfian.vercel.app
OPENROUTER_TITLE=Wisnu Portfolio AI

# Admin Token untuk dashboard donasi
# Generate dengan: openssl rand -hex 32
# Minimum 32 karakter untuk keamanan
ADMIN_TOKEN=your_secure_admin_token_here_min_32_chars
