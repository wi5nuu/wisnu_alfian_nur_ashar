# Example environment file - COPY ini ke .env dan isi dengan values yang sebenarnya
# JANGAN commit .env ke git!

# Hugging Face API Key (untuk AI Chatbot - GRATIS!)
# Dapatkan dari: https://huggingface.co/settings/tokens
# 1. Buat akun di https://huggingface.co
# 2. Pergi ke Settings > Access Tokens
# 3. Klik "New token" dan pilih "Read" access
# 4. Copy token dan paste di sini
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Token untuk dashboard donasi
# Generate dengan: openssl rand -hex 32
# Minimum 32 karakter untuk keamanan
ADMIN_TOKEN=your_secure_admin_token_here_min_32_chars
