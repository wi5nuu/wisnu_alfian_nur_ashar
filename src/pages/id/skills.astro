---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Skills from "../../components/Skills.astro";

const title = "Keahlian & Teknologi | Wisnu Alfian Nur Ashar";
const description = "Stack teknologi Wisnu Alfian Nur Ashar — React, Next.js, Laravel, TypeScript, PostgreSQL, Docker, dan keamanan siber. Keahlian full-stack untuk magang dan pekerjaan profesional.";
---

<Layout title={title} description={description}>
  <Navbar />
  <main>
    <Skills />
  </main>
  <Footer />
</Layout>

<script>
	const observerOptions = {
		threshold: 0.1,
		rootMargin: "0px 0px -50px 0px",
	};

	let observer = null;

	const initObserver = () => {
		if (!observer) {
			observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("active");
					}
				});
			}, observerOptions);
		}

		const revealElements = document.querySelectorAll(
			".reveal-up, .reveal-down, .reveal-left, .reveal-right, .reveal-zoom"
		);
		revealElements.forEach((el) => observer.observe(el));
	};

	document.addEventListener("astro:page-load", initObserver);

	document.addEventListener("astro:before-swap", () => {
		if (observer) {
			observer.disconnect();
			observer = null;
		}
	});

</script>
