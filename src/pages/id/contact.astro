---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/sections/Contact.astro";

const title = "Kontak | Wisnu Alfian Nur Ashar";
const description = "Hubungi Wisnu Alfian Nur Ashar untuk peluang magang, proyek full-stack, atau kolaborasi open-source. Berbasis di Bekasi, tersedia secara remote.";
---

<Layout title={title} description={description}>
    <Header />
    <main class="pt-20 min-h-[80vh] flex flex-col justify-center">
        <ContactSection />
    </main>
    <Footer />
</Layout>
