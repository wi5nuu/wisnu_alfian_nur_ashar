---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { profile } from "../../../data/profile_id";
import { projectDetailsId } from "../../../data/projectDetails_id";
import { getProjectSlug } from "../../../utils/slug";
import { ArrowLeft, ExternalLink, Github, CheckCircle } from "lucide-astro";
import Picture from "../../../components/Picture.astro";

export async function getStaticPaths() {
  return profile.projects.map((project) => {
    const slug = getProjectSlug(project.title);
    const detail = projectDetailsId[slug];
    return {
      params: { slug },
      props: { project, detail }
    };
  });
}

const { project, detail } = Astro.props;
const title = `${project.title} | Wisnu Alfian Nur Ashar`;
const description = project.description;
---

<Layout title={project.title} description={description} ogType="article">
  <Navbar />

  <main class="project-detail">
    <div class="container">
      <a href="/id/projects" class="back-link">
        <ArrowLeft class="back-icon" />
        <span>Kembali ke Proyek</span>
      </a>

      {project.image && (
        <figure class="project-media reveal-up">
          <div class="browser-bar">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <Picture
            src={project.image}
            alt={project.title}
            class="project-image"
            loading="eager"
          />
        </figure>
      )}

      <header class="project-header reveal-up">
        <div class="badge-row">
          <span class={`status-badge ${project.status === "Production" ? "production" : "development"}`}>
            {project.status === "Production" ? "Produksi" : project.status}
          </span>
          {project.featured && (
            <span class="featured-badge">Andalan</span>
          )}
        </div>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-role">{project.role}</p>
      </header>

      <div class="action-row reveal-up">
        {project.link && project.link !== "#" && (
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <ExternalLink class="btn-icon" />
            <span>Demo Langsung</span>
          </a>
        )}
        {project.github && (
          <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Github class="btn-icon" />
            <span>Kode Sumber</span>
          </a>
        )}
      </div>

      <div class="content-grid">
        <aside class="sidebar">
          {detail && (
            <div class="side-card reveal-up">
              <h3 class="side-title">Tech Stack</h3>
              {detail.detailedTechStack.map((cat) => (
                <div class="side-block">
                  <h4 class="side-subtitle">{cat.category}</h4>
                  <div class="tag-row">
                    {cat.items.map((tech) => (
                      <span class="tag">{tech}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}

          <div class="side-card reveal-up">
            <h3 class="side-title">Info Cepat</h3>
            <div class="info-row">
              <span class="info-label">Peran</span>
              <span class="info-value">{project.role}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Status</span>
              <span class={`info-value ${project.status === "Production" ? "production-text" : "dev-text"}`}>{project.status === "Production" ? "Produksi" : project.status}</span>
            </div>
          </div>
        </aside>

        <div class="main-content">
          <section class="content-section reveal-up">
            <h2 class="section-title">Gambaran Umum</h2>
            <p class="section-text">{project.description}</p>
          </section>

          {detail && (
            <>
              <section class="content-section reveal-up">
                <h2 class="section-title">Masalah</h2>
                <p class="section-text">{detail.problemStatement}</p>
              </section>

              <section class="content-section reveal-up">
                <h2 class="section-title">Solusi</h2>
                <p class="section-text">{detail.solution}</p>
              </section>

              <section class="content-section reveal-up">
                <h2 class="section-title">Fitur Unggulan</h2>
                <div class="feature-list">
                  {detail.keyFeatures.map((feature) => (
                    <div class="feature-card">
                      <CheckCircle class="feature-icon" />
                      <div>
                        <h3 class="feature-title">{feature.title}</h3>
                        <p class="feature-desc">{feature.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </section>

              {detail.architecture && (
                <section class="content-section reveal-up">
                  <h2 class="section-title">Arsitektur</h2>
                  <p class="section-text">{detail.architecture}</p>
                </section>
              )}

              <section class="content-section reveal-up">
                <h2 class="section-title">Cara Penggunaan</h2>
                <p class="section-text">{detail.howToUse}</p>
              </section>

              <section class="content-section reveal-up">
                <h2 class="section-title">Dampak &amp; Hasil</h2>
                <p class="section-text">{detail.impact}</p>
              </section>
            </>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  let observer = null;

  const initObserver = () => {
    if (!observer) {
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      }, observerOptions);
    }

    const revealElements = document.querySelectorAll(".reveal-up");
    revealElements.forEach((el) => observer.observe(el));
  };

  document.addEventListener("astro:page-load", initObserver);

  document.addEventListener("astro:before-swap", () => {
    if (observer) {
      observer.disconnect();
      observer = null;
    }
  });
</script>

<style>
  .project-detail {
    background-color: var(--bg);
    color: #ffffff;
    min-height: 100vh;
    padding-block: 180px 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
  }

  /* Back link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.3s ease;
    margin-bottom: 32px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .back-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .back-link:hover .back-icon {
    transform: translateX(-3px);
  }

  /* Browser frame */
  .project-media {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background-color: #0a0a0a;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    background-color: #1a1a1a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot.red    { background-color: #ff5f57; }
  .dot.yellow { background-color: #febc2e; }
  .dot.green  { background-color: #28c840; }

  .project-image {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Header */
  .project-header {
    margin-top: 40px;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .status-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 4px 12px;
  }

  .status-badge.production {
    color: var(--accent);
    background-color: rgba(132, 225, 12, 0.1);
    border: 1px solid rgba(132, 225, 12, 0.25);
  }

  .status-badge.development {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .featured-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fbbf24;
    background-color: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .project-title {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
  }

  .project-role {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  /* Action buttons */
  .action-row {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--accent);
    color: #0A0A0A;
    border-radius: 999px;
    padding: 13px 26px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.3s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 13px 26px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-1px);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
  }

  /* Layout grid */
  .content-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .side-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px;
  }

  .side-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0 0 20px;
  }

  .side-block {
    margin-bottom: 18px;
  }

  .side-block:last-child {
    margin-bottom: 0;
  }

  .side-subtitle {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 10px;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
  }

  .info-value {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    text-align: right;
  }

  .info-value.production-text {
    color: var(--accent);
  }

  .info-value.dev-text {
    color: #ffffff;
  }

  /* Main content */
  .main-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .content-section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 48px;
  }

  .content-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin: 0 0 16px;
  }

  .section-text {
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 18px 20px;
  }

  .feature-icon {
    width: 20px;
    height: 20px;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-title {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .sidebar {
      position: static;
      order: 2;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .side-card {
      flex: 1;
      min-width: 260px;
    }

    .main-content {
      order: 1;
    }
  }

  @media (max-width: 768px) {
    .project-detail {
      padding-block: 140px 80px;
    }

    .project-title {
      font-size: 32px;
    }
  }

  @media (max-width: 640px) {
    .sidebar {
      flex-direction: column;
    }

    .side-card {
      min-width: 0;
    }
  }
</style>
