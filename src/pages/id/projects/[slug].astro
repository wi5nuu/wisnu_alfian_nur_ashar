---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { profile } from "../../../data/profile_id";
import { projectDetailsId } from "../../../data/projectDetails_id";
import { getProjectSlug } from "../../../utils/slug";
import { ArrowLeft, ExternalLink, Github, CheckCircle } from "lucide-astro";

export async function getStaticPaths() {
  return profile.projects.map((project) => {
    const slug = getProjectSlug(project.title);
    const detail = projectDetailsId[slug];
    return {
      params: { slug },
      props: { project, detail }
    };
  });
}

const { project, detail } = Astro.props;
const title = `${project.title} | Wisnu Alfian Nur Ashar`;
const description = project.description;
---

<Layout title={project.title} description={description} ogType="article">
  <Header />

  <main class="pt-24 md:pt-28 pb-16">
    <article class="container-custom max-w-4xl">
      <div class="mb-6 reveal-up">
        <a href="/id/projects" class="inline-flex items-center gap-1.5 text-sm text-sage-600 dark:text-sage-400 hover:text-sage-800 dark:hover:text-sage-200 transition-colors group">
          <ArrowLeft class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" />
          <span>Kembali ke Proyek</span>
        </a>
      </div>

      {project.image && (
        <div class="relative w-full rounded-2xl overflow-hidden shadow-xl mb-8 reveal-up">
          <div class="w-full h-6 bg-slate-100 dark:bg-slate-700 border-b border-slate-200 dark:border-transparent flex items-center gap-1.5 px-4">
            <div class="w-2 h-2 rounded-full bg-red-400"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
            <div class="w-2 h-2 rounded-full bg-green-400"></div>
          </div>
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-56 md:h-80 lg:h-96 object-cover object-top bg-slate-50 dark:bg-slate-800"
          />
        </div>
      )}

      <header class="mb-8 reveal-up">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <span class={`text-[11px] uppercase tracking-widest font-bold px-2.5 py-1 rounded-full ${project.status === "Production" ? "bg-emerald-50 text-emerald-600 border border-emerald-100 dark:bg-emerald-900/40 dark:text-emerald-400 dark:border-transparent" : "bg-sage-50 text-sage-600 border border-sage-100 dark:bg-sage-900/40 dark:text-sage-300 dark:border-transparent"}`}>
            {project.status === "Production" ? "Produksi" : project.status}
          </span>
          {project.featured && (
            <span class="text-[11px] uppercase tracking-widest font-bold bg-amber-50 text-amber-600 border border-amber-100 dark:bg-amber-900/40 dark:text-amber-400 dark:border-transparent px-2.5 py-1 rounded-full">
              Andalan
            </span>
          )}
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-2 leading-tight">
          {project.title}
        </h1>
        <p class="text-sage-600 dark:text-sage-400 font-semibold text-sm md:text-base uppercase tracking-wider">
          {project.role}
        </p>
      </header>

      <div class="flex flex-wrap gap-3 mb-10 reveal-up">
        {project.link && project.link !== "#" && (
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 dark:bg-sage-600 text-white rounded-xl text-sm font-bold hover:bg-slate-800 dark:hover:bg-sage-500 transition-all shadow-md group">
            <ExternalLink class="w-4 h-4" />
            <span>Demo Langsung</span>
          </a>
        )}
        {project.github && (
          <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-300 dark:border-slate-600 text-slate-900 dark:text-white rounded-xl text-sm font-bold hover:bg-slate-100 dark:hover:bg-slate-800 transition-all group">
            <Github class="w-4 h-4" />
            <span>Kode Sumber</span>
          </a>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <aside class="lg:col-span-1 order-2 lg:order-1">
          <div class="sticky top-24 space-y-6">
            {detail && (
              <div class="bg-white dark:bg-slate-800/60 rounded-2xl border border-slate-100 dark:border-slate-700/50 p-5 reveal-up">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4">Tech Stack</h3>
                {detail.detailedTechStack.map((cat) => (
                  <div class="mb-4 last:mb-0">
                    <h4 class="text-[11px] font-bold text-sage-600 dark:text-sage-400 uppercase tracking-widest mb-2">{cat.category}</h4>
                    <div class="flex flex-wrap gap-1.5">
                      {cat.items.map((tech) => (
                        <span class="px-2 py-1 bg-slate-50 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300 text-[10px] font-medium border border-slate-100 dark:border-transparent rounded">{tech}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}

            <div class="bg-white dark:bg-slate-800/60 rounded-2xl border border-slate-100 dark:border-slate-700/50 p-5 reveal-up">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4">Info Cepat</h3>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-slate-500 dark:text-slate-400">Peran</span>
                  <span class="text-slate-900 dark:text-white font-medium text-right">{project.role}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500 dark:text-slate-400">Status</span>
                  <span class={`font-medium ${project.status === "Production" ? "text-emerald-600 dark:text-emerald-400" : "text-sage-600 dark:text-sage-300"}`}>{project.status === "Production" ? "Produksi" : project.status}</span>
                </div>
              </div>
            </div>
          </div>
        </aside>

        <div class="lg:col-span-2 order-1 lg:order-2 space-y-8">
          <section class="reveal-up">
            <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Gambaran Umum</h2>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{project.description}</p>
          </section>

          {detail && (
            <>
              <section class="reveal-up">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Masalah</h2>
                <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{detail.problemStatement}</p>
              </section>

              <section class="reveal-up">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Solusi</h2>
                <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{detail.solution}</p>
              </section>

              <section class="reveal-up">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-4">Fitur Unggulan</h2>
                <div class="space-y-4">
                  {detail.keyFeatures.map((feature) => (
                    <div class="bg-white dark:bg-slate-800/40 rounded-xl border border-slate-100 dark:border-slate-700/30 p-4 md:p-5">
                      <div class="flex items-start gap-3">
                        <CheckCircle class="w-5 h-5 text-sage-500 dark:text-sage-400 mt-0.5 shrink-0" />
                        <div>
                          <h3 class="font-bold text-slate-900 dark:text-white text-sm mb-1">{feature.title}</h3>
                          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">{feature.description}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </section>

              {detail.architecture && (
                <section class="reveal-up">
                  <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Arsitektur</h2>
                  <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{detail.architecture}</p>
                </section>
              )}

              <section class="reveal-up">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Cara Penggunaan</h2>
                <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{detail.howToUse}</p>
              </section>

              <section class="reveal-up">
                <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">Dampak &#38; Hasil</h2>
                <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{detail.impact}</p>
              </section>
            </>
          )}
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
