---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectsSection from "../../components/sections/Projects.astro";

const title = "Proyek | Wisnu Alfian Nur Ashar";
const description = "Proyek full-stack oleh Wisnu Alfian Nur Ashar — dibangun dengan React, Next.js, Laravel, dan lainnya. 10+ aplikasi production yang melayani 15K+ pengguna.";
---

<Layout title={title} description={description}>
    <Header />
    <main class="pt-20">
        <ProjectsSection />
    </main>
    <Footer />
</Layout>
