---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AboutSection from "../../components/sections/About.astro";
import Achievements from "../../components/sections/Achievements.astro";

const title = "Tentang Saya | Wisnu Alfian Nur Ashar";
const description =
    "Pelajari lebih lanjut tentang latar belakang, pendidikan, dan perjalanan profesional saya.";
---

