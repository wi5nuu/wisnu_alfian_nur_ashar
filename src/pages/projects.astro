---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectsSection from "../components/sections/Projects.astro";
import { profile } from "../data/profile";

const title = "Projects | Wisnu Alfian Nur Ashar";
const description = "Full-stack web projects by Wisnu Alfian Nur Ashar — built with React, Next.js, Laravel, and more. 10+ production apps serving 15K+ users across real-world use cases.";
