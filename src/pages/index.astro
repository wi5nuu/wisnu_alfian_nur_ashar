---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import WhyWorkWithMe from "../components/WhyWorkWithMe.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import AboutMe from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import EducationCerts from "../components/EducationCerts.astro";
import Achievements from "../components/Achievements.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/profile";

const title = `${profile.personalInfo.name} | ${profile.personalInfo.role}`;
const description = profile.personalInfo.summary;
---

<Layout title={title} description={description}>
	<Navbar />

	<main>
		<Hero />
		<AboutMe />
		<SelectedWork />
		<Process />
		<Services />
		<WhyWorkWithMe />
		<Stats />
		<Experience />
		<Skills />
		<EducationCerts />
		<Achievements />
		<Testimonials />
		<Contact />
	</main>
	<Footer />
</Layout>

<script>
	const observerOptions = {
		threshold: 0.1,
		rootMargin: "0px 0px -50px 0px",
	};

	let observer = null;

	const initObserver = () => {
		if (!observer) {
			observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("active");
					}
				});
			}, observerOptions);
		}

		const revealElements = document.querySelectorAll(
			".reveal-up, .reveal-down, .reveal-left, .reveal-right, .reveal-zoom"
		);
		revealElements.forEach((el) => observer.observe(el));
	};

	document.addEventListener("astro:page-load", initObserver);

	document.addEventListener("astro:before-swap", () => {
		if (observer) {
			observer.disconnect();
			observer = null;
		}
	});

</script>
