---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Experience from "../components/sections/Experience.astro";
import Projects from "../components/sections/Projects.astro";
import Skills from "../components/sections/Skills.astro";
import EducationCertifications from "../components/sections/EducationCertifications.astro";
import Contact from "../components/sections/Contact.astro";
import { profile } from "../data/profile";

const title = `${profile.personalInfo.name} | ${profile.personalInfo.role}`;
const description = profile.personalInfo.summary;
---

<Layout title={title} description={description}>
	<Header />

	<!-- Floating Photo (desktop only - moves between Hero and About on scroll) -->
	<div
		id="floating-photo"
		class="hidden md:block fixed z-30 will-change-[transform,opacity] pointer-events-none"
	>
		<div class="w-[240px] lg:w-[300px] h-[300px] lg:h-[380px] rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10 bg-white">
			<img
				src="/wisnu_alfian_nur_ashar.jpeg"
				alt={profile.personalInfo.name}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="w-full h-full object-cover"
			/>
		</div>
	</div>

	<main>
		<Hero />
		<About />
		<Experience />
		<Projects />
		<Skills />
		<EducationCertifications />
		<Contact />
	</main>
	<Footer />
</Layout>

<script>
	const observerOptions = {
		threshold: 0.1,
		rootMargin: "0px 0px -50px 0px",
	};

	let observer = null;

	document.addEventListener("astro:page-load", () => {
		if (!observer) {
			observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("active");
					}
				});
			}, observerOptions);
		}

		const revealElements = document.querySelectorAll(".reveal-up");
		revealElements.forEach((el) => observer.observe(el));
	});

	document.addEventListener("astro:before-swap", () => {
		if (observer) {
			observer.disconnect();
			observer = null;
		}
	});

	// --- FLOATING PHOTO SCROLL INTERPOLATION (desktop only) ---
	const floatingPhoto = document.getElementById("floating-photo") as HTMLElement | null;
	const heroTarget = document.getElementById("hero-photo-target") as HTMLElement | null;
	const aboutTarget = document.getElementById("about-photo-target") as HTMLElement | null;

	if (floatingPhoto && heroTarget && aboutTarget && window.innerWidth >= 768) {
		const lerp = (start: number, end: number, t: number) => start + (end - start) * t;
		const clamp = (val: number, min: number, max: number) => Math.min(Math.max(val, min), max);

		let cleanup: (() => void) | null = null;
		let heroDocX = 0, heroDocY = 0, aboutDocX = 0, aboutDocY = 0, scrollRange = 0;

		const capturePositions = () => {
			const heroRect = heroTarget.getBoundingClientRect();
			const aboutRect = aboutTarget.getBoundingClientRect();
			const scrollY = window.scrollY;

			// Store centers in document space
			heroDocX = heroRect.left + heroRect.width / 2;
			heroDocY = heroRect.top + scrollY + heroRect.height / 2;
			aboutDocX = aboutRect.left + aboutRect.width / 2;
			aboutDocY = aboutRect.top + scrollY + aboutRect.height / 2;
			scrollRange = aboutDocY - heroDocY;
		};

		const updatePosition = () => {
			const photoWidth = floatingPhoto.offsetWidth;
			const photoHeight = floatingPhoto.offsetHeight;
			const currentScrollY = window.scrollY;

			// Progress based on current scroll vs fixed range
			const progress = clamp(currentScrollY / scrollRange, 0, 1);

			// Smooth easing (ease-in-out cubic)
			const easedProgress = progress < 0.5
				? 4 * progress * progress * progress
				: 1 - Math.pow(-2 * progress + 2, 3) / 2;

			// Interpolate center position in document space
			const centerDocX = lerp(heroDocX, aboutDocX, easedProgress);
			const centerDocY = lerp(heroDocY, aboutDocY, easedProgress);

			// Convert to viewport space for the fixed element
			// At Hero (progress=0): photo is centered on hero target
			// At About (progress=1): photo top aligns with about target top
			const targetX = centerDocX - photoWidth / 2;
			// At About, position photo so its top aligns with the target's top
			const targetY = centerDocY - photoHeight / 2 - currentScrollY + easedProgress * (aboutTarget.offsetHeight / 2);

			// Subtle scale effect
			const scale = lerp(1.03, 1, easedProgress);

			// Subtle rotation during transition
			const rotation = Math.sin(progress * Math.PI) * 1.5;

			// Apply transform
			floatingPhoto.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) scale(${scale}) rotate(${rotation}deg)`;
		};

		// Use requestAnimationFrame for smooth updates
		let ticking = false;
		const onScroll = () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					updatePosition();
					ticking = false;
				});
				ticking = true;
			}
		};

		// Initial capture and position
		capturePositions();
		updatePosition();

		// Listen for scroll and resize
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", () => {
			capturePositions();
			requestAnimationFrame(updatePosition);
		}, { passive: true });

		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
		};

		// Re-setup after Astro view transitions
		document.addEventListener("astro:page-load", () => {
			if (cleanup) cleanup();
			capturePositions();
			updatePosition();
			window.addEventListener("scroll", onScroll, { passive: true });
			cleanup = () => {
				window.removeEventListener("scroll", onScroll);
			};
		});

		document.addEventListener("astro:before-swap", () => {
			if (cleanup) cleanup();
			cleanup = null;
		});
	}
</script>
