---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AboutSection from "../components/sections/About.astro";
import Achievements from "../components/sections/Achievements.astro";

const title = "About Me | Wisnu Alfian Nur Ashar";
const description =
    "Learn more about my background, education, and professional journey.";
---

<Layout title={title} description={description}>
    <Header />
    <main class="pt-20">
        <AboutSection />
        <Achievements />
    </main>
    <Footer />
</Layout>
