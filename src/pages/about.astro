---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import AboutSection from "../components/sections/About.astro";
import Achievements from "../components/sections/Achievements.astro";

const title = "About Me | Wisnu Alfian Nur Ashar";
const description = "Full-Stack Engineer & Cybersecurity enthusiast from Bekasi. President University student with 100+ GitHub repos, penetration testing (external/internal) with structured reporting, open-source contributions to NASA, Microsoft, Google, and NVIDIA.";
---

