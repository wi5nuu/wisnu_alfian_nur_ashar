---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin Dashboard — Donations" description="Manage donation confirmations">
  <main class="min-h-screen bg-slate-50 dark:bg-slate-900 py-12 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <h1 class="text-3xl font-serif font-bold text-slate-950 dark:text-white mb-2">🍩 Donation Dashboard</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Confirm pending donations to show them on the public supporter list</p>
      </div>

      <div id="login-section" class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-3xl p-6 md:p-8 shadow-xl">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🔐</span>
          </div>
          <h2 class="text-lg font-bold text-slate-950 dark:text-white mb-2">Admin Access</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">Enter your admin token to manage donations</p>
          <input id="token-input" type="password" placeholder="Enter admin token" class="w-full max-w-xs px-4 py-3 rounded-2xl bg-white dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 text-slate-900 dark:text-white text-sm text-center focus:outline-none focus:border-slate-950 dark:focus:border-white mb-3 mx-auto block" />
          <button id="login-btn" class="px-8 py-3 rounded-2xl bg-slate-950 dark:bg-white text-white dark:text-slate-950 text-sm font-bold hover:bg-slate-800 dark:hover:bg-slate-200 transition-all active:scale-95 cursor-pointer">
            Login
          </button>
          <p id="login-error" class="text-red-500 text-xs mt-3 hidden">Invalid token. Please try again.</p>
        </div>
      </div>

      <div id="dashboard-section" class="hidden">
        <div id="stats-bar" class="grid grid-cols-3 gap-3 mb-6"></div>

        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-3xl p-6 md:p-8 shadow-xl mb-6">
          <h2 class="text-lg font-bold text-slate-950 dark:text-white mb-4 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-400 animate-pulse"></span>
            Pending Confirmations
          </h2>
          <div id="pending-list" class="space-y-3">
            <p class="text-slate-400 dark:text-slate-500 text-sm text-center py-8">No pending donations.</p>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-3xl p-6 md:p-8 shadow-xl">
          <h2 class="text-lg font-bold text-slate-950 dark:text-white mb-4 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            Confirmed Donors
          </h2>
          <div id="confirmed-list" class="space-y-3">
            <p class="text-slate-400 dark:text-slate-500 text-sm text-center py-8">No confirmed donations yet.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const TOKEN_KEY = 'admin_session_token';
  const LOGIN_SECTION = document.getElementById('login-section');
  const DASHBOARD_SECTION = document.getElementById('dashboard-section');
  const TOKEN_INPUT = document.getElementById('token-input');
  const LOGIN_BTN = document.getElementById('login-btn');
  const LOGIN_ERROR = document.getElementById('login-error');
  const PENDING_LIST = document.getElementById('pending-list');
  const CONFIRMED_LIST = document.getElementById('confirmed-list');
  const STATS_BAR = document.getElementById('stats-bar');

  let token = localStorage.getItem(TOKEN_KEY) || '';

  const authHeaders = () => ({
    'Content-Type': 'application/json',
    'Authorization': `Bearer ${token}`,
  });

  const formatPrice = (amount) => 'Rp' + amount.toLocaleString('id-ID');
  const formatDate = (ts) => new Date(ts).toLocaleDateString('id-ID', {
    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
  });

  const showLogin = () => {
    LOGIN_SECTION.classList.remove('hidden');
    DASHBOARD_SECTION.classList.add('hidden');
  };

  const showDashboard = () => {
    LOGIN_SECTION.classList.add('hidden');
    DASHBOARD_SECTION.classList.remove('hidden');
  };

  const fetchDonations = async () => {
    try {
      const res = await fetch('/api/donations?type=all', { headers: authHeaders() });
      if (!res.ok) throw new Error('Unauthorized');
      return await res.json();
    } catch {
      localStorage.removeItem(TOKEN_KEY);
      token = '';
      showLogin();
      return null;
    }
  };

  const renderDashboard = async () => {
    const data = await fetchDonations();
    if (!data) return;
    const { donations, stats } = data;

    STATS_BAR.innerHTML = `
      <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-4 text-center">
        <div class="text-2xl font-bold text-slate-950 dark:text-white">${stats.total}</div>
        <div class="text-[10px] uppercase tracking-wider font-bold text-slate-400 dark:text-slate-500 mt-1">Total</div>
      </div>
      <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-4 text-center">
        <div class="text-2xl font-bold text-amber-500">${stats.pending}</div>
        <div class="text-[10px] uppercase tracking-wider font-bold text-slate-400 dark:text-slate-500 mt-1">Pending</div>
      </div>
      <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-4 text-center">
        <div class="text-2xl font-bold text-emerald-500">${stats.totalDonuts}</div>
        <div class="text-[10px] uppercase tracking-wider font-bold text-slate-400 dark:text-slate-500 mt-1">Donuts 🍩</div>
      </div>
    `;

    const pending = donations.filter(d => !d.confirmed);
    const confirmed = donations.filter(d => d.confirmed);

    if (pending.length === 0) {
      PENDING_LIST.innerHTML = '<p class="text-slate-400 dark:text-slate-500 text-sm text-center py-8">✅ All caught up! No pending donations.</p>';
    } else {
      PENDING_LIST.innerHTML = pending.map(d => `
        <div class="flex items-center gap-4 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30 rounded-2xl p-4">
          <div class="w-11 h-11 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-base font-bold text-amber-700 dark:text-amber-400 flex-shrink-0">${d.name.charAt(0).toUpperCase()}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-bold text-slate-900 dark:text-white">${d.name}</span>
              <span class="inline-flex items-center gap-1 text-[10px] px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-bold">🍩 ${d.qty}</span>
            </div>
            ${d.message ? `<p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">"${d.message}"</p>` : ''}
            <p class="text-[10px] text-slate-300 dark:text-slate-600 mt-0.5">${formatDate(d.timestamp)} · ${d.method.toUpperCase()} · ${formatPrice(d.qty * 5000)}</p>
          </div>
          <button data-id="${d.id}" class="confirm-btn px-4 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shadow-sm">
            <span>✅</span>
            <span>Confirm</span>
          </button>
        </div>
      `).join('');
    }

    if (confirmed.length === 0) {
      CONFIRMED_LIST.innerHTML = '<p class="text-slate-400 dark:text-slate-500 text-sm text-center py-8">No confirmed donations yet.</p>';
    } else {
      CONFIRMED_LIST.innerHTML = confirmed.map(d => {
        const colors = ['bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400', 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400', 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400'];
        return `
          <div class="flex items-center gap-4 bg-white dark:bg-slate-700/30 border border-slate-100 dark:border-slate-700/50 rounded-2xl p-4 opacity-80">
            <div class="w-11 h-11 rounded-2xl ${colors[d.name.length % 3]} flex items-center justify-center text-base font-bold flex-shrink-0">${d.name.charAt(0).toUpperCase()}</div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-bold text-slate-900 dark:text-white">${d.name}</span>
                <span class="inline-flex items-center gap-1 text-[10px] px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 font-bold">🍩 ${d.qty}</span>
                <span class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 font-bold">Confirmed</span>
              </div>
              <p class="text-[10px] text-slate-300 dark:text-slate-600 mt-0.5">${formatDate(d.timestamp)} · ${d.method.toUpperCase()} · ${formatPrice(d.qty * 5000)}</p>
            </div>
          </div>
        `;
      }).join('');
    }

    document.querySelectorAll('.confirm-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span><span>...</span>';

        try {
          const res = await fetch('/api/donations/confirm', {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify({ id }),
          });

          if (!res.ok) throw new Error('Failed');
          await renderDashboard();
        } catch {
          btn.disabled = false;
          btn.innerHTML = '<span>❌</span><span>Error</span>';
        }
      });
    });
  };

  const doLogin = async () => {
    const inputToken = TOKEN_INPUT.value.trim();
    if (!inputToken) return;

    token = inputToken;
    localStorage.setItem(TOKEN_KEY, token);

    try {
      const res = await fetch('/api/donations?type=all', { headers: authHeaders() });
      if (!res.ok) throw new Error('Invalid');
      LOGIN_ERROR.classList.add('hidden');
      showDashboard();
      renderDashboard();
    } catch {
      LOGIN_ERROR.classList.remove('hidden');
      localStorage.removeItem(TOKEN_KEY);
      token = '';
    }
  };

  LOGIN_BTN.addEventListener('click', doLogin);
  TOKEN_INPUT.addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); });

  if (token) {
    fetch('/api/donations?type=all', { headers: authHeaders() }).then(res => {
      if (res.ok) { showDashboard(); renderDashboard(); }
      else { localStorage.removeItem(TOKEN_KEY); token = ''; showLogin(); }
    });
  }
</script>