---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page not found | Wisnu Alfian Nur Ashar" description="This page does not exist. Head back to the portfolio of Wisnu Alfian Nur Ashar." noIndex breadcrumbs={[]}>
  <Navbar />
  <main id="main" tabindex="-1" class="nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Signal lost.</h1>
    <p class="nf-text">This route does not exist — maybe it moved, maybe it never did. Pick a way back in:</p>
    <nav class="nf-links" aria-label="Helpful links">
      <a class="nf-primary" href="/">Home</a>
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
    <p class="nf-hint">Psst — press <kbd>`</kbd> on any page for the hacker terminal.</p>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 80px;
    background:
      radial-gradient(ellipse 50% 40% at 50% 38%, rgba(132, 225, 12, 0.16), transparent 70%),
      linear-gradient(rgba(132, 225, 12, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(132, 225, 12, 0.06) 1px, transparent 1px),
      #0A0A0A;
    background-size: auto, 44px 44px, 44px 44px, auto;
    color: #fff;
    font-family: var(--font-sans);
  }
  .nf-code {
    margin: 0;
    font-size: clamp(96px, 22vw, 220px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--accent);
    animation: nf-glitch 3.5s steps(1) infinite;
  }
  .nf h1 { margin: 12px 0 0; color: #fff; font-family: var(--font-sans); font-size: clamp(28px, 4vw, 44px); font-weight: 500; }
  .nf-text { margin: 12px 0 0; max-width: 460px; color: rgba(255, 255, 255, 0.7); font-size: 15px; line-height: 1.6; }
  .nf-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  .nf-links a {
    padding: 12px 24px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff; text-decoration: none; font-size: 14px; font-weight: 500; transition: background 0.25s, border-color 0.25s, color 0.25s;
  }
  .nf-links a:hover, .nf-links a:focus-visible { border-color: var(--accent); background: rgba(132, 225, 12, 0.1); outline: none; }
  .nf-links .nf-primary { background: var(--accent); border-color: var(--accent); color: #0A0A0A; }
  .nf-links .nf-primary:hover { background: var(--accent); filter: brightness(1.1); }
  .nf-hint { margin: 32px 0 0; font-size: 12px; color: rgba(255, 255, 255, 0.45); }
  .nf-hint kbd { padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.3); font-family: ui-monospace, Menlo, Consolas, monospace; color: var(--accent); }
  @keyframes nf-glitch {
    0%, 92%, 100% { transform: none; }
    93% { transform: translate(-4px, 1px); }
    95% { transform: translate(5px, -2px); }
    97% { transform: translate(-2px, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .nf-code { animation: none; } }
</style>
