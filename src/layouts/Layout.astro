---
import "../styles/global.css";
import AIChatBot from "../components/AIChatBot.astro";
import { profile } from "../data/profile";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  url?: string;
}

const {
  title,
  description = profile.personalInfo.summary,
  url = Astro.url.href,
} = Astro.props;

const siteName = "Wisnu Alfian Nur Ashar | Senior Full-Stack Developer Portfolio";
const image = `${url}wisnu_alfian_nur_ashar.jpeg`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- ================= BASIC ================= -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {profile.personalInfo.name}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.personalInfo.name} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Wisnu Alfian Nur Ashar, Full-Stack Developer, President University, IT Software Engineer, Web Developer Bekasi, React Developer, Next.js Expert, Cybersecurity, Career Coach"
    />

    <!-- ================= RESOURCE HINTS (Performance) ================= -->
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://cdn.simpleicons.org" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />
    <link rel="dns-prefetch" href="https://api.web3forms.com" />

    <!-- Prefetch critical resources -->
    <link rel="preload" href="/wisnu_alfian_nur_ashar.jpeg" as="image" fetchpriority="high" />
    <link rel="preload" href="/logo.png" as="image" fetchpriority="high" />

    <!-- ================= VIEW TRANSITIONS ================= -->
    <ClientRouter />

    <!-- ================= CANONICAL ================= -->
    <link rel="canonical" href={url} />

    <!-- ================= GOOGLE VERIFICATION ================= -->
    <meta
      name="google-site-verification"
      content="EJ_C4tjJumyHkl6RwAdqafUs-zgyK2KjvQ6zTy1_LDQ"
    />

    <!-- ================= THEME ================= -->
    <meta name="theme-color" content="#0f172a" />

    <!-- ================= OPEN GRAPH ================= -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- ================= TWITTER ================= -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- ================= FAVICON & PWA ================= -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- ================= SECURITY (CSP) ================= -->
    <meta
      http-equiv="Content-Security-Policy"
      content="
  default-src 'self';
  script-src 'self' 'unsafe-inline'; 
  style-src 'self' 'unsafe-inline';
  img-src 'self' data: https:;
  connect-src 'self' https://api.web3forms.com;
  font-src 'self';
"
    />



    <!-- ================= SCHEMA PERSON ================= -->
    <script type="application/ld+json" is:inline define:vars={{ profile, url, image }}>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": profile.personalInfo.name,
        "url": url,
        "image": image,
        "jobTitle": profile.personalInfo.role,
        "description": profile.personalInfo.summary,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kota Bekasi",
          "addressRegion": "Jawa Barat",
          "addressCountry": "ID"
        },
        "affiliation": {
          "@type": "CollegeOrUniversity",
          "name": profile.education.institution
        },
        "knowsAbout": [
          ...profile.skills.programming.map(s => s.name),
          ...profile.skills.webTech.map(s => s.name),
          ...profile.skills.securityCloud.map(s => s.name),
          ...profile.skills.tools.map(s => s.name),
          ...profile.skills.soft.map(s => s.name)
        ],
        "sameAs": [
          "https://linkedin.com/in/wisnu-alfian-nur-ashar-ba60a1310",
          "https://github.com/wi5nuu"
        ]
      }
    </script>

    <!-- ================= SCHEMA WEBSITE ================= -->
    <script type="application/ld+json" is:inline define:vars={{ siteName, url }}>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": siteName,
        "url": url,
        "publisher": {
          "@type": "Person",
          "name": "Wisnu Alfian Nur Ashar"
        }
      }
    </script>

    <meta name="generator" content={Astro.generator} />

    <!-- ================= DARK MODE INITIALIZATION ================= -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
    
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      
      window.localStorage.setItem("theme", theme);
    </script>
  </head>

  <body class="bg-white dark:bg-[#0f172a] text-slate-900 dark:text-slate-100 antialiased transition-colors duration-300">
    <div
      id="app"
      class="min-h-screen flex flex-col overflow-x-hidden transition-colors duration-300"
    >
      <slot />
    </div>

    <!-- ================= AI CHATBOT ================= -->
    <AIChatBot />
  </body>
</html>
