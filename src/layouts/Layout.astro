---
import "../styles/global.css";
import AIChatBot from "../components/AIChatBot.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import SearchModal from "../components/SearchModal.astro";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  url?: string;
  ogType?: "website" | "article";
  noIndex?: boolean;
}

const isId = Astro.url.pathname.startsWith("/id");
const profile = isId ? profileId : profileEn;

const {
  title,
  description = profile.personalInfo.summary,
  url = Astro.url.href,
  ogType = "website",
  noIndex = false,
} = Astro.props;

const siteName = "Wisnu Alfian Nur Ashar | Full-Stack Developer, Intern & Cyber Security";
const siteUrl = "https://www.wisnualfiannurashar.my.id";
const ogImage = `${siteUrl}/og-image.webp`;
const lang = isId ? "id" : "en";

// Build alternate language URLs
const currentPath = Astro.url.pathname;
const enUrl = currentPath.startsWith("/id") ? currentPath.replace("/id", "") || "/" : currentPath;
const idUrl = currentPath.startsWith("/id") ? currentPath : `/id${currentPath === "/" ? "" : currentPath}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- ================= BASIC ================= -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title} | {profile.personalInfo.name}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.personalInfo.name} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="googlebot" content={noIndex ? "noindex" : "index, follow"} />
    <meta
      name="keywords"
      content="Wisnu Alfian Nur Ashar, Full-Stack Developer, Software Engineer Intern, President University, IT Software Engineer, Web Developer Bekasi, React Developer, Next.js Expert, Laravel Developer, TypeScript, Cybersecurity, Open Source Contributor, NASA Contributor, Microsoft Contributor, Google Contributor, Portfolio"
    />
    <meta name="theme-color" content="#2a3b3e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f5f9" media="(prefers-color-scheme: light)" />

    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    
    <link rel="stylesheet" href="/styles/tailwind.css" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />

    <!-- ================= RESOURCE HINTS (Performance) ================= -->
    <link rel="dns-prefetch" href="https://api.web3forms.com" />

    <!-- ================= VIEW TRANSITIONS ================= -->
    <ClientRouter />

    <!-- ================= CANONICAL & HREFLANG ================= -->
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enUrl}`} />
    <link rel="alternate" hreflang="id" href={`${siteUrl}${idUrl}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- ================= GOOGLE VERIFICATION ================= -->
    <meta
      name="google-site-verification"
      content="EJ_C4tjJumyHkl6RwAdqafUs-zgyK2KjvQ6zTy1_LDQ"
    />

    <!-- ================= OPEN GRAPH ================= -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} | ${profile.personalInfo.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.personalInfo.name} — ${profile.personalInfo.role}`} />
    <meta property="og:locale" content={isId ? "id_ID" : "en_US"} />
    <meta property="og:locale:alternate" content={isId ? "en_US" : "id_ID"} />

    <!-- ================= TWITTER ================= -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wisnualfian" />
    <meta name="twitter:creator" content="@wisnualfian" />
    <meta name="twitter:title" content={`${title} | ${profile.personalInfo.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${profile.personalInfo.name} — ${profile.personalInfo.role}`} />

    <!-- ================= FAVICON & PWA ================= -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp" />
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32x32.webp" />
    <link rel="icon" type="image/webp" sizes="16x16" href="/favicon-16x16.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/android-chrome-192x192.webp" color="#2a3b3e" />

    <!-- ================= SCHEMA.ORG: PERSON ================= -->
    <script type="application/ld+json" is:inline define:vars={{ profile, siteUrl, ogImage }}>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": profile.personalInfo.name,
        "givenName": "Wisnu",
        "familyName": "Alfian Nur Ashar",
        "alternateName": "Wisnu Alfian",
        "url": siteUrl,
        "image": ogImage,
        "jobTitle": profile.personalInfo.role,
        "description": profile.personalInfo.summary,
        "birthPlace": {
          "@type": "Place",
          "name": "Tarakan, Indonesia"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kota Bekasi",
          "addressRegion": "Jawa Barat",
          "addressCountry": "ID"
        },
        "affiliation": {
          "@type": "CollegeOrUniversity",
          "name": profile.education.institution,
          "url": "https://www.president.ac.id"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": profile.education.institution
        },
        "knowsAbout": [
          "Full-Stack Web Development",
          "Cybersecurity",
          "React", "Next.js", "TypeScript", "Python", "Golang",
          "Cloud Security", "Penetration Testing",
          "AI/ML", "Computer Vision",
          "Database Architecture", "API Development"
        ],
        "knowsLanguage": [
          { "@type": "Language", "name": "Indonesian", "alternateName": "id" },
          { "@type": "Language", "name": "English", "alternateName": "en" }
        ],
        "sameAs": [
          "https://linkedin.com/in/wisnu-alfian-nur-ashar-ba60a1310",
          "https://github.com/wi5nuu",
          "https://www.instagram.com/wshnn_",
          "https://line.me/ti/p/PlhxJgbURY"
        ]
      }
    </script>

    <!-- ================= SCHEMA.ORG: WEBSITE + SEARCH ACTION ================= -->
    <script type="application/ld+json" is:inline define:vars={{ siteName, siteUrl }}>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": siteName,
        "url": siteUrl,
        "inLanguage": ["en", "id"],
        "publisher": {
          "@type": "Person",
          "name": "Wisnu Alfian Nur Ashar"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": siteUrl + "/search?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
    }
    </script>

    <!-- ================= SCHEMA.ORG: ITEMLIST (NAVIGATION) ================= -->
    <script type="application/ld+json" is:inline define:vars={{ siteUrl }}>
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Portfolio Navigation",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "url": siteUrl + "/" },
          { "@type": "ListItem", "position": 2, "name": "About", "url": siteUrl + "/about" },
          { "@type": "ListItem", "position": 3, "name": "Projects", "url": siteUrl + "/projects" },
          { "@type": "ListItem", "position": 4, "name": "Open Source", "url": siteUrl + "/opensource" },
          { "@type": "ListItem", "position": 5, "name": "Skills", "url": siteUrl + "/skills" },
          { "@type": "ListItem", "position": 6, "name": "Experience", "url": siteUrl + "/experience" },
          { "@type": "ListItem", "position": 7, "name": "Contact", "url": siteUrl + "/contact" }
        ]
      }
    </script>

    <!-- ================= DARK MODE INITIALIZATION (FOUC prevention) ================= -->
    <script is:inline>
      (function() {
        var t;
        try { t = localStorage.getItem("theme"); } catch(e) {}
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var c = document.documentElement.classList;
        t === "dark" ? c.add("dark") : c.remove("dark");
        document.documentElement.style.colorScheme = t;
      })();
      document.addEventListener("astro:after-swap", function initTheme() {
        var t;
        try { t = localStorage.getItem("theme"); } catch(e) {}
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var c = document.documentElement.classList;
        t === "dark" ? c.add("dark") : c.remove("dark");
        document.documentElement.style.colorScheme = t;
      });
    </script>

    <!-- ================= VIDEO BACKGROUND LAZY LOADING ================= -->
    <script is:inline>
      (function () {
        function initVideos() {
          var videos = document.querySelectorAll("video.video-bg");
          if (!videos.length) return;
          if (!("IntersectionObserver" in window)) {
            videos.forEach(function (v) { v.src = v.dataset.src; v.load(); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var v = entry.target;
              io.unobserve(v);
              var delay = parseInt(v.dataset.loadDelay || "0", 10) || 0;
              if (delay <= 0) { startVideo(v); }
              else { setTimeout(function () { startVideo(v); }, delay); }
            });
          }, { rootMargin: "300px 0px" });
          videos.forEach(function (v) { io.observe(v); });
        }
        function startVideo(v) {
          if (v.dataset.started) return;
          v.dataset.started = "1";
          var src = v.dataset.src;
          if (src) {
            var source = v.querySelector("source");
            if (source) { source.src = src; }
            else { v.src = src; }
            v.load();
          }
          var p = v.play();
          if (p) p.catch(function () {});
        }
        document.addEventListener("astro:page-load", initVideos);
      })();
    </script>
  </head>

  <body class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased transition-colors duration-300">
    <div
      id="app"
      class="min-h-screen flex flex-col overflow-x-hidden transition-colors duration-300"
    >
      <slot />
    </div>

    <ScrollToTop />
    <AIChatBot />
    <SearchModal />
  </body>
</html>
