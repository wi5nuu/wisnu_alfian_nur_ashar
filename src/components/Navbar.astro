---
const pathname = new URL(Astro.request.url).pathname;
const isId = pathname.startsWith('/id');

const navLinks = [
  { name: isId ? "Beranda" : "Home", href: "/" },
  { name: isId ? "Tentang" : "About", href: "/about" },
  { name: isId ? "Proyek" : "Projects", href: "/projects" },
  { name: isId ? "Kontak" : "Contact", href: "/contact" },
];

const getLocalizedUrl = (path: string, toId: boolean) => {
  const base = toId ? '/id' : '';
  const cleanPath = path.startsWith('/id') ? path.substring(3) : path;
  return `${base}${cleanPath === '' || cleanPath === '/' ? '/' : cleanPath}`;
};
---

<nav aria-label={isId ? "Navigasi utama" : "Main navigation"} class="nav-root">
  <!-- LEFT: LOGO -->
  <a href={getLocalizedUrl("/", isId)} aria-label={isId ? "Beranda - Wisnu Alfian" : "Home - Wisnu Alfian"} class="nav-logo">
    WISNU ALFIAN
  </a>

  <!-- CENTER/RIGHT: NAV LINKS (Desktop only) -->
  <div class="nav-desktop">
    {navLinks.map((link) => {
      const localizedHref = getLocalizedUrl(link.href, isId);
      const isActive = pathname === localizedHref || (pathname === '/id/' && localizedHref === '/id/');
      return (
        <a
          href={localizedHref}
          class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
        >
          {link.name}
        </a>
      );
    })}
  </div>

  <!-- RIGHT: Contact (Desktop only) -->
  <div class="nav-right">
    <button id="lang-toggle-desktop" class="lang-btn" aria-label={isId ? 'Ganti Bahasa' : 'Switch Language'}>
      {isId ? 'ID' : 'EN'}
    </button>
    <a href={getLocalizedUrl("/contact", isId)} class="nav-cta">
      {isId ? 'Kontak' : 'Contact Me'}
    </a>
  </div>
</nav>

<!-- BOTTOM NAVIGATION BAR (Mobile Android Style) -->
<nav aria-label={isId ? "Navigasi mobile" : "Mobile navigation"} class="bottom-nav" transition:persist>
  {navLinks.map((link) => {
    const localizedHref = getLocalizedUrl(link.href, isId);
    const isActive = pathname === localizedHref || (pathname === '/id/' && localizedHref === '/id/');
    
    // Icon untuk setiap menu
    let iconPath = '';
    if (link.href === '/') {
      iconPath = 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6';
    } else if (link.href === '/about') {
      iconPath = 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z';
    } else if (link.href === '/projects') {
      iconPath = 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10';
    } else if (link.href === '/contact') {
      iconPath = 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z';
    }
    
        return (
          <a
            href={localizedHref}
            class={`bottom-nav-item ${isActive ? 'bottom-nav-item--active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
            transition:name={`nav-${link.href}`}
          >
            <svg class="bottom-nav-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" transition:animate="none">
              <path d={iconPath}></path>
            </svg>
            <span class="bottom-nav-label" transition:animate="none">{link.name}</span>
          </a>
        );
      })}

      <!-- AI TRIGGER (Mobile) -->
      <button id="mobile-ai-trigger" class="bottom-nav-item bottom-nav-item--ai" aria-label={isId ? 'Asisten AI' : 'AI Assistant'}>
        <svg class="bottom-nav-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" transition:animate="none">
          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
        </svg>
        <span class="bottom-nav-label" transition:animate="none">AI</span>
      </button>
</nav>

<!-- LANGUAGE TOGGLE (Mobile - top right corner) -->
<button id="lang-toggle-mobile" class="lang-btn-mobile" aria-label={isId ? 'Ganti Bahasa' : 'Switch Language'} transition:persist>
  {isId ? 'ID' : 'EN'}
</button>

<script>
  const setupLang = () => {
    const langBtnDesktop = document.getElementById('lang-toggle-desktop');
    const langBtnMobile = document.getElementById('lang-toggle-mobile');

    const toggleLang = () => {
      const isId = window.location.pathname.startsWith('/id');
      const currentPath = window.location.pathname;
      let newPath = '';

      if (isId) {
        newPath = currentPath.substring(3);
        if (newPath === '') newPath = '/';
      } else {
        newPath = '/id' + (currentPath === '/' ? '' : currentPath);
      }

      window.location.href = newPath;
    };

    // Remove old listeners before adding new ones (prevents double-toggle on SPA nav)
    langBtnDesktop?.removeEventListener('click', toggleLang);
    langBtnMobile?.removeEventListener('click', toggleLang);
    langBtnDesktop?.addEventListener('click', toggleLang);
    langBtnMobile?.addEventListener('click', toggleLang);
  };

  // Sync active state for persisted bottom-nav across page transitions
  const syncActiveNav = () => {
    const currentPath = window.location.pathname;
    const isId = currentPath.startsWith('/id');
    const cleanPath = isId ? currentPath.substring(3) : currentPath;

    document.querySelectorAll('.bottom-nav-item').forEach((item) => {
      if (item.classList.contains('bottom-nav-item--ai')) return;
      const href = item.getAttribute('href') || '';
      const cleanHref = href.startsWith('/id') ? href.substring(3) : href;
      const isActive =
        cleanPath === cleanHref ||
        (cleanHref === '/' && (cleanPath === '/' || cleanPath === ''));

      item.classList.toggle('bottom-nav-item--active', isActive);
      if (isActive) {
        item.setAttribute('aria-current', 'page');
      } else {
        item.removeAttribute('aria-current');
      }
    });
  };

  document.addEventListener('astro:page-load', setupLang);
  document.addEventListener('astro:page-load', syncActiveNav);
</script>

<style>
  /* ===== NAV ROOT ===== */
  .nav-root {
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 40px;
    background: transparent;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  .nav-logo {
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: -0.02em;
    z-index: 50;
  }

  /* ===== DESKTOP LINKS ===== */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .nav-link {
    color: #fff;
    font-size: 15px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--accent);
  }

  .nav-link--active {
    font-weight: 500;
  }

  /* ===== RIGHT SIDE ===== */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-cta {
    border: 1px solid #fff;
    border-radius: 999px;
    padding: 10px 24px;
    color: #fff;
    font-size: 15px;
    text-decoration: none;
    background: transparent;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: #fff;
    color: #0A0A0A;
  }

  /* ===== LANGUAGE TOGGLE (Desktop) ===== */
  .lang-btn {
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 8px 16px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .lang-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ===== LANGUAGE TOGGLE (Mobile - top right corner) ===== */
  .lang-btn-mobile {
    display: none;
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 60;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 8px 16px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    background: rgba(10, 10, 10, 0.7);
    backdrop-filter: blur(8px);
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, border-color 0.2s;
  }

  .lang-btn-mobile:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ===== HAMBURGER (Hidden - not used in Android style) ===== */
  .hamburger-btn {
    display: none;
  }

  /* ===== BOTTOM NAVIGATION BAR (Android/Material Style) ===== */
  .bottom-nav {
    display: none; /* Hidden on desktop */
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 100;
    padding: 0 8px 0;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.3);
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: 4px;
    text-decoration: none;
    color: #ffffff;
    padding: 8px 4px;
    position: relative;
  }

  .bottom-nav-icon {
    width: 24px;
    height: 24px;
  }

  .bottom-nav-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Active state - hanya ubah warna jadi hijau */
  .bottom-nav-item--active {
    color: var(--accent);
  }

  .bottom-nav-item--active .bottom-nav-label {
    font-weight: 600;
  }

  /* AI trigger khusus di mobile - putih default, hijau saat chat aktif */
  .bottom-nav-item--ai {
    color: #ffffff;
    border: none;
    background: none;
    font-family: inherit;
  }

  .bottom-nav-item--ai.bottom-nav-item--active {
    color: var(--accent);
  }

  .bottom-nav-item--ai .bottom-nav-label {
    font-weight: 600;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 767px) {
    .nav-root {
      padding: 20px 24px;
    }

    .nav-desktop {
      display: none;
    }

    .nav-right {
      display: none;
    }

    /* Show bottom navigation on mobile */
    .bottom-nav {
      display: flex;
    }

    /* Show language toggle in top-right corner on mobile */
    .lang-btn-mobile {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  /* Small phones */
  @media (max-width: 380px) {
    .bottom-nav {
      height: 60px;
      padding: 0 4px;
    }

    .bottom-nav-label {
      font-size: 10px;
    }

    .bottom-nav-icon {
      width: 22px;
      height: 22px;
    }
  }
</style>
