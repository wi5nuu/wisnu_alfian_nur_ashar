---
import { profile } from "../../data/profile";
---

<section id="about" class="section bg-white relative overflow-hidden">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10 reveal">
        <h2 class="inline-block relative">
          About Me
          <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 rounded-full"></span>
        </h2>
      </div>

      <div class="grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-4 relative reveal-left h-auto">
          <div class="bg-white rounded-2xl overflow-hidden relative shadow-lg group">
            <img
              src="/wisnu_alfian_nur_ashar.jpeg"
              alt={profile.personalInfo.name}
              class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-transform duration-700 ease-out"
            />
          </div>
          
          <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-sage-50 rounded-lg -z-10 hidden md:block"></div>
          <div class="absolute -top-4 -left-4 w-20 h-20 border border-sage-100 rounded-lg -z-10 hidden md:block"></div>
        </div>

        <div class="md:col-span-8 space-y-4 overflow-hidden">
          <h3 class="text-xl md:text-2xl font-bold text-sage-900 reveal-left">
            {profile.personalInfo.role}
          </h3>

          <div class="space-y-4 text-charcoal/90 text-[15px] leading-snug">
            <p class="reveal-right font-medium">
              {profile.personalInfo.summary}
            </p>

            <p class="reveal-bottom">
              Beyond academics, I have worked on several real-world projects,
              including business websites, CMS-based platforms, and e-commerce
              applications used by real users.
            </p>

            <p class="reveal-top text-sage-600 font-semibold underline decoration-sage-200 underline-offset-4">
              I am particularly interested in web development, secure
              application design, and modern development workflows.
            </p>
          </div>

          <div class="mt-6 reveal-bottom">
            <div class="grid grid-cols-3 gap-3">
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center hover:shadow-sm transition-shadow">
                <div class="text-2xl font-bold stat-number text-sage-700">8+</div>
                <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mt-1">Production Apps</div>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center hover:shadow-sm transition-shadow">
                <div class="text-2xl font-bold stat-number text-sage-700">15K+</div>
                <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mt-1">Users Served</div>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center hover:shadow-sm transition-shadow">
                <div class="text-2xl font-bold stat-number text-sage-700">96</div>
                <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mt-1">Lighthouse Score</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal,
  .reveal-left,
  .reveal-right,
  .reveal-bottom,
  .reveal-top {
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform, opacity;
  }

  .reveal-left { transform: translateX(-30px); }
  .reveal-right { transform: translateX(30px); }
  .reveal-bottom { transform: translateY(30px); }
  .reveal-top { transform: translateY(-30px); }

  .active {
    opacity: 1 !important;
    transform: translate(0, 0) !important;
  }

  .stat-number {
    font-family: 'Calibri', 'Trebuchet MS', 'Gill Sans', Arial, sans-serif;
  }
</style>

<script>
  const revealAbout = () => {
    const observerOptions = { threshold: 0.15 };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll(
      ".reveal, .reveal-left, .reveal-right, .reveal-bottom, .reveal-top",
    );

    elements.forEach((el, index) => {
      (el as HTMLElement).style.transitionDelay = `${index * 0.08}s`;
      observer.observe(el);
    });
  };

  document.addEventListener("DOMContentLoaded", revealAbout);
  document.addEventListener("astro:after-swap", revealAbout);
</script>
