---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import Picture from "../Picture.astro";
import { MapPin, Github, Linkedin, ExternalLink } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section class="about-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'TENTANG SAYA' : 'ABOUT ME'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Siapa Saya?' : 'Who Am I?'}
    </h2>

    <div class="about-grid">
      <!-- Photo -->
      <div class="photo-col">
        <div class="photo-wrap">
          <Picture
            src="/Wisnu Alfian Nur Ashar.png"
            alt={profile.personalInfo.name}
            width="400"
            height="500"
            class="photo"
          />
          <div class="photo-badge">
            <span class="available-dot"></span>
            <span>{isId ? 'Tersedia untuk hire' : 'Available for hire'}</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="content-col">
        <h3 class="name">{profile.personalInfo.name}</h3>
        <p class="role">{profile.personalInfo.role}</p>

        <div class="meta-row">
          <span class="meta-item">
            <MapPin class="meta-icon" />
            {profile.personalInfo.location}
          </span>
        </div>

        <p class="bio">{profile.personalInfo.summary}</p>

        <div class="stats-row">
          <div class="stat">
            <span class="stat-num">15K+</span>
            <span class="stat-label">{isId ? 'Pengguna Dilayani' : 'Users Served'}</span>
          </div>
          <div class="stat">
            <span class="stat-num">92+</span>
            <span class="stat-label">{isId ? 'Repositori GitHub' : 'GitHub Repos'}</span>
          </div>
          <div class="stat">
            <span class="stat-num">10+</span>
            <span class="stat-label">{isId ? 'Sertifikasi' : 'Certifications'}</span>
          </div>
        </div>

        <div class="cta-row">
          <a href={profile.personalInfo.github} target="_blank" rel="noopener noreferrer" class="cta-primary">
            <Github class="cta-icon" />
            GitHub
          </a>
          <a href={profile.personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="cta-secondary">
            <Linkedin class="cta-icon" />
            LinkedIn
          </a>
          <a href="/CV_Wisnu_Alfian_Nur_Ashar.pdf" target="_blank" rel="noopener noreferrer" class="cta-secondary">
            <ExternalLink class="cta-icon" />
            {isId ? 'Unduh CV' : 'Download CV'}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
    text-align: center;
    width: 100%;
  }

  .about-grid {
    margin-top: 64px;
    width: 100%;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Photo */
  .photo-col {
    position: sticky;
    top: 100px;
  }

  .photo-wrap {
    position: relative;
  }

  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .photo-badge {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(10, 10, 10, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 500;
    color: #ffffff;
    white-space: nowrap;
  }

  .available-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Content */
  .content-col {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
  }

  .name {
    font-size: 36px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .role {
    margin-top: 8px;
    font-size: 15px;
    color: var(--accent);
    font-weight: 500;
  }

  .meta-row {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }

  .meta-icon {
    width: 14px;
    height: 14px;
    color: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }

  .bio {
    margin-top: 28px;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.65);
    border-left: 2px solid var(--accent);
    padding-left: 20px;
  }

  /* Stats */
  .stats-row {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }

  .stat {
    background-color: #111111;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }

  .stat-num {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
  }

  /* CTA */
  .cta-row {
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #ffffff;
    color: #0a0a0a;
    border-radius: 999px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .cta-primary:hover {
    background-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .cta-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 300px 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .about-section {
      padding-block: 80px;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .photo-col {
      position: static;
      max-width: 320px;
      margin-inline: auto;
      width: 100%;
    }
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
    .name {
      font-size: 28px;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-primary,
    .cta-secondary {
      justify-content: center;
    }
  }
</style>
