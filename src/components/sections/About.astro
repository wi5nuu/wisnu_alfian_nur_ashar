---
import { profile } from "../../data/profile";
---

<section id="about" class="section bg-white relative overflow-hidden">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2
          class="text-3xl md:text-4xl font-serif font-bold text-sage-900 mb-4 inline-block relative"
        >
          About Me
          <span
            class="absolute -bottom-2 left-0 w-full h-1 bg-sage-200 rounded-full"
          ></span>
        </h2>
      </div>

      <div class="grid md:grid-cols-12 gap-12 items-center">
        <!-- Visual/Image Column (Placeholder or abstract pattern) -->
        <div class="md:col-span-5 relative">
          <div
            class="aspect-[4/5] bg-sage-100 rounded-2xl overflow-hidden relative shadow-lg group"
          >
            <img
              src="/wisnu_alfian_nur_ashar.jpeg"
              alt={profile.personalInfo.name}
              class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div
            class="absolute -bottom-6 -right-6 w-32 h-32 bg-cream-200 rounded-lg -z-10"
          >
          </div>
          <div
            class="absolute -top-6 -left-6 w-32 h-32 border-2 border-sage-100 rounded-lg -z-10"
          >
          </div>
        </div>

        <!-- Content Column -->
        <div class="md:col-span-7 space-y-6">
          <h3 class="text-2xl font-bold text-sage-800">
            {profile.personalInfo.role}
          </h3>

          <div class="space-y-4 text-charcoal/90 text-lg leading-relaxed">
            <p>
              {profile.personalInfo.summary}
            </p>
            <p>
              Beyond academics, I have worked on several real-world projects,
              including business websites, CMS-based platforms, and e-commerce
              applications used by real users. These projects helped me
              understand real requirements, system maintenance, and iterative
              improvement.
            </p>
            <p>
              I am particularly interested in web development, secure
              application design, and modern development workflows, including
              AI-assisted tools.
            </p>
          </div>

          <div class="pt-6 grid grid-cols-2 gap-4">
            <div class="bg-cream-100 p-4 rounded-lg">
              <span
                class="block text-3xl font-serif font-bold text-sage-600 mb-1"
                >3+</span
              >
              <span class="text-sm text-charcoal/70">Years Experience</span>
            </div>
            <div class="bg-cream-100 p-4 rounded-lg">
              <span
                class="block text-3xl font-serif font-bold text-sage-600 mb-1"
                >2+</span
              >
              <span class="text-sm text-charcoal/70">Live Projects</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
