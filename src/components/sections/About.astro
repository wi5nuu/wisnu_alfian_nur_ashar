---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="about" class="section relative overflow-hidden z-20">
  <div class="container-custom pt-8 md:pt-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10 reveal-up">
        <h2 class="inline-block relative text-sage-900 dark:text-white">
          {isId ? 'Tentang Saya' : 'About Me'}
          <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200/60 dark:bg-sage-500/50 rounded-full"></span>
        </h2>
      </div>

      <!-- Mobile only: Static photo below heading -->
      <div class="md:hidden flex justify-center mb-8 reveal-zoom delay-100">
        <div class="w-[200px] h-[250px] rounded-3xl overflow-hidden shadow-xl ring-1 ring-slate-200/60 dark:ring-transparent">
          <img
            src="/wisnu_alfian_nur_ashar.jpeg"
            alt={profile.personalInfo.name}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <div class="flex flex-col md:grid md:grid-cols-12 gap-8 items-start">
        <!-- Desktop: Photo (sticky) -->
        <div class="md:col-span-4 relative hidden md:block reveal-zoom delay-100">
          <div class="sticky top-24">
            <div class="relative group">
              <!-- Decorative behind -->
              <div class="absolute -bottom-3 -right-3 w-full h-full bg-sage-200/60 dark:bg-sage-800/40 rounded-2xl"></div>
              <div class="absolute -top-3 -left-3 w-16 h-16 border-2 border-sage-200/60 dark:border-transparent rounded-xl"></div>
              <!-- Photo card -->
              <div class="relative bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200/60 dark:ring-transparent aspect-[3/4]">
                <img
                  src="/wisnu_alfian_nur_ashar.jpeg"
                  alt={profile.personalInfo.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <!-- Subtle overlay gradient at bottom -->
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="md:col-span-8 space-y-5 reveal-left delay-200">
          <h3 class="text-lg md:text-2xl font-bold text-sage-900 dark:text-sage-300 text-center md:text-left">
            {profile.personalInfo.role}
          </h3>

          <div class="space-y-3 text-[15px] md:text-base leading-relaxed">
            <p class="text-charcoal/90 dark:text-slate-200 font-medium text-center md:text-left">
              {profile.personalInfo.summary}
            </p>

            <p class="text-charcoal/80 dark:text-slate-300 text-center md:text-left">
              {isId
                ? 'Di luar bidang akademik, saya telah mengerjakan beberapa proyek dunia nyata, termasuk situs web bisnis, platform berbasis CMS, dan aplikasi e-commerce yang digunakan oleh pengguna sebenarnya.'
                : 'Beyond academics, I have worked on several real-world projects, including business websites, CMS-based platforms, and e-commerce applications used by real users.'}
            </p>

            <p class="text-sage-700 dark:text-sage-400 font-semibold underline decoration-sage-300/60 dark:decoration-sage-600 underline-offset-4 text-center md:text-left">
              {isId
                ? 'Saya memiliki ketertarikan khusus pada pengembangan web masa depan, desain aplikasi yang mutlak aman, serta alur kerja dan sistem modern.'
                : 'I am particularly interested in web development, secure application design, and modern development workflows.'}
            </p>
          </div>

          <!-- Stats Row -->
          <div class="grid grid-cols-3 gap-3 md:gap-4 pt-4 reveal-up delay-300">
            <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-transparent rounded-2xl p-3 md:p-4 text-center shadow-sm">
              <div class="text-xl md:text-2xl font-bold text-sage-700 dark:text-sage-400 stat-number">8+</div>
              <div class="text-[9px] md:text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mt-1">
                {isId ? 'Aplikasi Produksi' : 'Production Apps'}
              </div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-transparent rounded-2xl p-3 md:p-4 text-center shadow-sm">
              <div class="text-xl md:text-2xl font-bold text-sage-700 dark:text-sage-400 stat-number">15K+</div>
              <div class="text-[9px] md:text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mt-1">
                {isId ? 'Pengguna Dilayani' : 'Users Served'}
              </div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-transparent rounded-2xl p-3 md:p-4 text-center shadow-sm">
              <div class="text-xl md:text-2xl font-bold text-sage-700 dark:text-sage-400 stat-number">30+</div>
              <div class="text-[9px] md:text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mt-1">
                {isId ? 'Repositori GitHub' : 'GitHub Repos'}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stat-number {
    font-family: 'Calibri', 'Trebuchet MS', 'Gill Sans', Arial, sans-serif;
  }
</style>
