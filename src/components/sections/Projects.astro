---
import { profile as profileEn } from '../../data/profile';
import { profile as profileId } from '../../data/profile_id';
import { getProjectSlug } from '../../utils/slug';
import { ExternalLink, Github, ArrowUpRight, Search } from 'lucide-astro';

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const basePath = isId ? '/id/projects' : '/projects';
const totalProjectsCount = profile.projects.length;
---

<section class="projects-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? `Semua Proyek (${totalProjectsCount})` : `All Projects (${totalProjectsCount})`}</span>
    </div>

    <h1 class="heading">
      {isId ? 'Proyek & Portofolio' : 'Featured Projects'}
    </h1>

    <p class="subheading">
      {isId
        ? 'Aplikasi dunia nyata yang memberikan nilai nyata kepada pengguna dalam lingkungan produksi.'
        : 'Real-world applications delivering value to users in production environments.'}
    </p>

    <div class="filter-bar">
      <div class="search-wrap">
        <Search class="search-icon" />
        <input
          type="text"
          id="project-search"
          class="search-input"
          placeholder={isId ? "Cari proyek, deskripsi, teknologi..." : "Search projects, tech..."}
          aria-label={isId ? "Cari proyek" : "Search projects"}
        />
      </div>

      <div class="filter-controls">
        <div class="filter-chips" role="group" aria-label={isId ? 'Filter proyek' : 'Filter projects'}>
          <button class="filter-chip is-active" data-filter="all">{isId ? 'Semua' : 'All'}</button>
          <button class="filter-chip" data-filter="web">{isId ? 'Web' : 'Web'}</button>
          <button class="filter-chip" data-filter="mobile">{isId ? 'Mobile' : 'Mobile'}</button>
          <button class="filter-chip" data-filter="ai">{isId ? 'AI/ML' : 'AI/ML'}</button>
          <button class="filter-chip" data-filter="security">{isId ? 'Keamanan' : 'Security'}</button>
        </div>
        <div class="sort-wrap">
          <label class="sort-label" for="sort-select">{isId ? 'Urutkan' : 'Sort'}</label>
          <select id="sort-select" class="sort-select">
            <option value="default">{isId ? 'Default' : 'Default'}</option>
            <option value="az">A-Z</option>
            <option value="za">Z-A</option>
          </select>
        </div>
      </div>
    </div>

    <div class="results-count-bar">
      <span class="count-text" id="project-count-text">
        {isId ? `Menampilkan ${totalProjectsCount} dari ${totalProjectsCount} proyek` : `Showing ${totalProjectsCount} of ${totalProjectsCount} projects`}
      </span>
    </div>

    <div class="projects-grid">
      {profile.projects.map((project, index) => {
        const slug = getProjectSlug(project.title);
        const techJoined = project.techStack.join(' ').toLowerCase();
        const cats: string[] = [];
        if (/react|next|laravel|asp\.net|vue|astro|web|tailwind|bootstrap/i.test(techJoined)) cats.push('web');
        if (/flutter|android|ios|react native|mobile/i.test(techJoined)) cats.push('mobile');
        if (/ai|ml|pytorch|tensorflow|gemini|llm|langchain|numpy|pandas/i.test(techJoined)) cats.push('ai');
        if (/security|blockchain|owasp|encrypt|cyber|threat|firewall|hashing/i.test(techJoined)) cats.push('security');
        if (cats.length === 0) cats.push('web');
        const searchText = `${project.title} ${project.role} ${project.description} ${project.techStack.join(' ')}`.toLowerCase();
        return (
          <a
            href={`${basePath}/${slug}`}
            class="project-card"
            data-title={project.title.toLowerCase()}
            data-cats={cats.join(' ')}
            data-search={searchText}
            style={`animation-delay: ${index * 60}ms`}
          >
            {project.image && (
              <div class="card-img-wrap">
                <div class="browser-bar">
                  <span class="dot red"></span>
                  <span class="dot yellow"></span>
                  <span class="dot green"></span>
                </div>
                <img
                  src={project.image}
                  alt={project.title}
                  class="card-img"
                  loading="lazy"
                />
                <div class="card-overlay">
                  <ArrowUpRight class="overlay-icon" />
                </div>
              </div>
            )}
            <div class="card-body">
              <div class="card-top">
                <span class="status-badge">{project.status || (isId ? 'Produksi' : 'Production')}</span>
                <ArrowUpRight class="arrow-icon" />
              </div>
              <h3 class="card-title">{project.title}</h3>
              <p class="card-role">{project.role}</p>
              <p class="card-desc">{project.description}</p>
              <div class="tag-row">
                {project.techStack.slice(0, 4).map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
                {project.techStack.length > 4 && (
                  <span class="tag">+{project.techStack.length - 4}</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <p class="no-results hidden" id="no-results">
      {isId ? 'Tidak ada proyek yang cocok.' : 'No projects match your search or filter.'}
    </p>

    <div class="bottom-cta">
      <a
        href={profile.personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-btn"
      >
        <Github class="cta-icon" />
        <span>{isId ? 'Lihat Semua di GitHub' : 'View all on GitHub'}</span>
        <ExternalLink class="cta-ext" />
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const grid = document.querySelector('.projects-grid');
    if (!grid) return;

    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const countText = document.getElementById('project-count-text');
    const noResults = document.getElementById('no-results');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'));
    const totalCount = cards.length;
    const isIdPage = window.location.pathname.startsWith('/id');

    const applyFilters = () => {
      const activeChip = chips.find((c) => c.classList.contains('is-active'));
      const filter = activeChip?.dataset.filter || 'all';
      const searchQuery = (searchInput?.value || '').trim().toLowerCase();

      let visible = cards.filter((card) => {
        const matchesCategory = filter === 'all' || (card.dataset.cats || '').split(' ').includes(filter);
        const matchesSearch = !searchQuery || (card.dataset.search || '').includes(searchQuery);
        return matchesCategory && matchesSearch;
      });

      const sortMode = sortSelect?.value || 'default';
      if (sortMode === 'az') {
        visible.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
      } else if (sortMode === 'za') {
        visible.sort((a, b) => (b.dataset.title || '').localeCompare(a.dataset.title || ''));
      }

      cards.forEach((card) => card.classList.add('is-hidden'));
      visible.forEach((card) => {
        card.classList.remove('is-hidden');
        card.style.animation = 'none';
        void card.offsetWidth;
        card.style.animation = '';
      });

      if (countText) {
        if (isIdPage) {
          countText.textContent = `Menampilkan ${visible.length} dari ${totalCount} proyek`;
        } else {
          countText.textContent = `Showing ${visible.length} of ${totalCount} projects`;
        }
      }

      if (noResults) {
        noResults.classList.toggle('hidden', visible.length > 0);
      }
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);
  });
</script>

<style>
  .projects-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: var(--font-sans);
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: clamp(20px, 2vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: none;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
    text-align: center;
    width: 100%;
    white-space: nowrap;
  }

  .subheading {
    margin-top: 16px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.55);
    max-width: 540px;
    text-align: center;
    line-height: 1.6;
  }

  /* ===== FILTER BAR & SEARCH ===== */
  .filter-bar {
    margin-top: 40px;
    width: 100%;
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .search-wrap {
    position: relative;
    width: 100%;
    max-width: 480px;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 12px 20px 12px 46px;
    outline: none;
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .search-input:focus {
    border-color: var(--accent);
    background-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(132, 225, 12, 0.15);
  }

  .filter-controls {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-chip {
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 7px 16px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-chip:hover {
    color: #ffffff;
    border-color: rgba(132, 225, 12, 0.5);
  }

  .filter-chip.is-active {
    color: #0a0a0a;
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sort-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.4);
  }

  .sort-select {
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 8px 12px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .sort-select:focus {
    border-color: var(--accent);
  }

  .sort-select option {
    background-color: #111111;
    color: #ffffff;
  }

  .results-count-bar {
    margin-top: 14px;
    margin-bottom: 32px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  .projects-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }

  .project-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    height: 100%;
  }

  .project-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  /* Browser chrome bar */
  .card-img-wrap {
    position: relative;
    width: 100%;
    background-color: #0a0a0a;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    background-color: #1a1a1a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot.red    { background-color: #ff5f57; }
  .dot.yellow { background-color: #febc2e; }
  .dot.green  { background-color: #28c840; }

  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    top: 28px; /* below browser bar */
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-icon {
    width: 32px;
    height: 32px;
    color: #ffffff;
  }

  /* Card body */
  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .status-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background-color: rgba(132, 225, 12, 0.1);
    border: 1px solid rgba(132, 225, 12, 0.25);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.3);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover .arrow-icon {
    color: #ffffff;
    transform: translate(2px, -2px);
  }

  .card-title {
    margin-top: 14px;
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  .card-role {
    margin-top: 4px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-desc {
    margin-top: 10px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-row {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tag {
    font-size: 10.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .project-card.is-hidden {
    display: none;
  }

  .no-results {
    margin-top: 40px;
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }

  .no-results.hidden {
    display: none;
  }

  /* Bottom CTA */
  .bottom-cta {
    margin-top: 56px;
    display: flex;
    justify-content: center;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #ffffff;
    color: #0a0a0a;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .cta-btn:hover {
    background-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-icon {
    width: 18px;
    height: 18px;
  }

  .cta-ext {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }

  /* RESPONSIVE BREAKPOINTS */
  @media (max-width: 1440px) {
    .projects-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (max-width: 1100px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 768px) {
    .heading {
      white-space: normal;
    }
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    .filter-bar {
      gap: 12px;
      margin-top: 24px;
    }

    .filter-controls {
      flex-direction: column;
      align-items: center;
      gap: 10px;
      width: 100%;
    }

    .filter-chips {
      justify-content: center;
      gap: 6px;
      width: 100%;
    }

    .filter-chip {
      padding: 5px 12px;
      font-size: 11.5px;
      letter-spacing: -0.01em;
    }

    .sort-wrap {
      gap: 6px;
    }

    .sort-select {
      padding: 6px 10px;
      font-size: 12px;
    }

    .results-count-bar {
      margin-top: 10px;
      margin-bottom: 24px;
      font-size: 12px;
    }
  }

  @media (max-width: 520px) {
    .projects-section {
      padding-block: 80px;
    }
    .heading {
      font-size: 28px;
    }
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
