---
import { profile } from '../../data/profile';
import { ExternalLink } from 'lucide-astro';
---

<section id="projects" class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-sage-900 mb-4 inline-block relative">
        Featured Projects
        <span class="absolute -bottom-2 left-0 w-full h-1 bg-sage-200 rounded-full"></span>
      </h2>
      <p class="text-charcoal/70 max-w-2xl mx-auto mt-4">
        Real-world applications delivering value to users in production environments.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {profile.projects.map((project) => (
        <article class="group relative bg-white rounded-2xl border border-cream-200 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col h-full">
          <!-- Status Badge -->
          <div class="absolute top-4 right-4 z-10">
            <span class="px-3 py-1 bg-sage-500 text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">
              {project.status}
            </span>
          </div>

          <!-- Project Content -->
          <div class="h-full flex flex-col">
            {project.image && (
              <div class="relative w-full h-48 overflow-hidden group-hover:opacity-90 transition-opacity">
                <img 
                  src={project.image} 
                  alt={project.title} 
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
            )}
            
            <div class="p-8 flex-1 flex flex-col">
              <div class="mb-4">
               <h3 class="text-2xl font-serif font-bold text-sage-900 group-hover:text-sage-600 transition-colors">
                 {project.title}
               </h3>
               <p class="text-sm text-sage-500 font-medium mb-1">{project.role}</p>
            </div>

            <p class="text-charcoal/80 mb-6 leading-relaxed flex-1">
              {project.description}
            </p>

            <div class="space-y-6">
              <!-- Tech Stack -->
              <div class="flex flex-wrap gap-2">
                {project.techStack.map(tech => (
                  <span class="px-3 py-1 bg-cream-50 text-sage-700 text-xs font-medium border border-cream-200 rounded-md">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Links -->
              <div class="flex items-center gap-4 pt-4 border-t border-cream-100">
                <a 
                  href={project.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn btn-primary text-sm py-2 px-4 flex items-center gap-2"
                >
                  <ExternalLink class="w-4 h-4" />
                  Visit Live Site
                </a>
              </div>
            </div>
          </div>
          </div>
          
          <!-- Decorative bottom gradient -->
          <div class="h-1 bg-gradient-to-r from-sage-300 via-sage-500 to-sage-400"></div>
        </article>
      ))}
    </div>
  </div>
</section>
