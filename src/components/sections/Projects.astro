---
import { profile as profileEn } from '../../data/profile';
import { profile as profileId } from '../../data/profile_id';
import { getProjectSlug } from '../../utils/slug';
import { ExternalLink, Github } from 'lucide-astro';

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const basePath = isId ? '/id/projects' : '/projects';
---

<section id="projects" class="section">
  <div class="container-custom">
    <div class="text-center mb-10 reveal-up">
      <h2 class="inline-block relative text-sage-900 dark:text-white">
        {isId ? 'Proyek Unggulan' : 'Featured Projects'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
      <p class="text-charcoal/70 dark:text-slate-400 max-w-2xl mx-auto mt-2 text-sm">
        {isId ? 'Aplikasi dunia nyata yang memberikan nilai nyata kepada pengguna dalam lingkungan produksi.' : 'Real-world applications delivering value to users in production environments.'}
      </p>
    </div>

    <div class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6 md:pb-0 hide-scrollbar scroll-smooth">
      {profile.projects.map((project, index) => {
        const slug = getProjectSlug(project.title);
        return (
        <a 
          href={`${basePath}/${slug}`}
          class="group relative bg-white dark:bg-slate-800/80 backdrop-blur-sm rounded-2xl border border-slate-100 dark:border-transparent overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col shadow-sm md:hover:-translate-y-1 w-[85vw] shrink-0 snap-center md:w-auto md:shrink md:snap-none h-auto md:h-full cursor-pointer reveal-up" 
          style={`transition-delay: ${index * 150}ms`}
        >
          <div class="absolute top-8 right-3 z-20">
            <span class="px-2.5 py-0.5 bg-slate-950 text-white text-[9px] font-bold uppercase tracking-widest rounded-full shadow-lg border border-white/10">
              {project.status || 'Verified'}
            </span>
          </div>

          <div class="h-full flex flex-col">
            {project.image && (
              <div class="relative w-full">
                <div class="w-full h-5 bg-slate-100 dark:bg-slate-700 border-b border-slate-200 dark:border-transparent flex items-center gap-1 px-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-red-400"></div>
                  <div class="w-1.5 h-1.5 rounded-full bg-yellow-400"></div>
                  <div class="w-1.5 h-1.5 rounded-full bg-green-400"></div>
                </div>
                <div class="relative h-40 md:h-40 flex-shrink-0 overflow-hidden group-hover:opacity-95 transition-opacity bg-slate-50 dark:bg-slate-700">
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
              </div>
            )}

            <div class="bg-white dark:bg-slate-800/60 border-x border-b border-slate-100 dark:border-transparent rounded-b-xl p-4 md:p-5 flex-1 flex flex-col items-start min-h-[max-content] pb-6">
              <div class="flex flex-wrap items-center gap-2 mb-2 w-full">
                <span class={`text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full ${project.status === "Production" ? "bg-emerald-50 text-emerald-600 border border-emerald-100 dark:bg-emerald-900/40 dark:text-emerald-400 dark:border-transparent" : "bg-sage-50 text-sage-600 border border-sage-100 dark:bg-sage-900/40 dark:text-sage-300 dark:border-transparent"}`}>
                  {project.status === "Production" && isId ? "Produksi" : project.status}
                </span>
                {project.featured && (
                  <span class="text-[10px] uppercase tracking-widest font-bold bg-amber-50 text-amber-600 border border-amber-100 dark:bg-amber-900/40 dark:text-emerald-400 dark:border-transparent px-2 py-0.5 rounded-full">
                    {isId ? 'Andalan' : 'Featured'}
                  </span>
                )}
              </div>

              <h3 class="text-lg md:text-xl font-bold text-slate-800 dark:text-white mb-1 leading-tight group-hover:text-sage-600 dark:group-hover:text-sage-400 transition-colors">
                {project.title}
              </h3>

              <div class="text-xs font-semibold text-sage-600 dark:text-sage-300 mb-2">{project.role}</div>

              <p class="text-charcoal/70 dark:text-slate-300 text-[13px] leading-relaxed mb-4 flex-1 line-clamp-3">
                {project.description}
              </p>

              <div class="space-y-4 mt-auto w-full">
                <div class="flex flex-wrap gap-1.5 w-full">
                  {project.techStack.map((tech) => (
                    <span class="px-2 py-1 bg-slate-50 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300 text-[10px] font-medium border border-slate-100 dark:border-transparent rounded">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="h-1 bg-gradient-to-r from-slate-200 via-slate-900 to-slate-200 opacity-20 dark:opacity-0"></div>
          </div>
        </a>
      )})}
    </div>

    <div class="mt-8 md:mt-12 text-center relative z-20">
      <a href={profile.personalInfo.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 dark:bg-slate-700 text-white rounded-full text-sm font-medium hover:bg-slate-800 dark:hover:bg-slate-600 transition-all shadow-md group border border-transparent dark:border-slate-600">
        <Github class="w-4 h-4" />
        <span>{isId ? 'Lihat Semua Proyek di GitHub' : 'View all projects on GitHub'}</span>
        <ExternalLink class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
      </a>
    </div>
  </div>
</section>
