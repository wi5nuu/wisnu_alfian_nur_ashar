---
import { profile as profileEn } from '../../data/profile';
import { profile as profileId } from '../../data/profile_id';
import { getProjectSlug } from '../../utils/slug';
import { ExternalLink, Github, ArrowUpRight } from 'lucide-astro';

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const basePath = isId ? '/id/projects' : '/projects';
---

<section class="projects-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'SEMUA PROYEK' : 'ALL PROJECTS'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Proyek &' : 'Featured'}<br />
      {isId ? 'Portofolio' : 'Projects'}
    </h2>

    <p class="subheading">
      {isId
        ? 'Aplikasi dunia nyata yang memberikan nilai nyata kepada pengguna dalam lingkungan produksi.'
        : 'Real-world applications delivering value to users in production environments.'}
    </p>

    <div class="projects-grid">
      {profile.projects.map((project, index) => {
        const slug = getProjectSlug(project.title);
        return (
          <a
            href={`${basePath}/${slug}`}
            class="project-card"
            style={`animation-delay: ${index * 60}ms`}
          >
            {project.image && (
              <div class="card-img-wrap">
                <div class="browser-bar">
                  <span class="dot red"></span>
                  <span class="dot yellow"></span>
                  <span class="dot green"></span>
                </div>
                <img
                  src={project.image}
                  alt={project.title}
                  class="card-img"
                  loading="lazy"
                />
                <div class="card-overlay">
                  <ArrowUpRight class="overlay-icon" />
                </div>
              </div>
            )}
            <div class="card-body">
              <div class="card-top">
                <span class="status-badge">{project.status || 'Production'}</span>
                <ArrowUpRight class="arrow-icon" />
              </div>
              <h3 class="card-title">{project.title}</h3>
              <p class="card-role">{project.role}</p>
              <p class="card-desc">{project.description}</p>
              <div class="tag-row">
                {project.techStack.slice(0, 4).map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
                {project.techStack.length > 4 && (
                  <span class="tag">+{project.techStack.length - 4}</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="bottom-cta">
      <a
        href={profile.personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-btn"
      >
        <Github class="cta-icon" />
        <span>{isId ? 'Lihat Semua di GitHub' : 'View all on GitHub'}</span>
        <ExternalLink class="cta-ext" />
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(36px, 6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
    text-align: center;
    width: 100%;
  }

  .subheading {
    margin-top: 20px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.55);
    max-width: 540px;
    text-align: center;
    line-height: 1.6;
  }

  .projects-grid {
    margin-top: 64px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .project-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-4px);
  }

  /* Browser chrome bar */
  .card-img-wrap {
    position: relative;
    width: 100%;
    background-color: #0a0a0a;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    background-color: #1a1a1a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot.red    { background-color: #ff5f57; }
  .dot.yellow { background-color: #febc2e; }
  .dot.green  { background-color: #28c840; }

  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    top: 28px; /* below browser bar */
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-icon {
    width: 32px;
    height: 32px;
    color: #ffffff;
  }

  /* Card body */
  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .status-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background-color: rgba(132, 225, 12, 0.1);
    border: 1px solid rgba(132, 225, 12, 0.25);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.3);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover .arrow-icon {
    color: #ffffff;
    transform: translate(2px, -2px);
  }

  .card-title {
    margin-top: 16px;
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  .card-role {
    margin-top: 4px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-desc {
    margin-top: 12px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-row {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 3px 10px;
  }

  /* Bottom CTA */
  .bottom-cta {
    margin-top: 56px;
    display: flex;
    justify-content: center;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #ffffff;
    color: #0a0a0a;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .cta-btn:hover {
    background-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-icon {
    width: 18px;
    height: 18px;
  }

  .cta-ext {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-section {
      padding-block: 80px;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .heading {
      font-size: 40px;
    }
  }
</style>
