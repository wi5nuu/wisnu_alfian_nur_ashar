---
import { profile } from '../../data/profile';
import { ExternalLink, Github } from 'lucide-astro';
---

<section id="projects" class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-sage-900 mb-4 inline-block relative">
        Featured Projects
        <span class="absolute -bottom-2 left-0 w-full h-1 bg-sage-200 rounded-full"></span>
      </h2>
      <p class="text-charcoal/70 max-w-2xl mx-auto mt-4">
        Real-world applications delivering value to users in production environments.
      </p>
    </div>

    <!-- Featured Projects -->
    <div class="grid md:grid-cols-2 gap-8 mb-20">
      {profile.projects.filter(p => p.featured !== false).map((project) => (
        <article class="group relative bg-white rounded-2xl border border-cream-200 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col h-full">
          <!-- Status Badge -->
          <div class="absolute top-4 right-4 z-10">
            <span class="px-3 py-1 bg-sage-500 text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">
              {project.status}
            </span>
          </div>

          <!-- Project Content -->
          <div class="h-full flex flex-col">
            {project.image && (
              <div class="relative w-full h-48 overflow-hidden group-hover:opacity-90 transition-opacity">
                <img 
                  src={project.image} 
                  alt={project.title} 
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
            )}
            
            <div class="p-8 flex-1 flex flex-col">
              <div class="mb-4">
               <h3 class="text-2xl font-serif font-bold text-sage-900 group-hover:text-sage-600 transition-colors">
                 {project.title}
               </h3>
               <p class="text-sm text-sage-500 font-medium mb-1">{project.role}</p>
            </div>

            <p class="text-charcoal/80 mb-6 leading-relaxed flex-1">
              {project.description}
            </p>

            <div class="space-y-6 mt-auto">
              <!-- Tech Stack -->
              <div class="flex flex-wrap gap-2">
                {project.techStack.map(tech => (
                  <span class="px-3 py-1 bg-cream-50 text-sage-700 text-xs font-medium border border-cream-200 rounded-md">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Links -->
              <div class="flex items-center gap-4 pt-4 border-t border-cream-100">
                <a 
                  href={project.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn btn-primary text-sm py-2 px-4 flex items-center gap-2"
                >
                  <ExternalLink class="w-4 h-4" />
                  Visit Live Site
                </a>
                {project.github && (
                  <a 
                    href={project.github} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    title="Source Code"
                    class="btn border border-sage-200 text-sage-700 hover:bg-sage-50 hover:border-sage-300 py-2 px-3 flex items-center justify-center transition-colors rounded-full"
                  >
                    <Github class="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          </div>
          </div>
          
          <!-- Decorative bottom gradient -->
          <div class="h-1 bg-gradient-to-r from-sage-300 via-sage-500 to-sage-400"></div>
        </article>
      ))}
    </div>

    <!-- Other Projects -->
    <div class="text-center mb-10 reveal-bottom">
      <h3 class="text-2xl font-serif font-bold text-sage-900 mb-2 inline-block relative">
        Other Projects
      </h3>
      <p class="text-charcoal/70 max-w-2xl mx-auto mt-2 text-sm">
        Additional work, templates, and community projects.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 reveal-bottom">
      {profile.projects.filter(p => p.featured === false).map((project) => (
        <article class="group relative bg-white rounded-xl border border-cream-200 overflow-hidden hover:shadow-md transition-all duration-300 p-6 flex flex-col h-full">
          <div class="mb-3">
            <h4 class="text-lg font-serif font-bold text-sage-900 group-hover:text-sage-600 transition-colors">
              {project.title}
            </h4>
            <p class="text-xs text-sage-500 font-medium mb-1">{project.role}</p>
          </div>

          <p class="text-sm text-charcoal/80 mb-4 leading-relaxed flex-1">
            {project.description}
          </p>

          <div class="space-y-4 mt-auto">
            <div class="flex flex-wrap gap-1.5">
              {project.techStack.map(tech => (
                <span class="px-2 py-0.5 bg-cream-50 text-sage-700 text-[10px] font-medium border border-cream-200 rounded-md">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-3 pt-3 border-t border-cream-100">
              <a 
                href={project.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-sage-600 hover:text-sage-800 text-xs font-semibold flex items-center gap-1 transition-colors"
              >
                <ExternalLink class="w-3 h-3" /> Live
              </a>
              {project.github && (
                <a 
                  href={project.github} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  title="Source Code"
                  class="text-sage-600 hover:text-sage-800 flex items-center transition-colors"
                >
                  <Github class="w-4 h-4" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
