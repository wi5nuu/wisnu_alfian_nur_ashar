---
import { profile } from '../../data/profile';
import { ExternalLink, Github } from 'lucide-astro';
---

<section id="projects" class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h2 class="inline-block relative">
        Featured Projects
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 rounded-full"></span>
      </h2>
      <p class="text-charcoal/70 max-w-2xl mx-auto mt-2 text-sm">
        Real-world applications delivering value to users in production environments.
      </p>
    </div>

    <!-- Unified Projects Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {profile.projects.map((project) => (
        <article class="group relative bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col h-full shadow-sm hover:-translate-y-1">
          <!-- Status Badge -->
          <div class="absolute top-8 right-3 z-20">
            <span class="px-2.5 py-0.5 bg-slate-950 text-white text-[9px] font-bold uppercase tracking-widest rounded-full shadow-lg border border-white/10">
              {project.status || 'Verified'}
            </span>
          </div>

          <!-- Project Content -->
          <div class="h-full flex flex-col">
            {project.image && (
              <div class="relative w-full">
                <!-- Browser Header Mockup -->
                <div class="w-full h-5 bg-slate-100 border-b border-slate-200 flex items-center gap-1 px-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-red-400"></div>
                  <div class="w-1.5 h-1.5 rounded-full bg-yellow-400"></div>
                  <div class="w-1.5 h-1.5 rounded-full bg-green-400"></div>
                </div>
                <div class="relative h-32 md:h-40 overflow-hidden group-hover:opacity-95 transition-opacity">
                  <img 
                    src={project.image} 
                    alt={project.title} 
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
              </div>
            )}
            
            <div class="p-5 flex-1 flex flex-col">
              <div class="mb-3">
                <h3 class="font-bold text-slate-900 group-hover:text-sage-600 transition-colors text-base">
                  {project.title}
                </h3>
                <p class="text-[9px] text-sage-500 font-bold uppercase tracking-widest mt-0.5">{project.role}</p>
              </div>

              <p class="text-slate-500 mb-5 text-xs leading-relaxed flex-1 font-medium italic">
                "{project.description}"
              </p>

              <div class="space-y-4 mt-auto">
                <!-- Tech Stack -->
                <div class="flex flex-wrap gap-1.5">
                  {project.techStack.map(tech => (
                    <span class="px-2 py-0.5 bg-slate-50 text-slate-700 text-[9px] font-bold border border-slate-100 rounded-md uppercase tracking-tight">
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Links -->
                <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
                  <a 
                    href={project.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-slate-900 hover:text-black text-[10px] font-bold uppercase tracking-widest flex items-center gap-1.5 transition-colors underline decoration-slate-200 underline-offset-4"
                  >
                    <ExternalLink class="w-3 h-3" /> Live
                  </a>
                  {project.github && (
                    <a 
                      href={project.github} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      title="Source Code"
                      class="text-slate-400 hover:text-slate-900 flex items-center transition-colors"
                    >
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
          
          <!-- Decorative bottom gradient -->
          <div class="h-1 bg-gradient-to-r from-slate-200 via-slate-900 to-slate-200 opacity-20"></div>
        </article>
      ))}
    </div>
  </div>
</section>
