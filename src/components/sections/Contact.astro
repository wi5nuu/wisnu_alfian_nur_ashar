---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Mail, MapPin, Send, Linkedin, Instagram, Facebook, MessageCircle, Globe } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

const socialLinks = [
  { icon: Linkedin, href: profile.personalInfo.linkedin, label: "LinkedIn" },
  { icon: Instagram, href: profile.personalInfo.instagram, label: "Instagram" },
  { icon: Facebook, href: profile.personalInfo.facebook, label: "Facebook" },
  { icon: MessageCircle, href: profile.personalInfo.line, label: "Line" },
  { icon: Globe, href: profile.personalInfo.website, label: "Website" },
];
---

<section class="contact-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'KONTAK' : 'CONTACT'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Mari' : "Let's"}<br />
      {isId ? 'Terhubung' : 'Connect'}
    </h2>

    <p class="subheading">
      {isId
        ? 'Terbuka untuk kolaborasi. Jangan ragu untuk menghubungi atau sekadar bertukar sapa ramah.'
        : 'Open for opportunities. Feel free to reach out for collaborations or just a friendly hello.'}
    </p>

    <div class="contact-grid">
      <!-- Info Panel -->
      <div class="info-panel">
        <div class="info-block">
          <div class="info-row">
            <div class="info-icon-wrap">
              <Mail class="info-icon" />
            </div>
            <div>
              <p class="info-label">{isId ? 'Email' : 'Email'}</p>
              <a href={`mailto:${profile.personalInfo.email}`} class="info-value">{profile.personalInfo.email}</a>
            </div>
          </div>
          <div class="info-row">
            <div class="info-icon-wrap">
              <MapPin class="info-icon" />
            </div>
            <div>
              <p class="info-label">{isId ? 'Lokasi' : 'Location'}</p>
              <p class="info-value">{profile.personalInfo.location}</p>
            </div>
          </div>
        </div>

        <div class="social-block">
          <p class="social-label">{isId ? 'Media Sosial' : 'Social Media'}</p>
          <div class="social-row">
            {socialLinks.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="social-btn"
              >
                <item.icon class="social-icon" />
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Form Panel -->
      <div class="form-panel">
        <h3 class="form-title">{isId ? 'Kirim Pesan' : 'Send a Message'}</h3>

        <form id="contact-form" class="contact-form">
          <input type="hidden" name="access_key" value={import.meta.env.WEB3FORMS_ACCESS_KEY || "06fc49f0-58b2-493d-a3ae-cc560f16ef98"} />
          <input type="hidden" name="subject" value="New Submission from Portfolio" />
          <input type="checkbox" name="botcheck" style="display: none;" />

          <div class="field">
            <label for="contact-name" class="field-label">{isId ? 'Nama Lengkap' : 'Full Name'}</label>
            <input
              id="contact-name"
              type="text"
              name="name"
              required
              placeholder="Wisnu Alfian"
              class="field-input"
            />
          </div>

          <div class="field">
            <label for="contact-email" class="field-label">{isId ? 'Alamat Email' : 'Email Address'}</label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              placeholder="wisnu@example.com"
              class="field-input"
            />
          </div>

          <div class="field">
            <label for="contact-message" class="field-label">{isId ? 'Pesan' : 'Message'}</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="5"
              placeholder={isId ? 'Bagaimana saya bisa membantu Anda?' : 'How can I help you?'}
              class="field-input field-textarea"
            ></textarea>
          </div>

          <button type="submit" id="submit-btn" class="submit-btn">
            <span id="btn-text">{isId ? 'Kirim Pesan' : 'Send Message'}</span>
            <Send class="submit-icon" />
          </button>

          <p id="response-msg" class="response-msg hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("submit-btn");
  const btnText = document.getElementById("btn-text");
  const responseMsg = document.getElementById("response-msg");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    const isId = window.location.pathname.startsWith('/id');
    const sendingText = isId ? "Mengirim..." : "Sending...";
    const defaultText = isId ? "Kirim Pesan" : "Send Message";
    responseMsg.classList.add("hidden");
    btn.disabled = true;
    btnText.innerText = sendingText;
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);
    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: json,
    })
      .then(async (response) => {
        if (response.status == 200) {
          responseMsg.style.color = "var(--accent)";
          responseMsg.innerText = isId ? "Pesan berhasil terkirim! Saya akan segera menghubungi Anda." : "Message sent successfully! I will get back to you soon.";
          form.reset();
        } else {
          responseMsg.style.color = "#ef4444";
          responseMsg.innerText = isId ? "Terjadi kesalahan, silakan coba lagi." : "Something went wrong, please try again.";
        }
      })
      .catch(() => {
        responseMsg.style.color = "#ef4444";
        responseMsg.innerText = isId ? "Gagal terhubung ke server." : "Failed to connect to the server.";
      })
      .finally(() => {
        responseMsg.classList.remove("hidden");
        btn.disabled = false;
        btnText.innerText = defaultText;
      });
  });
</script>

<style>
  .contact-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    text-align: center;
    width: 100%;
  }

  .subheading {
    margin-top: 20px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    text-align: center;
    line-height: 1.6;
  }

  /* Grid */
  .contact-grid {
    margin-top: 56px;
    width: 100%;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* Info Panel */
  .info-panel {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .info-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: rgba(132, 225, 12, 0.1);
    border: 1px solid rgba(132, 225, 12, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .info-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 600;
    margin: 0;
  }

  .info-value {
    margin-top: 4px;
    font-size: 14px;
    color: #ffffff;
    font-weight: 500;
    text-decoration: none;
    display: block;
    transition: color 0.2s ease;
  }

  a.info-value:hover {
    color: var(--accent);
  }

  .social-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .social-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 600;
    margin: 0;
  }

  .social-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.5);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .social-btn:hover {
    background-color: rgba(132, 225, 12, 0.1);
    border-color: var(--accent);
    color: var(--accent);
  }

  .social-icon {
    width: 16px;
    height: 16px;
  }

  /* Form Panel */
  .form-panel {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 32px;
  }

  .form-title {
    font-size: 22px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 28px 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.4);
  }

  .field-input {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    box-sizing: border-box;
  }

  .field-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .field-input:focus {
    border-color: var(--accent);
    background-color: rgba(132, 225, 12, 0.04);
  }

  .field-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: var(--accent);
    color: #0a0a0a;
    border: none;
    border-radius: 12px;
    padding: 16px 32px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: filter 0.2s ease, transform 0.2s ease;
    width: 100%;
  }

  .submit-btn:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .submit-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .response-msg {
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    margin-top: 4px;
  }

  .response-msg.hidden {
    display: none;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .info-panel {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
    }
    .info-block,
    .social-block {
      flex: 1 1 200px;
    }
  }

  @media (max-width: 640px) {
    .contact-section {
      padding-block: 80px;
    }
    .info-panel {
      flex-direction: column;
    }
  }
</style>
