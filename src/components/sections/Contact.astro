---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
import { Mail, MapPin, Send, Linkedin, Instagram, Facebook, MessageCircle, Globe, Phone } from "lucide-astro";

const socialLinks = [
  { icon: Linkedin, href: profile.personalInfo.linkedin, label: "LinkedIn" },
  { icon: Instagram, href: profile.personalInfo.instagram, label: "Instagram" },
  { icon: Facebook, href: profile.personalInfo.facebook, label: "Facebook" },
  { icon: MessageCircle, href: profile.personalInfo.line, label: "Line" },
  { icon: Globe, href: profile.personalInfo.website, label: "Website" },
];
---

<section id="contact" class="section">
  <div class="container-custom px-4">
    <div class="max-w-4xl mx-auto bg-white dark:bg-slate-800/80 backdrop-blur-sm rounded-[2rem] overflow-hidden shadow-2xl flex flex-col md:flex-row border border-white dark:border-slate-700/50">
      <!-- Info Panel -->
      <div class="relative w-full md:w-5/12 bg-sage-900 dark:bg-slate-900/80 text-white p-6 md:p-8 flex flex-col justify-between overflow-hidden reveal-left">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 dark:bg-sage-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="font-bold mb-3 text-2xl text-white">{isId ? 'Mari Terhubung' : "Let's Connect"}</h2>
          <p class="text-sage-200 dark:text-slate-400 leading-relaxed font-light mb-6 text-sm">
            {isId ? 'Terbuka untuk kolaborasi. Jangan ragu untuk menghubungi atau sekadar bertukar sapa ramah.' : 'Open for opportunities. Feel free to reach out for collaborations or just a friendly hello.'}
          </p>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <Mail class="w-4 h-4 text-sage-300 dark:text-sage-400" />
              <p class="text-white dark:text-slate-300 text-[13px] font-medium leading-none">{profile.personalInfo.email}</p>
            </div>
            <div class="flex items-center gap-3">
              <MapPin class="w-4 h-4 text-sage-300 dark:text-sage-400" />
              <p class="text-white dark:text-slate-300 text-[13px] font-medium leading-none">{profile.personalInfo.location}</p>
            </div>
          </div>
        </div>
        <div class="relative z-10 mt-8">
          <p class="text-[10px] text-sage-400 dark:text-slate-500 mb-3 uppercase tracking-widest font-bold">Social Media</p>
          <div class="flex flex-wrap gap-2.5">
            {socialLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 dark:bg-slate-700/50 border border-white/10 dark:border-slate-600/50 text-sage-300 dark:text-slate-400 hover:bg-white hover:text-sage-900 dark:hover:bg-sage-500 dark:hover:text-white dark:hover:border-sage-500 transition-all duration-300 active:scale-90">
                <item.icon class="w-3.5 h-3.5" />
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Form Panel -->
      <div class="w-full md:w-7/12 bg-white dark:bg-slate-800/60 p-6 md:p-8 relative text-left reveal-right delay-200">
        <div class="max-w-sm mx-auto md:mx-0 relative z-10">
          <h3 class="font-bold text-sage-900 dark:text-white mb-4 text-xl">{isId ? 'Kirim Pesan' : 'Send Message'}</h3>

          <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-3.5">
            <input type="hidden" name="access_key" value={import.meta.env.WEB3FORMS_ACCESS_KEY || "06fc49f0-58b2-493d-a3ae-cc560f16ef98"} />
            <input type="hidden" name="subject" value="New Submission from Portfolio" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div>
              <label for="contact-name" class="block text-[10px] font-bold text-sage-400 dark:text-slate-400 uppercase tracking-widest mb-1.5">{isId ? 'Nama Lengkap' : 'Full Name'}</label>
              <input id="contact-name" type="text" name="name" required placeholder="Wisnu Alfian" class="w-full px-4 py-2.5 bg-sage-50/50 dark:bg-slate-700/50 border border-sage-100 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-sage-900/5 dark:focus:ring-sage-500/30 outline-none transition-all text-sm font-medium text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" />
            </div>

            <div>
              <label for="contact-email" class="block text-[10px] font-bold text-sage-400 dark:text-slate-400 uppercase tracking-widest mb-1.5">{isId ? 'Alamat Email' : 'Email Address'}</label>
              <input id="contact-email" type="email" name="email" required placeholder="wisnu@example.com" class="w-full px-4 py-2.5 bg-sage-50/50 dark:bg-slate-700/50 border border-sage-100 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-sage-900/5 dark:focus:ring-sage-500/30 outline-none transition-all text-sm font-medium text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" />
            </div>

            <div>
              <label for="contact-message" class="block text-[10px] font-bold text-sage-400 dark:text-slate-400 uppercase tracking-widest mb-1.5">{isId ? 'Pesan' : 'Message'}</label>
              <textarea id="contact-message" name="message" required rows="3" placeholder={isId ? 'Bagaimana saya bisa membantu Anda?' : 'How can I help you?'} class="w-full px-4 py-2.5 bg-sage-50/50 dark:bg-slate-700/50 border border-sage-100 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-sage-900/5 dark:focus:ring-sage-500/30 outline-none transition-all text-sm font-medium resize-none text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"></textarea>
            </div>

            <button type="submit" id="submit-btn" class="w-full group flex items-center justify-center gap-2 px-6 py-3 bg-sage-900 dark:bg-sage-600 text-white rounded-xl font-bold text-xs tracking-widest uppercase shadow-lg hover:bg-sage-800 dark:hover:bg-sage-500 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed border border-transparent dark:border-sage-500">
              <span id="btn-text">{isId ? 'Kirim Pesan' : 'Send Message'}</span>
              <Send class="w-3 h-3 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </button>

            <p id="response-msg" class="text-center text-sm font-medium mt-4 hidden"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("submit-btn");
  const btnText = document.getElementById("btn-text");
  const responseMsg = document.getElementById("response-msg");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    const isId = window.location.pathname.startsWith('/id');
    const sendingText = isId ? "Mengirim..." : "Sending...";
    const defaultText = isId ? "Kirim Pesan" : "Send Message";
    responseMsg.classList.add("hidden");
    btn.disabled = true;
    btnText.innerText = sendingText;
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);
    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: json,
    })
      .then(async (response) => {
        if (response.status == 200) {
          responseMsg.className = "text-center text-sm font-medium mt-4 text-green-600 dark:text-emerald-400";
          responseMsg.innerText = isId ? "Pesan berhasil terkirim! Saya akan segera menghubungi Anda." : "Message sent successfully! I will get back to you soon.";
          form.reset();
        } else {
          responseMsg.className = "text-center text-sm font-medium mt-4 text-red-500 dark:text-red-400";
          responseMsg.innerText = isId ? "Terjadi kesalahan, silakan coba lagi." : "Something went wrong, please try again.";
        }
      })
      .catch(() => {
        responseMsg.className = "text-center text-sm font-medium mt-4 text-red-500 dark:text-red-400";
        responseMsg.innerText = isId ? "Gagal terhubung ke server." : "Failed to connect to the server.";
      })
      .finally(() => {
        responseMsg.classList.remove("hidden");
        btn.disabled = false;
        btnText.innerText = defaultText;
      });
  });
</script>
