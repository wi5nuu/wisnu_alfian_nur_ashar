---
import { profile } from "../../data/profile";
import { Calendar, MapPin, Briefcase } from "lucide-astro";
---

<section id="experience" class="section bg-white">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h2 class="inline-block relative">
        Work Experience
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 rounded-full"></span>
      </h2>
      <p class="text-charcoal/60 max-w-xl mx-auto mt-4 text-sm">
        My professional journey building production systems and leading technical teams.
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Timeline vertical line -->
        <div class="absolute left-3.5 top-0 bottom-0 w-px bg-gradient-to-b from-sage-200 via-sage-300 to-transparent"></div>

        <div class="space-y-6">
          {profile.experience.map((exp, index) => (
            <div class="relative pl-12 group">
              <!-- Timeline dot -->
              <div class="absolute left-0 top-1 flex items-center justify-center w-7 h-7 rounded-full bg-white border-2 border-sage-300 group-hover:border-sage-500 transition-colors z-10 shadow-sm">
                <div class="w-1.5 h-1.5 bg-sage-400 group-hover:bg-sage-600 rounded-full transition-colors"></div>
              </div>

              <!-- Card -->
              <div class="bg-white border border-slate-100 rounded-xl p-4 md:p-5 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                
                <!-- Header -->
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <div>
                    <h3 class="font-bold text-slate-900 text-base leading-tight group-hover:text-sage-600 transition-colors">
                      {exp.role}
                    </h3>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                      <span class="text-sm font-semibold text-sage-700">{exp.company}</span>
                      <span class="px-2 py-0.5 bg-sage-50 text-sage-600 text-[9px] font-bold uppercase tracking-widest border border-sage-100 rounded-full">
                        {exp.type}
                      </span>
                    </div>
                  </div>

                  <!-- Date + Location -->
                  <div class="text-right shrink-0">
                    <div class="flex items-center gap-1 text-[11px] text-slate-400 font-medium justify-end">
                      <Calendar class="w-3 h-3" />
                      <span>{exp.duration}</span>
                    </div>
                    <div class="flex items-center gap-1 text-[11px] text-slate-400 justify-end mt-0.5">
                      <MapPin class="w-3 h-3" />
                      <span>{exp.location}</span>
                    </div>
                  </div>
                </div>

                <!-- Description -->
                <p class="text-[12.5px] text-slate-500 leading-relaxed mb-3 italic">
                  {exp.description}
                </p>

                <!-- Skills -->
                <div class="flex flex-wrap gap-1.5">
                  {exp.skills.map((skill) => (
                    <span class="px-2.5 py-0.5 bg-slate-50 text-slate-600 text-[9px] font-bold uppercase tracking-wider border border-slate-100 rounded-md">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
