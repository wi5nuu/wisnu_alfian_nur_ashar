---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import Timeline from "../Timeline.astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="experience" class="section">
  <div class="container-custom">

    <!-- ===== WORK EXPERIENCE ===== -->
    <div class="text-center mb-12 md:mb-16 reveal-up">
      <h2 class="inline-block relative text-sage-900 dark:text-white text-2xl md:text-3xl font-serif font-bold">
        {isId ? 'Pengalaman Kerja' : 'Work Experience'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
    </div>

    <Timeline items={profile.experience} />

    <!-- ===== ORGANIZATIONAL EXPERIENCE ===== -->
    <div class="mt-16 md:mt-24">
      <div class="text-center mb-12 md:mb-16 reveal-up">
        <h2 class="inline-block relative text-sage-900 dark:text-white text-2xl md:text-3xl font-serif font-bold">
          {isId ? 'Pengalaman Organisasi' : 'Organizational Experience'}
          <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
        </h2>
      </div>

      <Timeline items={profile.organizationalExperience} />
    </div>

  </div>
</section>