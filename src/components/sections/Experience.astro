---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Calendar, MapPin, Briefcase } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="experience" class="section bg-white dark:bg-[#0f172a]">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h2 class="inline-block relative dark:text-white">
        {isId ? 'Pengalaman Kerja' : 'Work Experience'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-600 rounded-full"></span>
      </h2>
      <p class="text-charcoal/60 dark:text-white max-w-xl mx-auto mt-4 text-sm">
        {isId ? 'Perjalanan karir saya membangun sistem produksi dan memimpin tim teknis.' : 'My professional journey building production systems and leading technical teams.'}
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Timeline vertical line -->
        <div class="absolute left-3.5 top-0 bottom-0 w-px bg-gradient-to-b from-sage-200 via-sage-300 to-transparent"></div>

        <!-- Scrollable container (shows ~2 items, scroll to see more) -->
        <div id="experience-scroll" class="relative h-[520px] md:h-[480px] overflow-y-auto pr-2 scroll-smooth hide-scrollbar" style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
          <div class="space-y-6 pb-4">
            {profile.experience.map((exp, index) => (
              <div class="relative pl-12 group reveal-up">
                <!-- Timeline dot -->
                <div class="absolute left-0 top-1 flex items-center justify-center w-7 h-7 rounded-full bg-white dark:bg-slate-800 border-2 border-sage-300 dark:border-sage-600 group-hover:border-sage-500 transition-colors z-10 shadow-sm">
                  <div class="w-1.5 h-1.5 bg-sage-400 dark:bg-sage-500 group-hover:bg-sage-600 transition-colors rounded-full"></div>
                </div>

                <!-- Card -->
                <div class="bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-xl p-4 md:p-5 hover:shadow-md transition-all duration-300 shadow-sm">

                  <!-- Header -->
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                    <div>
                      <h3 class="font-bold text-slate-900 dark:text-white text-base leading-tight group-hover:text-sage-600 dark:group-hover:text-sage-400 transition-colors">
                        {exp.role}
                      </h3>
                      <div class="flex items-center gap-2 mt-1 flex-wrap">
                        <span class="text-sm font-semibold text-sage-700 dark:text-white">{exp.company}</span>
                        <span class="px-2 py-0.5 bg-sage-50 dark:bg-sage-900/30 text-sage-600 dark:text-white text-[9px] font-bold uppercase tracking-widest border border-sage-100 dark:border-sage-800 rounded-full">
                          {exp.type}
                        </span>
                      </div>
                    </div>

                    <!-- Date + Location -->
                    <div class="text-right shrink-0">
                      <div class="flex items-center gap-1 text-[11px] text-slate-400 dark:text-white font-medium justify-end">
                        <Calendar class="w-3 h-3" />
                        <span>{exp.duration}</span>
                      </div>
                      <div class="flex items-center gap-1 text-[11px] text-slate-400 dark:text-white justify-end mt-0.5">
                        <MapPin class="w-3 h-3" />
                        <span>{exp.location}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Description -->
                  <p class="text-[12.5px] text-slate-500 dark:text-white leading-relaxed mb-3 italic">
                    {exp.description}
                  </p>

                  <!-- Skills -->
                  <div class="flex flex-wrap gap-1.5">
                    {exp.skills.map((skill) => (
                      <span class="px-2.5 py-0.5 bg-slate-50 dark:bg-slate-700 text-slate-600 dark:text-white text-[9px] font-bold uppercase tracking-wider border border-slate-100 dark:border-slate-600 rounded-md">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Scroll indicator -->
          <div id="scroll-indicator" class="sticky bottom-0 left-0 right-0 flex flex-col items-center pt-4 pb-2 bg-gradient-to-t from-white dark:from-[#0f172a] to-transparent pointer-events-none">
            <span class="text-[10px] text-slate-400 dark:text-white/50 font-medium tracking-wider uppercase mb-1">
              {isId ? 'Geser untuk melihat semua' : 'Scroll to see all'}
            </span>
            <div class="w-5 h-8 border-2 border-slate-300 dark:border-slate-600 rounded-full flex justify-center">
              <div class="w-1 h-2 bg-sage-400 dark:bg-sage-500 rounded-full mt-1.5 animate-bounce"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom scrollbar for experience section */
  #experience-scroll::-webkit-scrollbar {
    width: 4px;
  }
  #experience-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  #experience-scroll::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 20px;
  }
  .dark #experience-scroll::-webkit-scrollbar-thumb {
    background-color: #475569;
  }

  /* Hide scrollbar utility */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: thin;
  }
</style>

<script>
  const setupExperienceScroll = () => {
    const scrollContainer = document.getElementById("experience-scroll");
    const indicator = document.getElementById("scroll-indicator");

    if (!scrollContainer || !indicator) return;

    let isScrollingToSection = false;

    // Scroll indicator visibility
    const checkScroll = () => {
      const isAtBottom = scrollContainer.scrollTop + scrollContainer.clientHeight >= scrollContainer.scrollHeight - 10;
      const isAtTop = scrollContainer.scrollTop <= 10;
      indicator.style.opacity = (isAtBottom || isAtTop) ? "0" : "1";
      indicator.style.transition = "opacity 0.3s ease";
    };

    // Smooth scroll to next/prev section when user tries to scroll past edges
    const handleWheel = (e: WheelEvent) => {
      const isAtTop = scrollContainer.scrollTop <= 5;
      const isAtBottom = scrollContainer.scrollTop + scrollContainer.clientHeight >= scrollContainer.scrollHeight - 5;

      // User tries to scroll up while at the top -> go to previous section
      if (isAtTop && e.deltaY < 0 && !isScrollingToSection) {
        e.preventDefault();
        isScrollingToSection = true;
        const expSection = document.getElementById("experience");
        const prevSection = expSection?.previousElementSibling;
        if (prevSection) {
          prevSection.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        setTimeout(() => { isScrollingToSection = false; }, 800);
        return;
      }

      // User tries to scroll down while at the bottom -> go to next section
      if (isAtBottom && e.deltaY > 0 && !isScrollingToSection) {
        e.preventDefault();
        isScrollingToSection = true;
        const expSection = document.getElementById("experience");
        const nextSection = expSection?.nextElementSibling;
        if (nextSection) {
          nextSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        setTimeout(() => { isScrollingToSection = false; }, 800);
        return;
      }
    };

    scrollContainer.addEventListener("scroll", checkScroll);
    scrollContainer.addEventListener("wheel", handleWheel, { passive: false });
    checkScroll();

    document.addEventListener("astro:before-swap", () => {
      scrollContainer.removeEventListener("scroll", checkScroll);
      scrollContainer.removeEventListener("wheel", handleWheel);
    });
  };

  document.addEventListener("DOMContentLoaded", setupExperienceScroll);
  document.addEventListener("astro:after-swap", setupExperienceScroll);
</script>
