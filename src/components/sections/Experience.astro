---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Calendar, MapPin } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="experience" class="section">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="inline-block relative text-sage-900 dark:text-white text-3xl font-serif font-bold">
        {isId ? 'Pengalaman Kerja' : 'Work Experience'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
    </div>

    <div class="max-w-5xl mx-auto relative">
      <!-- Vertical line (only on desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-sage-200 via-sage-300 to-transparent dark:from-sage-700 dark:via-sage-600 dark:opacity-30"></div>

      <div class="space-y-12">
        {profile.experience.map((exp, index) => {
          const isEven = index % 2 === 0;
          return (
            <div 
              class={`relative flex flex-col md:flex-row items-center md:justify-between reveal-up ${isEven ? 'md:flex-row-reverse' : ''}`}
              style={`transition-delay: ${index * 150}ms`}
            >
              
              <!-- Content -->
              <div class="w-full md:w-[45%]">
                <div class="bg-white dark:bg-slate-800/60 backdrop-blur-sm border border-slate-100 dark:border-transparent rounded-2xl p-6 hover:shadow-lg transition-all duration-300 shadow-sm">
                  <div class="mb-3">
                    <h3 class="font-bold text-slate-900 dark:text-white text-lg leading-tight group-hover:text-sage-600 dark:group-hover:text-sage-400 transition-colors">
                      {exp.role}
                    </h3>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                      <span class="text-sm font-semibold text-sage-700 dark:text-sage-400">{exp.company}</span>
                      <span class="px-2 py-0.5 bg-sage-50 dark:bg-sage-900/40 text-sage-600 dark:text-sage-300 text-[10px] font-bold uppercase tracking-widest border border-sage-100 dark:border-transparent rounded-full">
                        {exp.type}
                      </span>
                    </div>
                  </div>

                  <p class="text-sm text-slate-500 dark:text-slate-300 leading-relaxed mb-4 italic">
                    {exp.description}
                  </p>

                  <div class="flex flex-wrap gap-2">
                    {exp.skills.map((skill) => (
                      <span class="px-3 py-1 bg-slate-50 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300 text-[10px] font-bold uppercase tracking-wider border border-slate-100 dark:border-transparent rounded-md">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Dot in middle -->
              <div class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 flex items-center justify-center w-8 h-8 rounded-full bg-white dark:bg-slate-800 border-2 border-sage-300 dark:border-sage-500/50 shadow-sm z-10">
                <div class="w-2 h-2 bg-sage-400 dark:bg-sage-400 rounded-full"></div>
              </div>

              <!-- Time/Location -->
              <div class={`w-full md:w-[45%] flex ${isEven ? 'md:justify-start' : 'md:justify-end'}`}>
                 <div class="text-left md:text-right p-4">
                    <div class="flex items-center gap-2 text-sm text-slate-400 font-medium mb-1">
                      <Calendar class="w-4 h-4" />
                      <span>{exp.duration}</span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-slate-400">
                      <MapPin class="w-4 h-4" />
                      <span>{exp.location}</span>
                    </div>
                 </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
