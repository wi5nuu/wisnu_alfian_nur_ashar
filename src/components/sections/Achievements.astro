---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Award } from "lucide-astro";
import ImageModal from "../ImageModal.astro";
import Picture from "../Picture.astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="achievements" class="achievements-section">
  <div class="achievements-container">
    <div class="achievements-header">
      <h2 class="achievements-title">
        {isId ? 'Prestasi Lomba' : 'Competition Achievements'}
      </h2>
      <p class="achievements-subtitle">
        {isId
          ? 'Partisipasi dalam berbagai kompetisi teknologi yang membuktikan semangat kompetitif dan kemampuan adaptasi.'
          : 'Participation in various technology competitions, showcasing competitive spirit and adaptability.'}
      </p>
    </div>

    <div class="achievements-grid">
      {profile.competitions.map((comp, index) => (
        <div class="comp-card" style={`transition-delay: ${index * 100}ms`}>
          {/* Image */}
          <div class="comp-image-wrap">
            {comp.image ? (
              <Picture
                src={comp.image}
                alt={comp.name}
                class="comp-image"
                onclick={`openModal('achv-modal', '${comp.image}', '${comp.name}')`}
              />
            ) : (
              <div class="comp-image-placeholder">
                <Award class="comp-placeholder-icon" />
              </div>
            )}
          </div>

          {/* Content */}
          <div class="comp-content">
            <h3 class="comp-name">{comp.name}</h3>
            <p class="comp-issuer">{comp.issuer}</p>
            <p class="comp-desc">{comp.description}</p>
            <div class="comp-footer">
              <span class="comp-date">{comp.date}</span>
              <span class="comp-badge">{isId ? 'Peserta' : 'Participant'}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<ImageModal id="achv-modal" />

<style>
  .achievements-section {
    background-color: var(--bg, #0a0a0a);
    padding-block: 64px;
    font-family: var(--font-sans);
  }

  .achievements-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
  }

  .achievements-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .achievements-title {
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }

  .achievements-subtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    margin-inline: auto;
    line-height: 1.6;
  }

  /* 4 kolom selalu berdampingan di desktop */
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .comp-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
    min-width: 0;
  }

  .comp-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .comp-image-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .comp-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.4s ease;
  }

  .comp-card:hover .comp-image {
    transform: scale(1.05);
  }

  .comp-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .comp-placeholder-icon {
    width: 28px;
    height: 28px;
    color: rgba(255, 255, 255, 0.2);
  }

  .comp-content {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .comp-name {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.4;
  }

  .comp-issuer {
    font-size: 10px;
    font-weight: 500;
    color: var(--accent, #84e10c);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .comp-desc {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .comp-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 2px;
  }

  .comp-date {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .comp-badge {
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
