---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Award } from "lucide-astro";
import ImageModal from "../ImageModal.astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="achievements" class="section">
  <div class="container-custom">
    <div class="text-center mb-10 reveal-up">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 dark:text-white tracking-tight">
        <span class="bg-gradient-to-r from-sage-500 to-sage-600 bg-clip-text text-transparent">
          {isId ? 'Prestasi Lomba' : 'Competition Achievements'}
        </span>
      </h2>
      <p class="text-slate-500 dark:text-slate-400 mt-3 max-w-xl mx-auto text-sm leading-relaxed">
        {isId
          ? 'Partisipasi dalam berbagai kompetisi teknologi yang membuktikan semangat kompetitif dan kemampuan adaptasi.'
          : 'Participation in various technology competitions, showcasing competitive spirit and adaptability.'}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {profile.competitions.map((comp, index) => (
        <div
          class="group relative bg-white dark:bg-slate-800/70 backdrop-blur-sm rounded-2xl border border-slate-100 dark:border-slate-700/50 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 reveal-up"
          style={`transition-delay: ${(index * 150)}ms`}
        >
          {/* Image */}
          <div class="w-full aspect-video overflow-hidden bg-slate-50 dark:bg-slate-900/50">
            {comp.image ? (
              <img
                src={comp.image}
                alt={comp.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 cursor-pointer"
                loading="lazy"
                decoding="async"
                onclick={`openModal('achv-modal', '${comp.image}', '${comp.name}')`}
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <Award class="w-10 h-10 text-slate-300 dark:text-slate-500" />
              </div>
            )}
          </div>

          {/* Content */}
          <div class="p-5 space-y-2">
            <div class="flex items-center gap-2">
              <Award class="w-4 h-4 text-sage-500 dark:text-sage-400 shrink-0" />
              <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-tight">
                {comp.name}
              </h3>
            </div>

            <p class="text-[11px] font-bold text-sage-600 dark:text-sage-400 uppercase tracking-wider">
              {comp.issuer}
            </p>

            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3">
              {comp.description}
            </p>

            <div class="flex items-center justify-between pt-2 border-t border-slate-50 dark:border-slate-700/30">
              <span class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">
                {comp.date}
              </span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                {isId ? 'Peserta' : 'Participant'}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<ImageModal modalId="achv-modal" />
