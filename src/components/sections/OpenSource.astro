---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Bug, Shield, GitBranch, FileCode, ExternalLink, Github } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const items = profile.openSource;
---

<section class="opensource-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'OPEN SOURCE' : 'OPEN SOURCE'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Kontribusi' : 'Open Source'}<br />
      {isId ? 'Open Source' : 'Contributions'}
    </h2>

    <p class="subheading">
      {isId
        ? 'Laporan resmi penelitian bug pada proyek open-source kelas dunia. Setiap temuan telah dikonfirmasi oleh maintainer resmi.'
        : 'Official bug research reports and security contributions to world-class open-source projects. Every finding confirmed by official maintainers.'}
    </p>

    <div class="os-layout">
      <!-- Sidebar -->
      <div class="os-sidebar">
        {items.map((entry, index) => (
          <button
            data-os-btn
            data-index={index}
            class="os-btn"
          >
            <GitBranch class="os-btn-icon" />
            <span class="os-btn-label">{entry.organization}</span>
          </button>
        ))}
      </div>

      <!-- Detail Panel -->
      <div class="os-detail-wrap">
        {items.map((entry, index) => (
          <div
            data-os-detail
            data-index={index}
            class="os-detail hidden"
          >
            <div class="detail-header">
              <div>
                <h3 class="detail-org">{entry.organization}</h3>
                <p class="detail-project">{entry.project} — <span class="detail-lang">{entry.language}</span></p>
              </div>
              <span class="detail-category">{entry.category}</span>
            </div>

            <div class="detail-body">
              <div class="detail-block">
                <div class="detail-label">
                  <Bug class="detail-label-icon" />
                  {isId ? 'Deskripsi Bug' : 'Bug Description'}
                </div>
                <p class="detail-text">{entry.bugDescription}</p>
              </div>

              <div class="detail-block">
                <div class="detail-label">
                  <Shield class="detail-label-icon" />
                  {isId ? 'Dampak' : 'Impact'}
                </div>
                <p class="detail-text">{entry.impact}</p>
              </div>

              {entry.fileLocation && entry.fileLocation !== 'N/A' && (
                <div class="detail-block">
                  <div class="detail-label">
                    <FileCode class="detail-label-icon" />
                    {isId ? 'Lokasi File' : 'File Location'}
                  </div>
                  <code class="detail-code">{entry.fileLocation}</code>
                </div>
              )}

              <div class="detail-block">
                <div class="detail-label">
                  <ExternalLink class="detail-label-icon" />
                  {isId ? 'Respons Maintainer' : 'Maintainer Response'}
                </div>
                <p class="detail-text">{entry.maintainerResponse}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const btns = Array.from(document.querySelectorAll<HTMLElement>('[data-os-btn]'));
    const details = Array.from(document.querySelectorAll<HTMLElement>('[data-os-detail]'));

    function activate(index: number) {
      btns.forEach((b, i) => {
        if (i === index) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });
      details.forEach((d, i) => {
        if (i === index) {
          d.classList.remove('hidden');
        } else {
          d.classList.add('hidden');
        }
      });
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activate(parseInt(btn.dataset.index || '0'));
      });
    });

    if (btns.length > 0) activate(0);
  })();
</script>

<style>
  .opensource-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(36px, 6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    text-align: center;
    width: 100%;
  }

  .subheading {
    margin-top: 20px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 600px;
    text-align: center;
    line-height: 1.6;
  }

  /* Layout */
  .os-layout {
    margin-top: 56px;
    width: 100%;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* Sidebar */
  .os-sidebar {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: sticky;
    top: 100px;
  }

  .os-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px 14px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .os-btn:hover {
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .os-btn.active {
    border-color: var(--accent);
    color: #ffffff;
    background-color: rgba(132, 225, 12, 0.06);
  }

  .os-btn-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: inherit;
  }

  .os-btn-label {
    font-size: 12px;
    line-height: 1.3;
  }

  /* Detail panel */
  .os-detail-wrap {
    min-width: 0;
  }

  .os-detail {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
  }

  .os-detail.hidden {
    display: none;
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 28px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .detail-org {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }

  .detail-project {
    margin-top: 4px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }

  .detail-lang {
    color: var(--accent);
    font-weight: 500;
  }

  .detail-category {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background-color: rgba(132, 225, 12, 0.1);
    border: 1px solid rgba(132, 225, 12, 0.25);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .detail-body {
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .detail-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .detail-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.35);
  }

  .detail-label-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .detail-text {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .detail-code {
    font-size: 12px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    color: var(--accent);
    background-color: rgba(132, 225, 12, 0.08);
    border: 1px solid rgba(132, 225, 12, 0.2);
    border-radius: 6px;
    padding: 4px 10px;
    display: inline-block;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .opensource-section {
      padding-block: 80px;
    }
    .os-layout {
      grid-template-columns: 1fr;
    }
    .os-sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .os-btn {
      width: auto;
      flex: 0 0 auto;
    }
    .detail-header {
      padding: 20px;
    }
    .detail-body {
      padding: 20px;
    }
  }
</style>
