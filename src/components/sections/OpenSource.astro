---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Bug, Shield, GitBranch, FileCode, ExternalLink, Terminal, Cpu } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

const severityForCategory = (cat: string): { level: string; color: string } => {
  const c = cat.toLowerCase();
  if (c.includes("vulnerability")) return { level: "CRITICAL", color: "text-rose-400 border-rose-500/30" };
  if (c.includes("architecture") || c.includes("contract")) return { level: "HIGH", color: "text-orange-400 border-orange-500/30" };
  if (c.includes("memory") || c.includes("leak")) return { level: "HIGH", color: "text-orange-400 border-orange-500/30" };
  if (c.includes("silent") || c.includes("type")) return { level: "MEDIUM", color: "text-amber-400 border-amber-500/30" };
  if (c.includes("logic")) return { level: "MEDIUM", color: "text-amber-400 border-amber-500/30" };
  if (c.includes("configuration")) return { level: "LOW", color: "text-emerald-400 border-emerald-500/30" };
  return { level: "INFO", color: "text-cyan-400 border-cyan-500/30" };
};
---

<section id="opensource" class="section relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(6,182,212,0.08),transparent_60%)]"></div>
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(6,182,212,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(6,182,212,0.04) 1px,transparent 1px);background-size:60px 60px"></div>
    <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-cyan-500/10 to-transparent"></div>
    <div class="absolute top-0 right-1/4 w-px h-full bg-gradient-to-b from-transparent via-cyan-500/10 to-transparent"></div>
  </div>

  <div class="container-custom relative z-10">

    <div class="text-center mb-16 reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-slate-900/80 dark:bg-slate-900/90 border border-cyan-500/30 rounded-full text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-cyan-400 mb-6 shadow-[0_0_15px_rgba(6,182,212,0.15)]">
        <Terminal class="w-3 h-3" />
        <span class="animate-pulse">$</span>
        <span>{isId ? './laporan-resmi.sh' : './official-report.sh'}</span>
        <span class="w-1.5 h-4 bg-cyan-400/70 animate-pulse ml-0.5"></span>
      </div>

      <h2 class="text-3xl md:text-4xl font-serif font-bold leading-tight relative inline-block">
        <span class="bg-gradient-to-r from-cyan-400 via-emerald-400 to-cyan-300 bg-clip-text text-transparent">
          {isId ? 'Kontribusi Open Source' : 'Open Source Contributions'}
        </span>
        <span class="absolute -top-3 -right-4 text-[10px] font-mono text-cyan-500/40">_v1.0</span>
      </h2>

      <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto mt-3 text-[15px] leading-relaxed">
        {isId ? 'Laporan resmi penelitian bug dan kontribusi keamanan pada proyek open-source kelas dunia. Setiap temuan telah dikonfirmasi oleh maintainer resmi.' : 'Official bug research reports and security contributions to world-class open-source projects. Every finding confirmed by official maintainers.'}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-6 text-xs font-mono">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-800/50 border border-slate-700/50 text-slate-300">
          <Cpu class="w-3 h-3 text-cyan-400" />
          <span>{isId ? 'Peneliti' : 'Researcher'}: <strong class="text-cyan-300">Wisnu Alfian</strong></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-800/50 border border-slate-700/50 text-slate-300">
          <GitBranch class="w-3 h-3 text-emerald-400" />
          <span>GitHub: <strong class="text-emerald-300">wi5nuu</strong></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-800/50 border border-slate-700/50 text-slate-300">
          <Shield class="w-3 h-3 text-rose-400" />
          <span>{isId ? 'Total Temuan' : 'Findings'}: <strong class="text-rose-300">9</strong></span>
        </span>
      </div>
    </div>

    <div class="max-w-4xl mx-auto divide-y divide-slate-800/60">
      {profile.openSource.map((entry, index) => {
        const sev = severityForCategory(entry.category);
        return (
        <div
          class="group relative py-5 md:py-6 hover:bg-slate-800/20 transition-colors duration-300 reveal-up -mx-4 md:-mx-6 px-4 md:px-6 rounded-none"
          style={`transition-delay: ${index * 50}ms`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-[auto,1fr] gap-x-6 gap-y-2">

            <div class="flex items-center gap-3 lg:flex-col lg:items-start lg:w-48">
              <span class="text-[10px] font-mono font-bold text-slate-600 bg-slate-800/50 px-1.5 py-0.5 rounded border border-slate-700/50 shrink-0">
                #{(index + 1).toString().padStart(2, '0')}
              </span>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-sm font-bold text-slate-200 leading-snug">
                  {entry.organization}
                </h3>
                <span class={`text-[9px] font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border ${sev.color}`}>
                  {sev.level}
                </span>
              </div>
            </div>

            <div class="min-w-0 space-y-2">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-mono text-slate-500">
                <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-slate-800/80 text-slate-400 border border-slate-700/60">
                  {entry.category}
                </span>
                <span class="inline-flex items-center gap-1">
                  <GitBranch class="w-3 h-3 text-cyan-500/60" />
                  {entry.repo}
                </span>
                <span class="inline-flex items-center gap-1">
                  <FileCode class="w-3 h-3 text-emerald-500/60" />
                  {entry.language}
                </span>
              </div>

              <p class="text-[13px] text-slate-400">
                {entry.project}
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
                <div>
                  <h4 class="flex items-center gap-1.5 text-[10px] font-mono text-cyan-500/60 mb-1">
                    <Bug class="w-3 h-3" />
                    <span>$</span>
                    {isId ? 'bug_deskripsi.txt' : 'bug_description.txt'}
                  </h4>
                  <p class="text-[13px] text-slate-300 leading-relaxed">
                    {entry.bugDescription}
                  </p>
                </div>
                <div>
                  <h4 class="flex items-center gap-1.5 text-[10px] font-mono text-rose-500/60 mb-1">
                    <Shield class="w-3 h-3" />
                    <span>$</span>
                    {isId ? 'dampak.log' : 'impact.log'}
                  </h4>
                  <p class="text-[13px] text-slate-400 leading-relaxed">
                    {entry.impact}
                  </p>
                </div>
              </div>

              {entry.fileLocation && entry.fileLocation !== "N/A" && entry.fileLocation !== "N/A (Security Advisory)" && (
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-slate-950/60 rounded border border-slate-800/50">
                  <span class="text-[10px] font-mono text-emerald-500/60">$</span>
                  <code class="text-[11px] font-mono text-slate-500 group-hover:text-cyan-300 transition-colors duration-300">
                    cat {entry.fileLocation}
                  </code>
                  <span class="w-1 h-3 bg-emerald-400/40 animate-pulse"></span>
                </div>
              )}

              <div class="pt-2">
                <h4 class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-500/60 mb-1">
                  <ExternalLink class="w-3 h-3" />
                  <span>$</span>
                  {isId ? 'respons_maintainer.md' : 'maintainer_response.md'}
                </h4>
                <p class="text-[13px] text-slate-300 leading-relaxed">
                  {entry.maintainerResponse}
                </p>
              </div>
            </div>

          </div>
        </div>
      )})}
    </div>

    <div class="mt-14 text-center reveal-up">
      <a
        href="https://github.com/wi5nuu"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center gap-2.5 px-6 py-2.5 rounded-full text-sm font-semibold transition-all overflow-hidden"
      >
        <span class="absolute inset-0 bg-slate-900 dark:bg-white rounded-full"></span>
        <span class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-gradient-to-r from-cyan-500/20 via-emerald-500/20 to-cyan-500/20"></span>
        <span class="absolute inset-0 rounded-full border border-cyan-500/30 group-hover:border-cyan-400/50 transition-colors duration-300"></span>
        <span class="relative z-10 inline-flex items-center gap-2 text-white dark:text-slate-900 group-hover:text-cyan-300 dark:group-hover:text-cyan-600 transition-colors duration-300">
          <GitBranch class="w-4 h-4" />
          <span>{isId ? 'Lihat Profil GitHub' : 'View GitHub Profile'}</span>
          <ExternalLink class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
        </span>
      </a>
    </div>
  </div>
</section>
