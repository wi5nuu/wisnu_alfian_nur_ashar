---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Bug, Shield, GitBranch, FileCode, ExternalLink, Github } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section id="opensource" class="section">
  <div class="container-custom">

    <div class="text-center mb-10 reveal-up">
      <h2 class="inline-block relative text-sage-900 dark:text-white">
        {isId ? 'Kontribusi Open Source' : 'Open Source Contributions'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mt-2 text-sm">
        {isId ? 'Laporan resmi penelitian bug dan kontribusi keamanan pada proyek open-source kelas dunia. Setiap temuan telah dikonfirmasi oleh maintainer resmi.' : 'Official bug research reports and security contributions to world-class open-source projects. Every finding confirmed by official maintainers.'}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      {profile.openSource.map((entry, index) => {
        return (
        <div
          class="py-5 md:py-6 reveal-up"
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="flex flex-col md:flex-row md:items-start gap-3 md:gap-6">

            <div class="flex items-center gap-3 md:flex-col md:items-start md:min-w-[140px]">
              <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800 px-1.5 py-0.5 rounded shrink-0">
                #{(index + 1).toString().padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug">
                  {entry.organization}
                </h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                  {entry.project}
                </p>
              </div>
            </div>

            <div class="flex-1 min-w-0 space-y-3">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-sage-50 dark:bg-sage-900/40 text-sage-700 dark:text-sage-300">
                  {entry.category}
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono">
                  <GitBranch class="w-3 h-3" />
                  {entry.repo}
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono">
                  <FileCode class="w-3 h-3" />
                  {entry.language}
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <h4 class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                    <Bug class="w-3 h-3" />
                    {isId ? 'Deskripsi Bug' : 'Bug Description'}
                  </h4>
                  <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    {entry.bugDescription}
                  </p>
                </div>
                <div>
                  <h4 class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                    <Shield class="w-3 h-3" />
                    {isId ? 'Dampak' : 'Impact'}
                  </h4>
                  <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                    {entry.impact}
                  </p>
                </div>
              </div>

              {entry.fileLocation && entry.fileLocation !== "N/A" && entry.fileLocation !== "N/A (Security Advisory)" && (
                <div>
                  <code class="text-[11px] font-mono text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800/60 px-2.5 py-1 rounded inline-block">
                    {entry.fileLocation}
                  </code>
                </div>
              )}

              <div class="pt-1">
                <h4 class="flex items-center gap-1 text-[10px] font-semibold text-sage-600 dark:text-sage-400 uppercase tracking-wider mb-1">
                  <ExternalLink class="w-3 h-3" />
                  {isId ? 'Respons Maintainer' : 'Maintainer Response'}
                </h4>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {entry.maintainerResponse}
                </p>
              </div>
            </div>

          </div>
        </div>
      )})}
    </div>

    <div class="mt-10 text-center reveal-up">
      <a
        href="https://github.com/wi5nuu"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 dark:bg-slate-700 text-white rounded-full text-sm font-medium hover:bg-slate-800 dark:hover:bg-slate-600 transition-all shadow-md group"
      >
        <Github class="w-4 h-4" />
        <span>{isId ? 'Lihat Profil GitHub' : 'View GitHub Profile'}</span>
        <ExternalLink class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
      </a>
    </div>
  </div>
</section>
