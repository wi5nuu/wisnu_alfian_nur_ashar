---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Bug, Shield, GitBranch, FileCode, ExternalLink, Github } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const items = profile.openSource;
const totalItems = items.length;
---

<section id="opensource" class="section">
  <div class="container-custom">

    <div class="text-center mb-10 reveal-up">
      <h2 class="inline-block relative text-sage-900 dark:text-white">
        {isId ? 'Kontribusi Open Source' : 'Open Source Contributions'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-200 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mt-2 text-sm">
        {isId ? 'Laporan resmi penelitian bug dan kontribusi keamanan pada proyek open-source kelas dunia. Setiap temuan telah dikonfirmasi oleh maintainer resmi.' : 'Official bug research reports and security contributions to world-class open-source projects. Every finding confirmed by official maintainers.'}
      </p>
    </div>

    <div id="opensource-map" class="max-w-5xl mx-auto flex flex-col md:flex-row gap-6 items-start">

      <div class="md:w-32 shrink-0 w-full space-y-1.5 reveal-up">
        {items.map((entry, index) => (
          <button
            data-region-btn
            data-index={index}
            class="group cursor-pointer w-full text-center transition-all duration-200 rounded-lg px-2.5 py-2 bg-white dark:bg-slate-800/20 border border-sage-100 dark:border-slate-700/50"
          >
            <h3 class="text-[11px] font-bold text-slate-800 dark:text-slate-200 leading-tight">
              {entry.organization}
            </h3>
          </button>
        ))}
      </div>

      <div class="min-w-0 flex-1 reveal-up" style="transition-delay: 100ms">
        {items.map((entry, index) => (
          <div
            data-region-detail
            data-index={index}
            class="hidden bg-white dark:bg-slate-800/20 rounded-xl border border-sage-100 dark:border-slate-700/50 p-5 md:p-6"
          >
            <div class="flex items-start justify-between gap-4 mb-4 pb-4 border-b border-sage-100 dark:border-slate-700/50">
              <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{entry.organization}</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">{entry.project}</p>
              </div>
              <span class="shrink-0 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-sage-50 dark:bg-sage-900/40 text-sage-700 dark:text-sage-300 whitespace-nowrap">
                #{(index + 1).toString().padStart(2, '0')}
              </span>
            </div>

            <div class="flex flex-wrap gap-x-4 gap-y-1 mb-4 text-xs text-slate-500 dark:text-slate-400">
              <span class="inline-flex items-center gap-1">
                <GitBranch class="w-3 h-3" />
                {entry.repo}
              </span>
              <span class="inline-flex items-center gap-1">
                <FileCode class="w-3 h-3" />
                {entry.language}
              </span>
              <span>{entry.category}</span>
            </div>

            <div class="mb-4">
              <h4 class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                <Bug class="w-3 h-3" />
                {isId ? 'Deskripsi Bug' : 'Bug Description'}
              </h4>
              <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{entry.bugDescription}</p>
            </div>

            <div class="mb-4">
              <h4 class="flex items-center gap-1 text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                <Shield class="w-3 h-3" />
                {isId ? 'Dampak' : 'Impact'}
              </h4>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{entry.impact}</p>
            </div>

            {entry.fileLocation && entry.fileLocation !== "N/A" && entry.fileLocation !== "N/A (Security Advisory)" && (
              <div class="mb-4">
                <h4 class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                  {isId ? 'Lokasi File' : 'File Location'}
                </h4>
                <code class="text-xs font-mono text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800/60 px-2.5 py-1 rounded inline-block">{entry.fileLocation}</code>
              </div>
            )}

            <div class="pt-4 border-t border-sage-100 dark:border-slate-700/50">
              <h4 class="flex items-center gap-1 text-[10px] font-semibold text-sage-600 dark:text-sage-400 uppercase tracking-wider mb-1.5">
                <ExternalLink class="w-3 h-3" />
                {isId ? 'Respons Maintainer' : 'Maintainer Response'}
              </h4>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{entry.maintainerResponse}</p>
            </div>
          </div>
        ))}

        <div
          data-detail-empty
          class="flex flex-col items-center justify-center py-16 px-6 text-center bg-white dark:bg-slate-800/10 rounded-xl border border-dashed border-sage-200 dark:border-sage-700/50"
        >
          <Bug class="w-10 h-10 text-sage-300 dark:text-sage-600 mb-3" />
          <p class="text-sm font-medium text-slate-400 dark:text-slate-500">
            {isId ? 'Pilih dari daftar untuk melihat detail' : 'Select from the list to view details'}
          </p>
          <p class="text-xs text-slate-300 dark:text-slate-600 mt-1">
            {isId ? `${totalItems} kontribusi tersedia` : `${totalItems} contributions available`}
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10 text-center reveal-up">
      <a
        href="https://github.com/wi5nuu"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 dark:bg-slate-700 text-white rounded-full text-sm font-medium hover:bg-slate-800 dark:hover:bg-slate-600 transition-all shadow-md group"
      >
        <Github class="w-4 h-4" />
        <span>{isId ? 'Lihat Profil GitHub' : 'View GitHub Profile'}</span>
        <ExternalLink class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
      </a>
    </div>
  </div>
</section>

<script>
  (function() {
    const buttons = document.querySelectorAll('[data-region-btn]');
    const details = document.querySelectorAll('[data-region-detail]');
    const emptyState = document.querySelector('[data-detail-empty]');

    function showDetail(index) {
      buttons.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('border-sage-500', 'dark:border-sage-400', 'bg-sage-50', 'dark:bg-slate-700/50', 'shadow-sm');
          btn.classList.remove('border-sage-100', 'dark:border-slate-700/50', 'bg-white', 'dark:bg-slate-800/20');
        } else {
          btn.classList.remove('border-sage-500', 'dark:border-sage-400', 'bg-sage-50', 'dark:bg-slate-700/50', 'shadow-sm');
          btn.classList.add('border-sage-100', 'dark:border-slate-700/50', 'bg-white', 'dark:bg-slate-800/20');
        }
      });

      details.forEach((detail, i) => {
        if (i === index) {
          detail.classList.remove('hidden');
        } else {
          detail.classList.add('hidden');
        }
      });

      if (emptyState) emptyState.classList.add('hidden');
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', function() {
        showDetail(parseInt(this.dataset.index));
      });
    });

    if (buttons.length > 0) showDetail(0);
  })();
</script>
