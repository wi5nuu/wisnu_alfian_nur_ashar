---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Bug, Shield, GitBranch, FileCode, ExternalLink, Search } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

const logoSrc = (org: string) => {
  const o = org.toLowerCase();
  if (o.includes("nasa")) return "nasa";
  if (o.includes("microsoft")) return "microsoft";
  if (o.includes("nvidia")) return "nvidia";
  if (o.includes("owasp")) return "owasp";
  if (o.includes("hugging")) return "huggingface";
  if (o.includes("google") || o.includes("addyosmani")) return "google";
  if (o.includes("adk")) return "google";
  return null;
};
---

<section id="opensource" class="section">
  <div class="container-custom">

    <!-- Header -->
    <div class="text-center mb-12 reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-6">
        <Search class="w-3 h-3" />
        <span>{isId ? 'Laporan Resmi' : 'Official Report'}</span>
      </div>
      <h2 class="text-slate-900 dark:text-white text-3xl md:text-4xl font-serif font-bold leading-tight">
        {isId ? 'Kontribusi Open Source' : 'Open Source Contributions'}
      </h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto mt-3 text-[15px] leading-relaxed">
        {isId ? 'Laporan resmi penelitian bug dan kontribusi keamanan pada proyek open-source kelas dunia. Setiap temuan telah dikonfirmasi oleh maintainer resmi.' : 'Official bug research reports and security contributions to world-class open-source projects. Every finding confirmed by official maintainers.'}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 mt-5 text-xs text-slate-400 dark:text-slate-500">
        <span class="font-medium text-slate-500 dark:text-slate-400">{isId ? 'Peneliti' : 'Researcher'}: <strong class="text-slate-700 dark:text-slate-200">Wisnu Alfian Nur Ashar</strong></span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
        <span>GitHub: <strong class="text-slate-700 dark:text-slate-200">wi5nuu</strong></span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
        <span>{isId ? 'Juni 2026' : 'June 2026'}</span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
        <span class="font-semibold text-slate-600 dark:text-slate-300">9 {isId ? 'Kontribusi' : 'Contributions'}</span>
      </div>
    </div>

    <!-- Cards -->
    <div class="max-w-4xl mx-auto space-y-4">
      {profile.openSource.map((entry, index) => {
        const logo = logoSrc(entry.organization);
        return (
        <article
          class="group relative bg-white dark:bg-slate-800/60 backdrop-blur-sm border border-slate-100 dark:border-slate-700/40 rounded-2xl p-5 md:p-6 hover:shadow-lg hover:border-slate-200 dark:hover:border-slate-600/60 transition-all duration-200 shadow-sm reveal-up"
          style={`transition-delay: ${index * 50}ms`}
        >
          <!-- Top Row: Logo + Org + Category -->
          <div class="flex items-start gap-4 mb-4">
            {/* Logo */}
            <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-white dark:bg-white/10 border border-slate-100 dark:border-slate-600/40 flex items-center justify-center overflow-hidden">
              {logo ? (
                <img
                  src={`/logos/${logo}.svg`}
                  alt={`${entry.organization} logo`}
                  class="w-6 h-6 object-contain"
                  loading="lazy"
                />
              ) : (
                <GitBranch class="w-5 h-5 text-slate-400 dark:text-slate-500" />
              )}
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-0.5">
                <span class="text-[10px] font-mono font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-700/60 px-1.5 py-0.5 rounded">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
                  {entry.organization}
                </h3>
              </div>
              <p class="text-[13px] text-slate-500 dark:text-slate-400 font-medium leading-snug mt-0.5">
                {entry.project}
              </p>
            </div>

            <span class="flex-shrink-0 text-[10px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700/60 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-600/40">
              {entry.category}
            </span>
          </div>

          <!-- Meta bar -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-4 ml-14 text-[11px] text-slate-500 dark:text-slate-400 font-mono">
            <span class="inline-flex items-center gap-1">
              <GitBranch class="w-3 h-3" />
              {entry.repo}
            </span>
            <span class="inline-flex items-center gap-1">
              <FileCode class="w-3 h-3" />
              {entry.language}
            </span>
          </div>

          <!-- Body: Bug + Impact side by side -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-14 mb-4">
            <div>
              <h4 class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400 mb-1.5">
                <Bug class="w-3 h-3" />
                {isId ? 'Deskripsi Bug' : 'Bug Description'}
              </h4>
              <p class="text-[13px] text-slate-600 dark:text-slate-300 leading-relaxed">
                {entry.bugDescription}
              </p>
            </div>
            <div>
              <h4 class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400 mb-1.5">
                <Shield class="w-3 h-3" />
                {isId ? 'Dampak' : 'Impact'}
              </h4>
              <p class="text-[13px] text-slate-500 dark:text-slate-400 leading-relaxed">
                {entry.impact}
              </p>
            </div>
          </div>

          {/* File Location */}
          {entry.fileLocation && entry.fileLocation !== "N/A" && entry.fileLocation !== "N/A (Security Advisory)" && (
            <div class="ml-14 mb-4">
              <code class="inline-block px-3 py-1.5 bg-slate-50 dark:bg-slate-700/60 rounded-md text-[11px] font-mono text-slate-500 dark:text-slate-400 border border-slate-100 dark:border-slate-600/40">
                {entry.fileLocation}
              </code>
            </div>
          )}

          {/* Maintainer Response */}
          <div class="ml-14 pt-3 border-t border-slate-100 dark:border-slate-700/40">
            <h4 class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400 mb-1.5">
              <ExternalLink class="w-3 h-3" />
              {isId ? 'Respons Maintainer' : 'Maintainer Response'}
            </h4>
            <p class="text-[13px] text-slate-600 dark:text-slate-300 leading-relaxed">
              {entry.maintainerResponse}
            </p>
          </div>
        </article>
      )})}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center reveal-up">
      <a href="https://github.com/wi5nuu" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full text-sm font-semibold hover:bg-slate-800 dark:hover:bg-slate-100 transition-all shadow-md group">
        <GitBranch class="w-4 h-4" />
        <span>{isId ? 'Lihat Profil GitHub' : 'View GitHub Profile'}</span>
        <ExternalLink class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
      </a>
    </div>
  </div>
</section>
