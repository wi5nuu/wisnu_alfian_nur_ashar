---
import { profile } from "../../data/profile";
import { Award, CheckCircle } from "lucide-astro";
import ImageModal from "../ImageModal.astro";
---

<section id="certifications" class="section bg-cream-50">
  <div class="container-custom">
    <!-- SECTION TITLE -->
    <div class="text-center mb-14">
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-sage-900 mb-4 inline-block relative"
      >
        Certifications
        <span
          class="absolute -bottom-2 left-0 w-full h-1 bg-sage-300/50 rounded-full"
        ></span>
      </h2>
      <p class="text-sage-600 text-sm mt-4 max-w-xl mx-auto">
        Professional certifications that validate my technical skills and continuous learning.
      </p>
    </div>

    <!-- CERTIFICATION GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {
        profile.certifications.map((cert) => (
          <div
            class="
              bg-white
              rounded-2xl
              border border-cream-200
              shadow-sm
              hover:shadow-lg
              transition-all duration-300
              overflow-hidden
            "
          >
            <!-- IMAGE -->
            <div class="w-full aspect-[4/3] bg-cream-50 flex items-center justify-center p-4">
              {cert.image ? (
                <img
                  src={cert.image}
                  alt={cert.name}
                  class="
                    w-full h-full
                    object-contain
                    rounded-xl
                    transition-transform duration-300
                    hover:scale-105
                    cursor-pointer
                  "
                  loading="lazy"
                  onclick={`openModal('cert-modal', '${cert.image}', '${cert.name}')`}
                />
              ) : (
                <Award class="w-12 h-12 text-sage-400" />
              )}
            </div>

            <!-- CONTENT -->
            <div class="p-6 space-y-2">
              <h3 class="text-lg font-bold text-sage-800 leading-snug">
                {cert.name}
              </h3>

              <p class="text-sm font-medium text-sage-600">
                {cert.issuer}
              </p>

              <p class="text-xs text-charcoal/50">
                Issued: {cert.date} {cert.expiry ? `\u2022 Expires: ${cert.expiry}` : ""}
              </p>

              {cert.id && (
              <div class="pt-3">
                <span
                  class="
                    inline-flex items-center gap-1.5
                    text-xs font-medium
                    text-sage-700
                    bg-sage-100
                    px-3 py-1
                    rounded-full
                  "
                >
                  <CheckCircle class="w-3.5 h-3.5" />
                  Credential ID: {cert.id}
                </span>
              </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
    
  </div>
</section>
