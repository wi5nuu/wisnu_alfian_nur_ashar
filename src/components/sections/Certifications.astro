---
import { profile } from "../../data/profile";
import { Award, CheckCircle } from "lucide-astro";
import ImageModal from "../ImageModal.astro";
---

<section id="certifications" class="section bg-cream-50 pt-4 md:pt-6">
  <div class="container-custom">
    <!-- SECTION TITLE -->
    <div class="text-center mb-10">
      <h2 class="inline-block relative">
        Certifications
        <span
          class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-300/50 rounded-full"
        ></span>
      </h2>
      <p class="text-sage-600 text-sm mt-4 max-w-xl mx-auto">
        Professional certifications that validate my technical skills and continuous learning.
      </p>
    </div>

    <!-- CERTIFICATION SCROLL/FLEX -->
    <div class="w-full flex gap-6 md:gap-8 max-w-7xl mx-auto overflow-x-auto pb-10 snap-x scrollbar-hide px-4 md:px-6 scroll-pl-4">
      {
        profile.certifications.map((cert) => (
          <div
            class="
              bg-white
              rounded-2xl
              border border-cream-200
              shadow-sm
              hover:shadow-lg
              transition-all duration-300
              overflow-hidden
              min-w-[70vw] md:min-w-[300px]
              snap-start
            "
          >
            <!-- IMAGE -->
            <div class="w-full aspect-video overflow-hidden">
              {cert.image ? (
                <img
                  src={cert.image}
                  alt={cert.name}
                  class="
                    w-full h-full
                    object-cover
                    transition-transform duration-500
                    hover:scale-110
                    cursor-pointer
                  "
                  loading="lazy"
                  onclick={`openModal('cert-modal', '${cert.image}', '${cert.name}')`}
                />
              ) : (
                <div class="w-full h-full bg-sage-50 flex items-center justify-center">
                  <Award class="w-10 h-10 text-sage-300" />
                </div>
              )}
            </div>

            <!-- CONTENT -->
            <div class="p-5 space-y-2">
              <h3 class="font-bold text-sage-900 leading-tight text-sm md:text-base">
                {cert.name}
              </h3>

              <p class="text-xs font-semibold text-sage-600">
                {cert.issuer}
              </p>

              <p class="text-xs text-sage-500/80 italic leading-relaxed">
                {cert.description}
              </p>

              <div class="flex items-center justify-between pt-2">
                <p class="text-[10px] font-medium text-charcoal/40 uppercase tracking-wider">
                  Issued: {cert.date}
                </p>
                {cert.expiry && (
                   <p class="text-[10px] font-medium text-charcoal/40 uppercase tracking-wider">
                    Expires: {cert.expiry}
                  </p>
                )}
              </div>

              {cert.id && (
              <div class="pt-3">
                <span
                  class="
                    inline-flex items-center gap-1.5
                    text-xs font-medium
                    text-sage-700
                    bg-sage-100
                    px-3 py-1
                    rounded-full
                  "
                >
                  <CheckCircle class="w-3.5 h-3.5" />
                  Credential ID: {cert.id}
                </span>
              </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
    
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
