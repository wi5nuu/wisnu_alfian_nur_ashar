---
const isId = Astro.url.pathname.startsWith('/id');
const WA_NUMBER = '6281394882490';
const PAYMENT_NUMBER = '081394882490';
const PRICE = 5000;
---

<section id="donation" class="relative py-20 md:py-28 overflow-hidden bg-white dark:bg-slate-900/50">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-slate-200 dark:via-slate-600 to-transparent"></div>

  <div class="container-custom relative z-10">
    <div class="text-center mb-10">
      <span class="inline-block text-xs uppercase tracking-[0.25em] font-bold text-slate-400 dark:text-slate-500 mb-3 bg-slate-100 dark:bg-slate-800 px-4 py-1.5 rounded-full">
        {isId ? 'Dukungan' : 'Support'}
      </span>
      <h2 class="text-2xl md:text-4xl font-serif font-bold text-slate-950 dark:text-white">
        {isId ? 'Dukung Karya Saya' : 'Support My Work'}
      </h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-lg mx-auto text-sm mt-2">
        {isId ? 'Apresiasi Anda membantu saya terus berkarya dan mengembangkan solusi teknologi yang bermanfaat.' : 'Your appreciation helps me keep building and developing useful technology solutions.'}
      </p>
    </div>

    <div class="max-w-md mx-auto">
      <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-5 md:p-6 shadow-sm">

        <!-- Quantity Selector -->
        <div class="flex items-center justify-between gap-3 mb-5">
          <div class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            {isId ? 'Jumlah' : 'Quantity'}
          </div>
          <div class="flex items-center gap-3">
            <button id="btn-minus" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 text-base font-bold hover:bg-slate-200 dark:hover:bg-slate-600 active:scale-90 transition-all disabled:opacity-30 disabled:cursor-not-allowed" disabled>-</button>
            <span id="qty-display" class="w-10 text-center text-lg font-bold text-slate-950 dark:text-white tabular-nums">1</span>
            <button id="btn-plus" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 text-base font-bold hover:bg-slate-200 dark:hover:bg-slate-600 active:scale-90 transition-all">+</button>
          </div>
        </div>

        <!-- Total -->
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl px-4 py-3 mb-5 text-center">
          <span class="text-[10px] text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider">{isId ? 'Total' : 'Total'}</span>
          <div id="total-display" class="text-xl font-bold text-slate-950 dark:text-white">Rp5.000</div>
          <div class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">
            Rp5.000 &times; <span id="qty-label">1</span>
          </div>
        </div>

        <!-- Payment Methods -->
        <div class="space-y-2.5">
          <p class="text-[10px] text-slate-400 dark:text-slate-500 uppercase font-bold text-center tracking-wider">{isId ? 'Metode Pembayaran' : 'Payment Method'}</p>

          <button id="btn-gopay" class="w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 hover:border-emerald-400 dark:hover:border-emerald-500 active:scale-[0.98] transition-all cursor-pointer">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800/50 flex items-center justify-center">
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">G</span>
              </div>
              <div class="text-left">
                <span class="block text-sm font-bold text-slate-900 dark:text-white">GoPay</span>
                <span class="block text-[10px] text-slate-400 dark:text-slate-500 font-mono">{PAYMENT_NUMBER}</span>
              </div>
            </div>
            <span class="text-xs text-slate-300 dark:text-slate-600 font-bold">&rarr;</span>
          </button>

          <button id="btn-dana" class="w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 hover:border-blue-400 dark:hover:border-blue-500 active:scale-[0.98] transition-all cursor-pointer">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800/50 flex items-center justify-center">
                <span class="text-xs font-bold text-blue-600 dark:text-blue-400">D</span>
              </div>
              <div class="text-left">
                <span class="block text-sm font-bold text-slate-900 dark:text-white">DANA</span>
                <span class="block text-[10px] text-slate-400 dark:text-slate-500 font-mono">{PAYMENT_NUMBER}</span>
              </div>
            </div>
            <span class="text-xs text-slate-300 dark:text-slate-600 font-bold">&rarr;</span>
          </button>
        </div>

        <!-- Payment Info Panel -->
        <div id="panel-number" class="mt-4 p-4 bg-emerald-50 dark:bg-emerald-900/20 border-2 border-emerald-200 dark:border-emerald-800/50 rounded-xl text-center" style="display:none">
          <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1">{isId ? 'Kirim ke' : 'Send to'}</p>
          <p id="number-text" class="text-2xl font-bold text-slate-950 dark:text-white font-mono tracking-wider">{PAYMENT_NUMBER}</p>
          <p id="method-label" class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5 font-medium"></p>
          <div class="flex items-center justify-center gap-2 mt-3">
            <button id="btn-copy" class="px-4 py-2 rounded-lg bg-white dark:bg-slate-700 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400 text-xs font-bold hover:bg-emerald-100 dark:hover:bg-emerald-900/30 active:scale-95 transition-all cursor-pointer flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
              <span>{isId ? 'Salin' : 'Copy'}</span>
            </button>
            <button id="btn-open-app" class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              <span id="open-text">{isId ? 'Buka Aplikasi' : 'Open App'}</span>
            </button>
          </div>
        </div>

        <!-- Confirmation Form -->
        <div id="panel-form" class="mt-4" style="display:none">
          <div class="bg-white dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl p-4">
            <h3 class="text-sm font-bold text-slate-950 dark:text-white mb-3">{isId ? 'Konfirmasi via WhatsApp' : 'Confirm via WhatsApp'}</h3>
            <div class="space-y-3">
              <input id="input-name" type="text" maxlength="50" placeholder={isId ? 'Nama kamu' : 'Your name'} class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-slate-950 dark:focus:border-white placeholder:text-slate-300 dark:placeholder:text-slate-500 transition-all" />
              <input id="input-message" type="text" maxlength="100" placeholder={isId ? 'Pesan (opsional)' : 'Message (optional)'} class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-slate-950 dark:focus:border-white placeholder:text-slate-300 dark:placeholder:text-slate-500 transition-all" />
              <button id="btn-send" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] transition-all cursor-pointer disabled:opacity-50 text-white text-sm font-bold flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <span>{isId ? 'Konfirmasi via WhatsApp' : 'Confirm via WhatsApp'}</span>
              </button>
              <button id="btn-cancel" class="w-full text-xs text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-colors cursor-pointer">
                &larr; {isId ? 'Kembali' : 'Back'}
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    var PRICE = 5000;
    var WA = '6281394882490';
    var NUMBER = '081394882490';
    var qty = 1;
    var selected = '';
    var appUrl = '';
    var sending = false;

    var $ = function(id) { return document.getElementById(id); };

    function show(id) { $(id).style.display = ''; }
    function hide(id) { $(id).style.display = 'none'; }

    function updateTotal() {
      $('qty-display').textContent = qty;
      $('qty-label').textContent = qty;
      $('total-display').textContent = 'Rp' + (qty * PRICE).toLocaleString('id-ID');
      $('btn-minus').disabled = qty <= 1;
    }

    function selectPay(method) {
      selected = method;
      var isId = location.pathname.startsWith('/id');
      var label = method === 'gopay' ? 'GoPay' : 'DANA';
      appUrl = method === 'gopay' ? 'gopay://' : 'dana://';

      $('method-label').textContent = 'via ' + label;
      $('open-text').textContent = isId ? 'Buka ' + label : 'Open ' + label;

      ['btn-gopay','btn-dana'].forEach(function(id) {
        $(id).className = $(id).className.replace(/(border-emerald-400|border-blue-400|dark:border-emerald-500|dark:border-blue-500)/g, '') + (id === 'btn-' + method ? ' ' + (method === 'gopay' ? 'border-emerald-400 dark:border-emerald-500' : 'border-blue-400 dark:border-blue-500') : ' border-slate-200 dark:border-slate-600');
      });

      navigator.clipboard.writeText(NUMBER).catch(function(){});

      show('panel-number');
      show('panel-form');
      hide('btn-send');
      $('input-name').focus();
    }

    $('btn-minus').onclick = function() { if (qty > 1) { qty--; updateTotal(); } };
    $('btn-plus').onclick = function() { if (qty < 99) { qty++; updateTotal(); } };

    $('btn-gopay').onclick = function() { selectPay('gopay'); };
    $('btn-dana').onclick = function() { selectPay('dana'); };

    $('btn-open-app').onclick = function() {
      if (appUrl) { navigator.clipboard.writeText(NUMBER); window.open(appUrl, '_blank'); }
    };

    $('btn-copy').onclick = function() {
      navigator.clipboard.writeText(NUMBER).then(function() {
        $('btn-copy').innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>' + (location.pathname.startsWith('/id') ? 'Tersalin!' : 'Copied!') + '</span>';
        setTimeout(function() {
          $('btn-copy').innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg><span>' + (location.pathname.startsWith('/id') ? 'Salin' : 'Copy') + '</span>';
        }, 2000);
      }).catch(function(){});
    };

    $('btn-cancel').onclick = function() {
      hide('panel-number'); hide('panel-form');
      selected = ''; appUrl = '';
      $('open-text').textContent = location.pathname.startsWith('/id') ? 'Buka Aplikasi' : 'Open App';
      ['btn-gopay','btn-dana'].forEach(function(id) {
        $(id).className = $(id).className.replace(/(border-emerald-400|border-blue-400|dark:border-emerald-500|dark:border-blue-500)/g, '');
      });
      $('input-name').value = '';
      $('input-message').value = '';
      $('btn-send').style.display = '';
    };

    $('btn-send').onclick = function() {
      if (sending) return;
      var name = $('input-name').value.trim();
      if (!name) { $('input-name').className = $('input-name').className.replace('border-red-400', '') + ' border-red-400'; $('input-name').focus(); return; }
      $('input-name').className = $('input-name').className.replace('border-red-400', '');

      var msg = location.pathname.startsWith('/id')
        ? 'Assalamualaikum Kak Wisnu%0A%0ASaya *' + name + '* ingin konfirmasi pembayaran:%0A%0A*' + qty + ' Item*%0A*Rp' + (qty * PRICE).toLocaleString('id-ID') + '*%0A*' + (selected === 'gopay' ? 'GoPay' : 'DANA') + '*%0A*' + NUMBER + '*%0A%0ASudah saya transfer, mohon dicek Kak. Terima kasih!'
        : 'Hello Kak Wisnu%0A%0AMy name is *' + name + '*, I\'d like to confirm my payment:%0A%0A*' + qty + ' Item(s)*%0A*Rp' + (qty * PRICE).toLocaleString('id-ID') + '*%0A*' + (selected === 'gopay' ? 'GoPay' : 'DANA') + '*%0A*' + NUMBER + '*%0A%0AI have made the transfer, please check. Thank you!';

      window.open('https://wa.me/' + WA + '?text=' + msg, '_blank');
      hide('panel-number'); hide('panel-form');
      qty = 1; selected = ''; appUrl = ''; updateTotal();
      $('input-name').value = ''; $('input-message').value = '';
    };

    $('input-name').oninput = function() { $('input-name').className = $('input-name').className.replace('border-red-400', ''); };
    updateTotal();
  })();
</script>