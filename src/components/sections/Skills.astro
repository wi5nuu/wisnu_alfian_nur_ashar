---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

const skillCategories = [
  { title: isId ? 'Pemrograman & Basis Data' : 'Programming & Databases', skills: profile.skills.programming },
  { title: isId ? 'Teknologi Web' : 'Web Technologies', skills: profile.skills.webTech },
  { title: isId ? 'AI & Machine Learning' : 'AI & Machine Learning', skills: profile.skills.aiMl },
  { title: isId ? 'Keamanan & Infrastruktur' : 'Security & Infrastructure', skills: profile.skills.securityCloud },
  { title: isId ? 'Alat Khusus' : 'Specialized Tools', skills: profile.skills.tools },
  { title: isId ? 'Keterampilan Non-Teknis' : 'Soft Skills', skills: profile.skills.soft },
];
---

<section id="skills" class="section">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h2 class="inline-block relative text-sage-900 dark:text-white">
        {isId ? 'Keahlian' : 'Skills & Expertise'}
        <span class="absolute -bottom-1.5 left-0 w-full h-1 bg-sage-300/50 dark:bg-sage-500/50 rounded-full"></span>
      </h2>
      <p class="text-charcoal/70 dark:text-slate-400 max-w-2xl mx-auto mt-4 text-sm">
        {isId ? 'Perangkat lengkap saya untuk pengembangan web modern dan kepemimpinan digital.' : 'A comprehensive toolkit for modern web development and digital leadership.'}
      </p>
    </div>

    <!-- ========== MOBILE: Simple List Layout ========== -->
    <div class="md:hidden px-4 space-y-8">
      {skillCategories.map((category) => (
        <div>
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-4">
            {category.title}
          </h3>
          <div class="grid grid-cols-2 gap-3">
            {category.skills.map((skill) => (
              <span class="text-[13px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2">
                {skill.icon ? (
                  <img
                    src={`https://cdn.simpleicons.org/${skill.icon}`}
                    alt=""
                    loading="lazy"
                    class="w-4 h-4 shrink-0 dark:brightness-90"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                  />
                ) : null}
                <span class="w-1.5 h-1.5 bg-sage-400 rounded-full shrink-0" style={skill.icon ? 'display:none' : ''} />
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ========== DESKTOP: Grid Layout ========== -->
    <div class="hidden md:block max-w-6xl mx-auto">

      <!-- Row 1: 5 Technical Categories -->
      <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6 lg:gap-8 mb-10">

        <!-- Programming & Databases -->
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-3 truncate">
            {isId ? 'Pemrograman & Basis Data' : 'Programming & Databases'}
          </h3>
          <ul class="space-y-1.5">
            {profile.skills.programming.map((skill) => (
              <li class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2 hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default">
                {skill.icon ? (
                  <img src={`https://cdn.simpleicons.org/${skill.icon}`} alt="" loading="lazy" class="w-3.5 h-3.5 shrink-0 dark:brightness-90" />
                ) : (
                  <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
                )}
                <span class="truncate">{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Web Technologies -->
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-3 truncate">
            {isId ? 'Teknologi Web' : 'Web Technologies'}
          </h3>
          <ul class="space-y-1.5">
            {profile.skills.webTech.map((skill) => (
              <li class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2 hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default">
                {skill.icon ? (
                  <img src={`https://cdn.simpleicons.org/${skill.icon}`} alt="" loading="lazy" class="w-3.5 h-3.5 shrink-0 dark:brightness-90" />
                ) : (
                  <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
                )}
                <span class="truncate">{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- AI & Machine Learning -->
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-3 truncate">
            {isId ? 'AI & ML' : 'AI & Machine Learning'}
          </h3>
          <ul class="space-y-1.5">
            {profile.skills.aiMl.map((skill) => (
              <li class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2 hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default">
                {skill.icon ? (
                  <img src={`https://cdn.simpleicons.org/${skill.icon}`} alt="" loading="lazy" class="w-3.5 h-3.5 shrink-0 dark:brightness-90" />
                ) : (
                  <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
                )}
                <span class="truncate">{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Security & Infrastructure -->
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-3 truncate">
            {isId ? 'Keamanan & Infra' : 'Security & Infra'}
          </h3>
          <ul class="space-y-1.5">
            {profile.skills.securityCloud.map((skill) => (
              <li class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2 hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default">
                {skill.icon ? (
                  <img src={`https://cdn.simpleicons.org/${skill.icon}`} alt="" loading="lazy" class="w-3.5 h-3.5 shrink-0 dark:brightness-90" />
                ) : (
                  <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
                )}
                <span class="truncate">{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Specialized Tools -->
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest border-b border-sage-100 dark:border-slate-700/50 pb-2.5 mb-3 truncate">
            {isId ? 'Alat Khusus' : 'Specialized Tools'}
          </h3>
          <ul class="space-y-1.5">
            {profile.skills.tools.map((skill) => (
              <li class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium flex items-center gap-2 hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default">
                {skill.icon ? (
                  <img src={`https://cdn.simpleicons.org/${skill.icon}`} alt="" loading="lazy" class="w-3.5 h-3.5 shrink-0 dark:brightness-90" />
                ) : (
                  <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
                )}
                <span class="truncate">{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- Row 2: Soft Skills -->
      <div class="pt-6 border-t border-cream-200 dark:border-transparent">
        <h3 class="text-xs font-bold text-sage-900 dark:text-sage-300 uppercase tracking-widest text-center mb-4">
          {isId ? 'Keterampilan Non-Teknis' : 'Soft Skills'}
        </h3>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {profile.skills.soft.map((skill) => (
            <span class="text-[12px] text-charcoal/80 dark:text-slate-300 font-medium hover:text-sage-700 dark:hover:text-sage-400 transition-colors cursor-default flex items-center gap-2">
              <span class="w-1 h-1 bg-sage-400 rounded-full shrink-0" />
              {skill.name}
            </span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  (function() {
    const section = document.getElementById("skills");
    if (!section || window.innerWidth >= 768) return;
    let touchStartY = 0;
    let touchStartX = 0;
    let isSwiping = false;
    section.addEventListener("touchstart", function(e) {
      touchStartY = e.touches[0].clientY;
      touchStartX = e.touches[0].clientX;
      isSwiping = true;
    }, { passive: true });
    section.addEventListener("touchend", function(e) {
      if (!isSwiping) return;
      isSwiping = false;
      const touchEndY = e.changedTouches[0].clientY;
      const touchEndX = e.changedTouches[0].clientX;
      const deltaY = touchStartY - touchEndY;
      const deltaX = Math.abs(touchStartX - touchEndX);
      if (Math.abs(deltaY) > 80 && Math.abs(deltaY) > deltaX) {
        if (deltaY > 0) {
          const nextSection = section.nextElementSibling;
          if (nextSection) nextSection.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (deltaY < 0) {
          const prevSection = section.previousElementSibling;
          if (prevSection) prevSection.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }
    }, { passive: true });
  })();
</script>
