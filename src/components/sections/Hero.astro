---
import { profile as profileEn } from "../../data/profile";
import { profile as profileId } from "../../data/profile_id";
import { Download } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
const contactUrl = isId ? '/id/contact' : '/contact';
---

<section
  id="hero"
  class="relative h-auto pb-24 md:pb-0 md:min-h-screen flex items-center justify-center overflow-hidden bg-sage-900 dark:bg-transparent transition-colors duration-300"
>
  <div class="absolute inset-0 z-0 h-full w-full bg-gradient-to-br from-sage-900 via-slate-900 to-sage-800 dark:hidden">
    <div class="absolute inset-0 h-full w-full bg-[radial-gradient(ellipse_at_top_right,_rgba(255,255,255,0.06)_0%,_transparent_60%)]"></div>
  </div>

  <div
    class="container-custom relative z-10 flex flex-col items-center text-center text-white pt-28 md:pt-12"
  >
    <!-- Text Content (left on desktop) -->
    <div class="flex-1 flex flex-col items-center">
      <div
        class="inline-block mb-4 px-4 py-1.5 bg-white/10 backdrop-blur-md text-sage-50 border border-white/20 dark:border-transparent rounded-full text-sm font-medium tracking-wide animate-fade-in-up"
      >
        Hello, I'm
      </div>

      <h1
        class="text-3xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-4 tracking-tight animate-fade-in-up delay-100 drop-shadow-lg"
      >
        Wisnu Alfian Nur Ashar
      </h1>

      <p
        class="text-base md:text-lg text-sage-100 max-w-xl mb-8 leading-snug animate-fade-in-up delay-200 drop-shadow-md font-light"
      >
        {profile.personalInfo.role}
        <br class="hidden md:block" />
        {profile.personalInfo.tagline}
      </p>

      <div
        class="w-full flex flex-row flex-wrap justify-center gap-2 md:gap-5 animate-fade-in-up delay-300"
      >
        <a
          href="/CV_Wisnu_Alfian_Nur_Ashar.pdf"
          download
          class="btn border border-white/30 dark:border-transparent text-white hover:bg-white/10 backdrop-blur-sm px-4 md:px-6 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-medium transition-all duration-300 flex items-center justify-center gap-2"
        >
          <Download class="w-3.5 h-3.5" />
          {isId ? 'Unduh CV (PDF)' : 'Download CV (PDF)'}
        </a>
        <a
          href={contactUrl}
          class="btn border border-transparent bg-white/10 text-white hover:bg-white/20 backdrop-blur-sm px-5 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-medium transition-all duration-300 dark:border-transparent"
        >
          {isId ? 'Hubungi Saya' : 'Contact Me'}
        </a>
      </div>

      <!-- Stats strip -->
      <div class="flex flex-row items-center justify-between w-full max-w-xl mt-10 animate-fade-in-up delay-300 border-t border-white/10 dark:border-transparent pt-8 px-2 sm:px-8">
        <div class="text-center flex-1">
          <div class="text-xl md:text-2xl font-bold stat-number text-white">8+</div>
          <div class="text-[8px] md:text-[10px] uppercase tracking-widest text-white/75 font-medium mt-0.5">{isId ? 'Aplikasi Produksi' : 'Production Apps'}</div>
        </div>
        <div class="w-px h-8 bg-white/10 dark:bg-transparent flex-shrink-0"></div>
        <div class="text-center flex-1">
          <div class="text-xl md:text-2xl font-bold stat-number text-white">15K+</div>
          <div class="text-[8px] md:text-[10px] uppercase tracking-widest text-white/75 font-medium mt-0.5">{isId ? 'Pengguna Dilayani' : 'Users Served'}</div>
        </div>
        <div class="w-px h-8 bg-white/10 dark:bg-transparent flex-shrink-0"></div>
        <div class="text-center flex-1">
          <div class="text-xl md:text-2xl font-bold stat-number text-white">30+</div>
          <div class="text-[8px] md:text-[10px] uppercase tracking-widest text-white/75 font-medium mt-0.5">{isId ? 'Repositori GitHub' : 'GitHub Repos'}</div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  .delay-100 {
    animation-delay: 0.15s;
  }
  .delay-200 {
    animation-delay: 0.3s;
  }
  .delay-300 {
    animation-delay: 0.45s;
  }

  .stat-number {
    font-family: 'Calibri', 'Trebuchet MS', 'Gill Sans', Arial, sans-serif;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
