---
import { profile } from "../../data/profile";
import { ChevronDown, ArrowRight, Download } from "lucide-astro";

// Placeholder images - high quality unsplash images matching the vibe
const slides = [
  {
    image:
      "https://images.unsplash.com/photo-1497215728101-856f4ea42174?q=80&w=2070&auto=format&fit=crop",
    alt: "Minimalist workspace",
  },
  {
    image:
      "https://images.unsplash.com/photo-1555099962-4199c345e5dd?q=80&w=2070&auto=format&fit=crop",
    alt: "Coding environment",
  },
  {
    image:
      "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=2055&auto=format&fit=crop",
    alt: "Modern design aesthetic",
  },
];
---

<section
  id="hero"
  class="relative min-h-screen flex items-start md:items-center justify-center overflow-hidden bg-sage-900 dark:bg-dark-bg transition-colors duration-300"
>
  <div class="absolute inset-0 z-0">
    {
      slides.map((slide, index) => (
        <div
          class={`absolute inset-0 bg-cover bg-center transition-opacity duration-1000 ease-in-out slider-image ${index === 0 ? "opacity-40" : "opacity-0"}`}
          style={`background-image: url('${slide.image}')`}
          data-index={index}
        />
      ))
    }
    <div class="absolute inset-0 bg-sage-900/70"></div>
  </div>

  <div
    class="container-custom relative z-10 flex flex-col items-center text-center text-white pt-24 md:pt-12"
  >
    <div
      class="inline-block mb-4 px-4 py-1.5 bg-white/10 backdrop-blur-md text-sage-50 border border-white/20 rounded-full text-sm font-medium tracking-wide animate-fade-in-up"
    >
      Hello, I'm
    </div>

    <h1
      class="text-3xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-4 tracking-tight animate-fade-in-up delay-100 drop-shadow-lg min-h-[1.2em]"
    >
      <span id="typewriter-text"></span><span class="animate-blink">|</span>
    </h1>

    <p
      class="text-base md:text-lg text-sage-100 max-w-xl mb-8 leading-snug animate-fade-in-up delay-200 drop-shadow-md font-light"
    >
      {profile.personalInfo.role}
      <br class="hidden md:block" />
      {profile.personalInfo.tagline}
    </p>

    <div
      class="w-full flex flex-row flex-wrap justify-center gap-2 md:gap-5 animate-fade-in-up delay-300"
    >
      <a
        href="/CV-Wisnu Alfian Nur Ashar.pdf"
        download
        class="btn border border-white/30 text-white hover:bg-white/10 backdrop-blur-sm px-4 md:px-6 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-medium transition-all duration-300 flex items-center justify-center gap-2"
      >
        <Download class="w-3.5 h-3.5" />
        Download CV (PDF)
      </a>
      <a
        href="/contact"
        class="btn border border-transparent bg-white/10 text-white hover:bg-white/20 backdrop-blur-sm px-5 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-medium transition-all duration-300"
      >
        Contact Me
      </a>
    </div>

    <!-- Stats strip -->
    <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10 mt-10 animate-fade-in-up delay-300 border-t border-white/10 pt-8 w-full max-w-xl">
      <div class="text-center">
        <div class="text-2xl font-bold stat-number text-white">8+</div>
        <div class="text-[10px] uppercase tracking-widest text-white/50 font-medium mt-0.5">Production Apps</div>
      </div>
      <div class="w-px h-8 bg-white/10 hidden md:block"></div>
      <div class="text-center">
        <div class="text-2xl font-bold stat-number text-white">15K+</div>
        <div class="text-[10px] uppercase tracking-widest text-white/50 font-medium mt-0.5">Users Served</div>
      </div>
      <div class="w-px h-8 bg-white/10 hidden md:block"></div>
      <div class="text-center">
        <div class="text-2xl font-bold stat-number text-white">30+</div>
        <div class="text-[10px] uppercase tracking-widest text-white/50 font-medium mt-0.5">GitHub Repos</div>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white/50 animate-bounce hidden md:block"
  >
    <ChevronDown class="w-8 h-8" />
  </div>
</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 1s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  .delay-100 {
    animation-delay: 0.2s;
  }
  .delay-200 {
    animation-delay: 0.4s;
  }
  .delay-300 {
    animation-delay: 0.6s;
  }

  .animate-blink {
    animation: blink 1s step-end infinite;
  }

  .stat-number {
    font-family: 'Calibri', 'Trebuchet MS', 'Gill Sans', Arial, sans-serif;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  // --- SLIDER LOGIC ---
  const images = document.querySelectorAll(".slider-image");
  let currentIndex = 0;
  const totalSlides = images.length;

  function nextSlide() {
    if (images.length === 0) return;

    if (images[currentIndex]) {
      images[currentIndex].classList.remove("opacity-100");
      images[currentIndex].classList.add("opacity-0");
    }

    currentIndex = (currentIndex + 1) % totalSlides;

    if (images[currentIndex]) {
      images[currentIndex].classList.remove("opacity-0");
      images[currentIndex].classList.add("opacity-100");
    }
  }

  if (totalSlides > 1) {
    setInterval(nextSlide, 6000);
  }

  // --- TYPEWRITER LOGIC ---
  const text = "Wisnu Alfian Nur Ashar";
  const typeDelay = 100;
  const eraseDelay = 50;
  const newTextDelay = 2000;

  const textElement = document.getElementById("typewriter-text");
  const glowElement = document.getElementById("typewriter-text-glow");

  let charIndex = 0;
  let isDeleting = false;

  function type() {
    if (!textElement) return;

    // --- LOGIKA UTAMA (Tanpa Fungsi Pembantu yang bikin error) ---

    if (!isDeleting && charIndex < text.length) {
      // 1. SEDANG MENGETIK
      const currentText = text.substring(0, charIndex + 1);

      // Update Text Langsung di sini
      textElement.textContent = currentText;
      if (glowElement) glowElement.textContent = currentText;

      charIndex++;
      setTimeout(type, typeDelay);
    } else if (isDeleting && charIndex > 0) {
      // 2. SEDANG MENGHAPUS
      const currentText = text.substring(0, charIndex - 1);

      // Update Text Langsung di sini
      textElement.textContent = currentText;
      if (glowElement) glowElement.textContent = currentText;

      charIndex--;
      setTimeout(type, eraseDelay);
    } else {
      // 3. GANTI MODE (Ngetik <-> Hapus)
      isDeleting = !isDeleting;
      if (!isDeleting) {
        setTimeout(type, 500);
      } else {
        setTimeout(type, newTextDelay);
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(type, 500);
  });
</script>
