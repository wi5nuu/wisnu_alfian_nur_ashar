---
const isId = Astro.url.pathname.startsWith('/id');
---

<section class="stats-section">
  <div class="container">
    <!-- STAT 1 -->
    <div class="stat-item">
      <div class="stat-number">10+</div>
      <div class="stat-divider"></div>
      <div class="stat-label">{isId ? 'Aplikasi Produksi' : 'Production Apps'}</div>
      <p class="stat-desc">
        {isId 
          ? 'Menghadirkan aplikasi tingkat perusahaan dan produksi yang dapat diskalakan.' 
          : 'Delivering scalable enterprise and production applications.'}
      </p>
    </div>

    <!-- STAT 2 -->
    <div class="stat-item">
      <div class="stat-number">15K+</div>
      <div class="stat-divider"></div>
      <div class="stat-label">{isId ? 'Pengguna Dilayani' : 'Users Served'}</div>
      <p class="stat-desc">
        {isId 
          ? 'Memberikan dampak kepada ribuan pengguna dengan platform berperforma tinggi.' 
          : 'Impacting thousands of users with high-performance platforms.'}
      </p>
    </div>

    <!-- STAT 3 -->
    <div class="stat-item">
      <div class="stat-number">92+</div>
      <div class="stat-divider"></div>
      <div class="stat-label">{isId ? 'Repositori GitHub' : 'GitHub Repos'}</div>
      <p class="stat-desc">
        {isId 
          ? 'Kontributor aktif dengan 1.500+ kontribusi di proyek open-source dan pribadi.' 
          : 'Active contributor with 1,500+ contributions across open-source and personal projects.'}
      </p>
    </div>

    <!-- STAT 4 -->
    <div class="stat-item">
      <div class="stat-number">7+</div>
      <div class="stat-divider"></div>
      <div class="stat-label">{isId ? 'Organisasi Open-Source' : 'Open-Source Orgs'}</div>
      <p class="stat-desc">
        {isId 
          ? 'Kontributor aktif di NASA, Microsoft, Google, NVIDIA, OWASP, Hugging Face, dan ADK.' 
          : 'Active contributor to NASA, Microsoft, Google, NVIDIA, OWASP, Hugging Face & ADK.'}
      </p>
    </div>
  </div>
</section>

<style>
  .stats-section {
    background: linear-gradient(180deg, #84E10C 0%, #B4F461 100%);
    padding-block: 70px 80px;
    color: #0A0A0A;
    font-family: var(--font-sans);
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 3vw, 48px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stat-number {
    font-size: clamp(40px, 3.6vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #0A0A0A;
    line-height: 1;
  }

  .stat-divider {
    border-bottom: 1px solid #0A0A0A;
    margin-top: 16px;
  }

  .stat-label {
    margin-top: 20px;
    font-size: 16px;
    font-weight: 500;
    color: #0A0A0A;
  }

  .stat-desc {
    margin-top: 6px;
    margin-bottom: 0;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.75);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .container {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .stats-section {
      padding-block: 56px;
    }
    .container {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 480px) {
    .container {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .stat-number {
      font-size: clamp(28px, 7vw, 40px);
    }
  }
</style>
