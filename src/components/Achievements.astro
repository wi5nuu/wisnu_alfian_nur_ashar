---
import { Trophy } from "lucide-astro";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section class="achievements-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'PENGHARGAAN' : 'ACHIEVEMENTS'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Pencapaian Kompetisi' : 'Competition Achievements'}
    </h2>

    <div class="achievements-list">
      {profile.competitions.map((achievement) => (
        <div class="achievement-item">
          <div class="ach-icon-wrap">
            <Trophy class="ach-icon" />
          </div>
          <div class="ach-content">
            <h3 class="ach-title">{achievement.name}</h3>
            <div class="ach-meta">
              <span class="ach-issuer">{achievement.issuer}</span>
              <span class="dot-sep">•</span>
              <span class="ach-date">{achievement.date}</span>
            </div>
            <p class="ach-desc">{achievement.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
  }

  .achievements-list {
    margin-top: 48px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .achievement-item {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    transition: border-color 0.3s ease;
  }

  .achievement-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .ach-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ach-icon {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }

  .ach-content {
    display: flex;
    flex-direction: column;
  }

  .ach-title {
    font-size: 20px;
    font-weight: 500;
    margin: 0;
    color: #ffffff;
  }

  .ach-meta {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
  }

  .ach-issuer {
    font-weight: 500;
    color: var(--accent);
  }

  .dot-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .ach-date {
    color: rgba(255, 255, 255, 0.4);
  }

  .ach-desc {
    margin-top: 12px;
    margin-bottom: 0;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .achievements-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .achievements-section {
      padding-block: 72px;
    }
    .heading {
      font-size: 28px;
    }
    .achievements-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .achievement-item {
      padding: 12px;
      gap: 8px;
      border-radius: 12px;
    }
    .ach-icon-wrap {
      width: 36px;
      height: 36px;
    }
    .ach-icon {
      width: 15px;
      height: 15px;
    }
    .ach-title {
      font-size: 15px;
    }
    .ach-meta {
      margin-top: 4px;
      font-size: 11px;
      gap: 5px;
    }
    .ach-desc {
      margin-top: 6px;
      font-size: 11.5px;
      line-height: 1.5;
    }
  }
</style>
