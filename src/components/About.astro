---
import { Github, Linkedin, Instagram } from "lucide-astro";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section class="about-section">
  <div class="container">
    <!-- LEFT: HEADING -->
    <div class="heading-col">
      <div class="badge">
        <div class="badge-dot"></div>
        <span class="badge-text">{isId ? 'TENTANG SAYA' : 'ABOUT ME'}</span>
      </div>

      <h2 class="heading">
        {isId ? 'Temukan Perjalanan' : 'Discover My'}<br />
        Engineering<br />
        {isId ? 'Saya' : 'Journey'}
      </h2>
    </div>

    <!-- CENTER: BIO -->
    <div class="bio-col">
      <h3 class="name">{profile.personalInfo.name}</h3>
      <p class="bio">
        {profile.personalInfo.summary || (isId ? "Halo! Saya Wisnu, seorang Full-Stack Engineer yang antusias dengan pengalaman menciptakan aplikasi yang menarik secara visual dan berkinerja tinggi. Misi saya adalah menghidupkan brand Anda melalui solusi inovatif yang disesuaikan dengan kebutuhan unik Anda." : "Hello! I'm Wisnu, a passionate Full-Stack Engineer with experience in creating visually appealing and high-performing applications. My mission is to bring your brand to life through innovative solutions tailored to your unique needs.")}
      </p>

      <div class="social-row">
        <a href={profile.personalInfo.github || '#'} target="_blank" rel="noopener noreferrer" aria-label={isId ? "Profil GitHub" : "GitHub profile"} class="social-circle">
          <Github class="social-icon" aria-hidden="true" />
        </a>
        <a href={profile.personalInfo.linkedin || '#'} target="_blank" rel="noopener noreferrer" aria-label={isId ? "Profil LinkedIn" : "LinkedIn profile"} class="social-circle">
          <Linkedin class="social-icon" aria-hidden="true" />
        </a>
        <a href={profile.personalInfo.instagram || '#'} target="_blank" rel="noopener noreferrer" aria-label={isId ? "Profil Instagram" : "Instagram profile"} class="social-circle">
          <Instagram class="social-icon" aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- RIGHT: PHOTO -->
    <div class="photo-wrap">
      <img src="/wisnu-alfian.webp" alt={profile.personalInfo.name} width="330" height="400" class="about-photo" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: #ffffff;
    color: #0A0A0A;
    padding-block: 88px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  .container {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  /* LEFT: HEADING */
  .heading-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #ffffff;
    border: 1px solid #9A9A9A;
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: #0A0A0A;
  }

  .heading {
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
    color: #0A0A0A;
  }

  /* CENTER: PHOTO */
  .photo-wrap {
    display: flex;
    justify-content: center;
  }

  .about-photo {
    width: 100%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* RIGHT: BIO */
  .bio-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .name {
    font-size: 32px;
    font-weight: 600;
    color: #0A0A0A;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .bio {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: #3F3F3F;
  }

  .social-row {
    margin-top: 28px;
    display: flex;
    gap: 14px;
  }

  .social-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #0A0A0A;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .social-icon {
    width: 18px;
    height: 18px;
    color: #ffffff;
    transition: color 0.3s ease;
  }

  .social-circle:hover {
    background-color: var(--accent);
  }

  .social-circle:hover .social-icon {
    color: #0A0A0A;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .heading-col {
      order: 2;
      align-items: flex-start;
    }

    .photo-wrap {
      order: 1;
      justify-content: center;
    }

    .bio-col {
      order: 3;
      align-items: flex-start;
    }

    .about-photo {
      max-width: 240px;
    }
  }

  @media (max-width: 480px) {
    .about-section {
      padding-block: 48px;
    }

    .heading {
      font-size: 36px;
    }
  }
</style>
