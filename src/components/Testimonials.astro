---
import { Quote } from 'lucide-astro';

const isId = Astro.url.pathname.startsWith('/id');

const testimonials = isId
  ? [
      {
        quote: 'Wisnu adalah full-stack developer yang sangat jarang ditemukan. Dia mengubah aplikasi internal kami menjadi platform enterprise yang cepat dan aman. Komunikasi dan eksekusinya luar biasa.',
        name: 'Project Manager',
        role: 'Finance SaaS',
        company: 'Zentic',
      },
      {
        quote: 'Kolaborasi dengan Wisnu menghasilkan aplikasi e-commerce yang melayani ribuan pelanggan tanpa kendala. Perhatiannya terhadap detail dan performa sangat mengesankan.',
        name: 'Business Owner',
        role: 'Wholesale Perfume',
        company: 'Ashar Grosir Parfum',
      },
      {
        quote: 'Platform networking yang dia bangun untuk kampus kami sangat modern dan mudah digunakan. Fitur AI Career Mentor-nya benar-benar membantu ribuan mahasiswa.',
        name: 'Faculty Member',
        role: 'University Partner',
        company: 'President University',
      },
    ]
  : [
      {
        quote: 'Wisnu is a rare full-stack developer. He turned our internal tooling into a fast, secure enterprise platform. Exceptional communication and execution.',
        name: 'Project Manager',
        role: 'Finance SaaS',
        company: 'Zentic',
      },
      {
        quote: 'Collaborating with Wisnu resulted in an e-commerce app serving thousands of customers without a hitch. His attention to detail and performance is impressive.',
        name: 'Business Owner',
        role: 'Wholesale Perfume',
        company: 'Ashar Grosir Parfum',
      },
      {
        quote: 'The networking platform he built for our campus is modern and effortless to use. His AI Career Mentor feature genuinely helps thousands of students.',
        name: 'Faculty Member',
        role: 'University Partner',
        company: 'President University',
      },
    ];
---

<section class="testimonials-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'Testimoni & Rekomendasi' : 'Testimonials & Endorsements'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Apa Kata' : 'What People'}<br />
      {isId ? 'Mereka?' : 'Say'}
    </h2>

    <div class="carousel" id="testimonials-carousel">
      {testimonials.map((t, i) => (
        <div class="slide" data-slide={i}>
          <div class="card">
            <Quote class="quote-icon" />
            <p class="quote-text">{t.quote}</p>
            <div class="author">
              <div class="avatar">{t.name.charAt(0)}</div>
              <div>
                <p class="author-name">{t.name}</p>
                <p class="author-role">{t.role} · {t.company}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="controls">
      <button id="prev-btn" class="control-btn" aria-label={isId ? 'Sebelumnya' : 'Previous'}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="dots" id="dots">
        {testimonials.map((_, i) => (
          <button class="dot-btn" data-dot={i} aria-label={`Testimonial ${i + 1}`}></button>
        ))}
      </div>
      <button id="next-btn" class="control-btn" aria-label={isId ? 'Berikutnya' : 'Next'}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const carousel = document.getElementById('testimonials-carousel');
    if (!carousel) return;

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot-btn'));
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    let current = 0;

    const goTo = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === current);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
      });
    };

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    let autoTimer: number | undefined;
    const startAuto = () => {
      autoTimer = window.setInterval(() => goTo(current + 1), 6000);
    };
    const stopAuto = () => {
      if (autoTimer) window.clearInterval(autoTimer);
    };

    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', startAuto);

    goTo(0);
    startAuto();
  });
</script>

<style>
  .testimonials-section {
    background-color: #0a0a0a;
    color: #ffffff;
    padding-block: 120px;
    font-family: var(--font-sans);
  }

  .container {
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .badge-text {
    text-transform: none;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 0;
    text-align: center;
    width: 100%;
  }

  .carousel {
    margin-top: 56px;
    width: 100%;
    overflow: hidden;
  }

  .slide {
    display: none;
  }

  .slide.is-active {
    display: block;
    animation: fadeSlide 0.45s ease;
  }

  @keyframes fadeSlide {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 40px;
    position: relative;
  }

  .quote-icon {
    width: 28px;
    height: 28px;
    color: var(--accent);
    opacity: 0.8;
  }

  .quote-text {
    margin-top: 20px;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 400;
  }

  .author {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: rgba(132, 225, 12, 0.15);
    border: 1px solid rgba(132, 225, 12, 0.4);
    color: var(--accent);
    font-weight: 700;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }

  .author-role {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    margin: 2px 0 0;
  }

  .controls {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .control-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .control-btn:hover {
    background-color: rgba(132, 225, 12, 0.1);
    border-color: var(--accent);
    color: var(--accent);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dot-btn {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
  }

  .dot-btn.is-active {
    background-color: var(--accent);
    transform: scale(1.3);
  }

  @media (max-width: 640px) {
    .testimonials-section {
      padding-block: 80px;
    }
    .card {
      padding: 28px;
    }
  }
</style>
