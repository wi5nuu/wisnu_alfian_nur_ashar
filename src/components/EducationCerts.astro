---
import { GraduationCap, Award, ExternalLink, ZoomIn } from "lucide-astro";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";
import ImageModal from "./ImageModal.astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section class="education-section">
  <div class="container">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'Pendidikan & Sertifikasi' : 'Education & Certifications'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Sertifikasi' : 'Certifications'}
    </h2>
    
    <div class="certs-grid">
      {profile.certifications.map((cert, index) => (
        <div class="cert-card">
          {cert.image && (
            <button
              class="cert-img-wrap"
              onclick={`openModal('cert-modal', '${cert.image}', '${cert.name.replace(/'/g, "\\'")}')`}
              aria-label={isId ? `Lihat sertifikat: ${cert.name}` : `View certificate: ${cert.name}`}
            >
              <img
                src={cert.image}
                alt={cert.name}
                class="cert-img"
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <div class="cert-img-overlay">
                <ZoomIn class="zoom-icon" />
              </div>
            </button>
          )}
          <div class="cert-body">
            <div class="cert-top">
              <Award class="cert-icon" />
            </div>
            <h3 class="cert-title">{cert.name}</h3>
            <span class="cert-issuer">{cert.issuer}</span>
            <div class="cert-meta">
              <span class="cert-date">{cert.date}</span>
              {cert.id && <span class="cert-id">ID: {cert.id}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<ImageModal id="cert-modal" />

<style>
  .education-section {
    background-color: var(--bg);
    color: #ffffff;
    padding-block: 120px;
    font-family: var(--font-sans);
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(24px, 2.5vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .badge-text {
    text-transform: none;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    font-weight: 500;
    color: #ffffff;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 48px;
  }

  .certs-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .cert-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .cert-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background-color: #151515;
    transform: translateY(-2px);
  }

  /* Certificate image thumbnail */
  .cert-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #0a0a0a;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
  }

  .cert-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cert-card:hover .cert-img {
    transform: scale(1.04);
  }

  .cert-img-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cert-card:hover .cert-img-overlay {
    opacity: 1;
  }

  .zoom-icon {
    width: 28px;
    height: 28px;
    color: #ffffff;
  }

  /* Card body below image */
  .cert-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cert-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .cert-icon {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }

  .cert-title {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 0;
  }

  .cert-issuer {
    margin-top: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
  }

  .cert-meta {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Ensure heading + grid all stretch full width but stay centered */
  .heading,
  .certs-grid {
    width: 100%;
    align-self: stretch;
  }

  /* RESPONSIVE */
  @media (max-width: 1200px) {
    .certs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1024px) {
    .certs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .certs-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 4px;
    }

    .certs-grid::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .cert-card {
      flex: 0 0 78%;
      max-width: 300px;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 768px) {
    .education-section {
      padding-block: 72px;
    }

    .heading {
      font-size: 28px;
    }

    .edu-block {
      flex-direction: column;
      gap: 16px;
      padding: 24px;
    }
  }
</style>
