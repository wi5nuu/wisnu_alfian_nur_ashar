---
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";
import { CornerDownRight, Download } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;
---

<section class="hero-container">

  <!-- A) TOP BADGE -->
  <div class="top-badge">
    <div class="badge-dot"></div>
    <span class="badge-text">{isId ? 'TERSEDIA UNTUK MAGANG & KERJA' : 'AVAILABLE FOR INTERN & WORK'}</span>
  </div>

  <!-- B) GIANT HEADLINE -->
  <h1 class="giant-headline">
    <span class="block text-center">WISNU ALFIAN</span>
    <span class="block text-center">NUR ASHAR</span>
  </h1>

  <!-- C) LEFT COPY BLOCK -->
  <div class="left-copy">
    <p class="tagline">
      {profile.personalInfo.tagline || (isId ? "Saya memadukan seni dengan teknologi mutakhir untuk menghadirkan website yang tidak hanya tampak memukau, tetapi juga mendorong hasil." : "I blend artistry with cutting-edge technology to deliver websites that not only look stunning but also drive results.")}
    </p>
    <div class="cta-row">
      <a href={isId ? '/id/contact' : '/contact'} class="cta-button group">
        <CornerDownRight class="w-5 h-5 text-[#0A0A0A]" />
        <span>{isId ? 'Hubungi Saya' : 'Get in Touch'}</span>
      </a>
      <a href="/CV_Wisnu_Alfian_Nur_Ashar.pdf" download class="cv-button group">
        <Download class="w-5 h-5" />
        <span>{isId ? 'Unduh CV' : 'Download CV'}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-container {
    position: relative;
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #0A0A0A;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  /* TOP BADGE */
  .top-badge {
    margin-top: 190px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 18px;
    z-index: 10;
    position: relative;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.7);
    }
  }

  .badge-text {
    font-style: italic;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  /* GIANT HEADLINE */
  .giant-headline {
    position: relative;
    margin-top: 4vh;
    z-index: 10;
    text-transform: uppercase;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: #ffffff;
    font-size: clamp(28px, 7.5vw, 110px);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 800px;
    margin-inline: auto;
    overflow: hidden;
  }

  .giant-headline span {
    display: block;
  }

  /* LEFT COPY BLOCK */
  .left-copy {
    position: static;
    margin-top: 8vh;
    max-width: 620px;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tagline {
    font-size: 16px;
    line-height: 1.55;
    color: #ffffff;
    margin: 0;
    max-width: 560px;
  }

  .cta-row {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--accent);
    color: #0A0A0A;
    border-radius: 999px;
    padding: 14px 26px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: filter 0.3s ease;
  }

  .cta-button:hover {
    filter: brightness(1.1);
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 14px 26px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .cv-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .left-copy {
      max-width: 480px;
    }
  }

  @media (max-width: 768px) {
    /* Switch container ke flex column normal flow */
    .hero-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 48px;
    }

    .top-badge {
      margin-top: 170px;
      order: 0;
    }

    .giant-headline {
      font-size: 13vw;
      margin-top: 6vh;
      order: 1;
    }

    .left-copy {
      order: 3;
      margin-top: 40px;
      margin-bottom: 0;
      padding: 0 20px;
      max-width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 3;
    }

    .tagline {
      font-size: 14px;
    }

    .cta-row {
      margin-top: 20px;
      justify-content: center;
    }

    .cta-button,
    .cv-button {
      padding: 12px 22px;
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .giant-headline {
      font-size: 12vw;
    }
  }
</style>
