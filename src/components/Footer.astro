---
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

import { Github, Linkedin, Mail, Instagram, MessageCircle } from "lucide-astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-900/95 border-t border-slate-100 dark:border-slate-700/50 py-10">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
      <div class="text-center md:text-left">
        <h2 class="text-lg font-serif font-bold text-slate-950 dark:text-white">
          Wisnu Alfian Nur Ashar
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
          {profile.personalInfo.tagline}
        </p>
      </div>
      <div class="flex items-center gap-3">
        {[
          { icon: Github, href: profile.personalInfo.github, label: "GitHub" },
          { icon: Linkedin, href: profile.personalInfo.linkedin, label: "LinkedIn" },
          { icon: Instagram, href: profile.personalInfo.instagram, label: "Instagram" },
          { icon: MessageCircle, href: profile.personalInfo.line, label: "Line" },
          { icon: Mail, href: `mailto:${profile.personalInfo.email}`, label: "Email" },
        ].map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
            class="p-2 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
            <s.icon class="w-4 h-4" />
          </a>
        ))}
      </div>
    </div>
    <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-slate-400 dark:text-slate-500">
      <p>&copy; {currentYear} Wisnu Alfian Nur Ashar</p>
      <p>{profile.personalInfo.location}</p>
    </div>
  </div>
</footer>
