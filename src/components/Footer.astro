---
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

import {
  Github,
  Linkedin,
  Mail,
  Instagram,
  Facebook,
  Globe,
  MessageCircle,
  ExternalLink,
} from "lucide-astro";

const currentYear = new Date().getFullYear();

const navLinks = [
  { name: isId ? "Utama" : "Home", href: isId ? "/id" : "/" },
  { name: isId ? "Proyek" : "Projects", href: isId ? "/id/projects" : "/projects" },
  { name: "Open Source", href: isId ? "/id/opensource" : "/opensource" },
  { name: isId ? "Keahlian" : "Skills", href: isId ? "/id/skills" : "/skills" },
  { name: isId ? "Kontak" : "Contact", href: isId ? "/id/contact" : "/contact" },
];

const socials = [
  { icon: Github, href: profile.personalInfo.github, label: "GitHub" },
  { icon: Linkedin, href: profile.personalInfo.linkedin, label: "LinkedIn" },
  { icon: Instagram, href: profile.personalInfo.instagram, label: "Instagram" },
  { icon: MessageCircle, href: profile.personalInfo.line, label: "Line" },
  { icon: Mail, href: `mailto:${profile.personalInfo.email}`, label: "Email" },
];
---

<footer class="relative bg-white dark:bg-slate-900/95 text-slate-900 dark:text-white pt-12 pb-8 overflow-hidden border-t border-slate-100 dark:border-slate-700/50 backdrop-blur-sm">
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-slate-200 dark:via-slate-600 to-transparent"
  ></div>
  <div
    class="absolute -top-24 -left-24 w-96 h-96 bg-slate-50 dark:bg-sage-600/20 rounded-full blur-[100px]"
  >
  </div>

  <div class="container-custom relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-10">
      <div class="md:col-span-5 space-y-6 text-center md:text-left">
        <div>
          <h2 class="text-xl font-serif font-bold tracking-tight mb-2 text-slate-950 dark:text-white">
            Wisnu Alfian Nur Ashar<span class="text-slate-400">.</span>
          </h2>
          <p class="text-slate-500 dark:text-white max-w-sm leading-relaxed text-sm font-medium">
            {profile.personalInfo.tagline}
          </p>
        </div>

        <div class="flex justify-center md:justify-start gap-4">
          {[
            { icon: Github, href: profile.personalInfo.github, label: 'GitHub' },
            { icon: Linkedin, href: profile.personalInfo.linkedin, label: 'LinkedIn' },
            { icon: Instagram, href: profile.personalInfo.instagram, label: 'Instagram' },
            { icon: MessageCircle, href: profile.personalInfo.line, label: 'Line' },
            { icon: Mail, href: `mailto:${profile.personalInfo.email}`, label: 'Email' }
          ].map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-xl hover:bg-white dark:hover:bg-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-lg hover:shadow-slate-200 dark:hover:shadow-black/30 transition-all duration-300 active:scale-90"
              aria-label={social.label}
            >
              <social.icon class="w-5 h-5 text-slate-600 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white transition-colors duration-300" />
            </a>
          ))}
        </div>
      </div>

      <div class="md:col-span-3 text-center md:text-left">
        <h3
          class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-400 dark:text-slate-300 mb-4"
        >
          {isId ? 'Navigasi' : 'Navigation'}
        </h3>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-500 dark:text-slate-300 hover:text-black dark:hover:text-white font-bold transition-all hover:pl-2 text-[13px] tracking-wide"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4 text-center md:text-left">
        <h3
          class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-400 dark:text-slate-300 mb-4"
        >
          {isId ? 'Status Saat Ini' : 'Current Status'}
        </h3>
        <div
          class="bg-slate-50 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-600/50 rounded-2xl p-5 backdrop-blur-sm shadow-sm"
        >
          <div
            class="flex items-center gap-3 mb-3 justify-center md:justify-start"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
              ></span>
            </span>
            <span class="text-sm font-bold text-slate-900 dark:text-white"
              >{isId ? 'Tersedia untuk Proyek' : 'Available for Projects'}</span
            >
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-300 font-medium leading-relaxed mb-4">
            {isId ? 'Saya sedang mencari peluang dan kolaborasi baru di bidang Pengembangan Web & Keamanan Siber.' : 'I\'m currently looking for new opportunities and collaborations in Web Dev & Cyber Security.'}
          </p>
          <a
            href={`mailto:${profile.personalInfo.email}`}
            class="inline-flex items-center text-xs font-bold text-slate-900 dark:text-white group hover:underline decoration-slate-950 dark:decoration-white underline-offset-4"
          >
            {isId ? 'MULAI KONSULTASI' : 'START A CONVERSATION'}
            <ExternalLink
              class="w-3 h-3 ml-2 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
            />
          </a>
        </div>
      </div>
    </div>

    <div
      class="pt-8 border-t border-slate-100 dark:border-slate-700/50 flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] uppercase tracking-widest text-slate-400 dark:text-slate-300 font-bold"
    >
      <p class="dark:text-white">
        &copy; {currentYear} — {isId ? 'Didesain & Dibuat' : 'Designed & Coded'} by Wisnu Alfian Nur Ashar
      </p>
      <div class="flex gap-6">
        <span
          class="text-slate-400 dark:text-slate-400 hover:text-black dark:hover:text-slate-200 transition-colors cursor-default underline decoration-slate-200 dark:decoration-slate-700 underline-offset-4"
          >{profile.personalInfo.location}</span
        >
      </div>
    </div>
  </div>
</footer>
