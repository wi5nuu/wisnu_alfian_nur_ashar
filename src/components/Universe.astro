---
import { universe } from "../data/universe";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";
import { getProjectSlug } from "../utils/slug";
import { universeData } from "../utils/universeData";
import { explorer as explorerCopy } from "../data/universeExplorer";

const isId = Astro.url.pathname.startsWith('/id');
const t = isId ? universe.id : universe.en;
const profile = isId ? profileId : profileEn;
const basePath = isId ? '/id/projects' : '/projects';
const known = new Set(profile.projects.map((p) => p.title));
const lang = isId ? 'id' : 'en';
const ex = explorerCopy[lang].ui;
const textData = universeData(lang); // same facts the 3D explorer shows — rendered as crawlable text below

// minimal copy for the client controller
const clientCopy = JSON.stringify({
  lang, play: t.play, stop: t.stop, score: t.score, best: t.best,
  realms: t.realms.map((r) => ({ id: r.id, title: r.title, mission: r.mission, game: r.game })),
});
---

<section id="universe" class="uv" aria-labelledby="uv-heading" data-uv-root data-copy={clientCopy}>
  <div class="uv-wrap">
    <header class="uv-head">
      <div class="uv-badge reveal-up">
        <span class="uv-dot"></span>
        <span>{t.badge}</span>
      </div>
      <h2 id="uv-heading" class="uv-h2 reveal-up">{t.heading[0]}<br />{t.heading[1]}</h2>
      <p class="uv-intro reveal-up">{t.intro}</p>
    </header>

    <div class="uv-stage" data-uv-stage data-realm="cyber" tabindex="0" role="group" aria-label={isId ? 'Dunia 3D interaktif: Cyber, AI, Software, dan DevOps' : 'Interactive 3D worlds: Cyber, AI, Software and DevOps'}>
      <div class="uv-bg" aria-hidden="true"></div>
      <canvas class="uv-canvas" aria-hidden="true"></canvas>
      <p class="uv-nogl">{t.noGl}</p>

      <div class="uv-hud">
        <div class="uv-top">
          <div class="uv-card">
            <span class="uv-kicker" data-uv-game>{t.realms[0].game}</span>
            <strong class="uv-title" data-uv-title>{t.realms[0].title}</strong>
            <span class="uv-mission" data-uv-mission>{t.realms[0].mission}</span>
          </div>
          <dl class="uv-stats">
            <div><dt>{t.score}</dt><dd data-uv-score>0</dd></div>
            <div><dt>{t.best}</dt><dd data-uv-best>0</dd></div>
            <div><dt>{t.combo}</dt><dd data-uv-combo>–</dd></div>
          </dl>
        </div>

        <div class="uv-meterbar" aria-hidden="true">
          <span data-uv-meter></span>
          <i><u data-uv-fill></u></i>
          <em data-uv-status></em>
        </div>

        <div class="uv-legend" data-uv-legend role="group" aria-label={isId ? 'Filter penanda' : 'Marker filter'}></div>
        <div class="uv-pois" data-uv-pois></div>
        <aside class="uv-panel" data-uv-panel hidden aria-live="polite"></aside>

        <div class="uv-zoom" role="group" aria-label="Zoom">
          <button type="button" class="uv-btn uv-btn--icon" data-uv-zin aria-label={ex.zoomIn} title={ex.zoomIn}>+</button>
          <button type="button" class="uv-btn uv-btn--icon" data-uv-zout aria-label={ex.zoomOut} title={ex.zoomOut}>−</button>
          <button type="button" class="uv-btn uv-btn--icon" data-uv-zreset aria-label={ex.reset} title={ex.reset}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          </button>
        </div>

        <div class="uv-labels" data-uv-labels aria-hidden="true"></div>
        <div class="uv-tip" data-uv-tip hidden></div>
        <div class="uv-toast" data-uv-toast role="status" aria-live="polite"></div>
        <div class="uv-log" data-uv-log aria-hidden="true"></div>

        <div class="uv-overlay" data-uv-overlay hidden>
          <div class="uv-overlay-box">
            <strong data-uv-o-title></strong>
            <span data-uv-o-sub></span>
            <b data-uv-o-score></b>
            <div class="uv-overlay-actions">
              <button type="button" class="uv-btn uv-btn--accent" data-uv-retry>{t.retry}</button>
              <button type="button" class="uv-btn" data-uv-exit>{t.exit}</button>
            </div>
          </div>
        </div>

        <p class="uv-hint" data-uv-hint>{ex.realmHelp}</p>

        <div class="uv-bottom">
          <div class="uv-tabs" role="tablist" aria-label={isId ? 'Pilih dunia' : 'Choose a realm'}>
            {t.realms.map((r, i) => (
              <button type="button" role="tab" class="uv-tab" data-uv-tab={r.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <b>{String(i + 1).padStart(2, '0')}</b>{r.label}
              </button>
            ))}
          </div>
          <div class="uv-actions">
            <button type="button" class="uv-btn uv-btn--accent" data-uv-play aria-pressed="false">{t.play}</button>
            <button type="button" class="uv-btn uv-btn--icon" data-uv-tilt aria-pressed="false" aria-label={t.tilt} title={t.tilt}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <button type="button" class="uv-btn uv-btn--icon" data-term-open aria-label="Terminal" title="Terminal (press `)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 17 6-6-6-6M12 19h8"/></svg>
            </button>
            <button type="button" class="uv-btn uv-btn--icon" data-uv-imm aria-pressed="false" aria-label={t.explore} title={t.explore}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <details class="uv-text">
      <summary>{ex.readAsText}</summary>
      <div class="uv-text-grid">
        {t.realms.map((r, i) => {
          const groups = textData.realms[r.id].groups;
          return (
            <article class="uv-realm">
              <header>
                <span class="uv-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{r.title}</h3>
              </header>
              <p>{r.blurb}</p>
              {groups.map((g) => (
                <>
                  <h4 class="uv-sub">{g.label}</h4>
                  {g.id === 'method' ? (
                    <ol class="uv-steps">{g.items.map((it) => <li><b>{it.t}.</b> {it.d}</li>)}</ol>
                  ) : g.id === 'skills' ? (
                    <ul class="uv-chips">{g.items.map((it) => <li>{it.t}</li>)}</ul>
                  ) : g.id === 'projects' ? (
                    <ul class="uv-proofs">{g.items.map((it) => <li><a href={it.l?.[0]?.[1]}>{it.t}</a></li>)}</ul>
                  ) : (
                    <ul class="uv-list">{g.items.map((it) => <li><b>{it.t}</b>{it.s ? ' — ' + it.s : ''}</li>)}</ul>
                  )}
                </>
              ))}
            </article>
          );
        })}
      </div>
    </details>
  </div>
</section>

<script>
  // Loaded lazily: the Skill Universe code is fetched only when the section is about to scroll into view.
  let dispose: (() => void) | null = null;
  let io: IntersectionObserver | null = null;
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-uv-root]');
    if (!el) return;
    io?.disconnect();
    io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io?.disconnect();
      import('../scripts/gl/universe.js').then((m) => {
        if (document.contains(el)) { dispose?.(); dispose = m.mountUniverse(el); }
      });
    }, { rootMargin: '300px 0px' });
    io.observe(el);
  });
  document.addEventListener('astro:before-swap', () => {
    io?.disconnect();
    dispose?.();
    dispose = null;
  });
</script>

<style>
  .uv {
    position: relative;
    background: #0A0A0A;
    color: #fff;
    padding: clamp(56px, 8vw, 104px) clamp(16px, 3vw, 40px);
    font-family: var(--font-sans);
    scroll-margin-top: 0;
  }
  .uv-wrap { max-width: 1400px; margin-inline: auto; }
  .uv-head { margin-bottom: 28px; }
  .uv-badge {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 999px; padding: 6px 16px;
    font-size: 12.5px; font-weight: 500; letter-spacing: 0.03em;
  }
  .uv-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .uv-h2 {
    margin: 14px 0 0; color: #fff; font-family: var(--font-sans);
    font-size: clamp(28px, 3.2vw, 52px); font-weight: 500; letter-spacing: -0.01em; line-height: 1.1;
  }
  .uv-intro { margin: 14px 0 0; max-width: 620px; color: rgba(255,255,255,0.72); font-size: 15px; line-height: 1.6; }

  /* ---------- STAGE ---------- */
  .uv-stage {
    position: relative;
    height: clamp(500px, 82svh, 780px);
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.12);
    background: #070707;
    overflow: hidden;
    outline: none;
    isolation: isolate;
    contain: layout paint;
    touch-action: pan-y;
  }
  .uv-stage:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
  .uv-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 55%, rgba(132,225,12,0.12), transparent 70%),
      linear-gradient(rgba(132,225,12,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(132,225,12,0.07) 1px, transparent 1px);
    background-size: auto, 44px 44px, 44px 44px;
  }
  .uv-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 1; opacity: 0; transition: opacity 0.8s ease; touch-action: pan-y; cursor: grab;
  }
  .uv-canvas:active { cursor: grabbing; }
  .uv-stage.is-live .uv-canvas { opacity: 1; }
  .uv-nogl { display: none; position: absolute; inset: auto 20px 90px; z-index: 2; margin: 0; color: rgba(255,255,255,0.7); font-size: 14px; text-align: center; }
  .uv-stage.no-gl .uv-nogl { display: block; }
  .uv-stage.no-gl .uv-canvas { display: none; }

  .uv-hud { position: absolute; inset: 0; z-index: 3; pointer-events: none; padding: 16px; display: flex; flex-direction: column; }
  .uv-hud button, .uv-hud a { pointer-events: auto; }

  .uv-top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .uv-card, .uv-stats, .uv-tabs, .uv-log, .uv-overlay-box, .uv-tip, :global(.uv-chip) {
    background: rgba(10,10,10,0.6);
    border: 1px solid rgba(255,255,255,0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .uv-card { display: flex; flex-direction: column; gap: 3px; padding: 10px 14px; border-radius: 16px; max-width: min(420px, 62%); }
  .uv-kicker { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .uv-title { font-size: 18px; font-weight: 600; line-height: 1.15; }
  .uv-mission { font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.4; }
  .uv-stats { display: flex; gap: 14px; margin: 0; padding: 10px 14px; border-radius: 16px; }
  .uv-stats div { display: flex; flex-direction: column; align-items: flex-end; min-width: 34px; }
  .uv-stats dt { font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
  .uv-stats dd { margin: 0; font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; }

  .uv-meterbar { display: flex; align-items: center; gap: 10px; margin-top: 10px; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.7); opacity: 0; transition: opacity 0.3s; }
  .uv-stage.is-playing .uv-meterbar { opacity: 1; }
  .uv-meterbar i { flex: 1; max-width: 260px; height: 5px; border-radius: 99px; background: rgba(255,255,255,0.14); overflow: hidden; }
  .uv-meterbar u { display: block; height: 100%; background: var(--accent); transform-origin: left; transition: transform 0.15s linear; box-shadow: 0 0 12px rgba(132,225,12,0.7); }
  .uv-meterbar em { font-style: normal; color: var(--accent); font-weight: 600; }

  .uv-labels { position: absolute; inset: 0; overflow: hidden; }
  .uv-stage:not(.is-playing) .uv-labels { display: none; } /* pipeline chips only matter during the mission; the explorer markers cover them */
  :global(.uv-chip) {
    position: absolute; left: 0; top: 0; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 500; white-space: nowrap;
    border-color: rgba(132,225,12,0.45); will-change: transform; pointer-events: none;
  }
  :global(.uv-chip b) { color: var(--accent); font-size: 9.5px; margin-right: 4px; letter-spacing: 0.08em; }
  .uv-tip { position: absolute; left: 0; top: 0; padding: 5px 12px; border-radius: 10px; font-size: 12px; font-weight: 600; color: var(--accent); white-space: nowrap; border-color: rgba(132,225,12,0.5); will-change: transform; }

  .uv-toast {
    position: absolute; left: 50%; top: 28%; transform: translate(-50%, 6px) scale(0.96);
    padding: 8px 18px; border-radius: 999px; font-size: 14px; font-weight: 700; letter-spacing: 0.06em;
    background: rgba(10,10,10,0.7); border: 1px solid rgba(255,255,255,0.2); opacity: 0; white-space: nowrap; pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .uv-toast.is-on { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .uv-toast--good { color: var(--accent); border-color: rgba(132,225,12,0.6); box-shadow: 0 0 24px rgba(132,225,12,0.3); }
  .uv-toast--bad { color: #fff; border-color: rgba(255,255,255,0.6); background: rgba(60,10,10,0.7); }
  .uv-toast--info { color: #fff; }

  .uv-log {
    position: absolute; left: 16px; bottom: 74px; max-width: min(360px, 60%); padding: 8px 12px; border-radius: 12px; margin: 0;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 10.5px; line-height: 1.55; color: rgba(132,225,12,0.85); overflow: hidden; pointer-events: none;
  }
  .uv-log:empty { display: none; }
  .uv-log :global(div) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; animation: logIn 0.4s ease both; }
  .uv-log :global(div)::before { content: '$ '; opacity: 0.6; }
  @keyframes logIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  .uv-hint { position: absolute; left: 0; right: 0; bottom: 74px; margin: 0; text-align: center; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.45); pointer-events: none; }
  .uv-hint[hidden] { display: none; }

  .uv-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; }
  .uv-tabs { display: inline-flex; gap: 4px; padding: 5px; border-radius: 999px; }
  .uv-tab {
    display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px; border: 0; background: transparent; color: #fff;
    font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  .uv-tab b { font-size: 9.5px; color: var(--accent); letter-spacing: 0.08em; font-weight: 600; }
  .uv-tab:hover { background: rgba(255,255,255,0.1); }
  .uv-tab[aria-selected="true"] { background: var(--accent); color: #0A0A0A; }
  .uv-tab[aria-selected="true"] b { color: #0A0A0A; }
  .uv-stage.is-playing .uv-tabs { opacity: 0.35; pointer-events: none; }

  .uv-actions { display: flex; gap: 8px; align-items: center; }
  .uv-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 20px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.3); background: rgba(10,10,10,0.6); color: #fff; font: inherit; font-size: 14px; font-weight: 500;
    cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: filter 0.2s, background 0.2s, border-color 0.2s;
  }
  .uv-btn:hover { background: rgba(255,255,255,0.12); }
  .uv-btn--accent { background: var(--accent); border-color: var(--accent); color: #0A0A0A; }
  .uv-btn--accent:hover { background: var(--accent); filter: brightness(1.1); }
  .uv-btn--icon { padding: 11px; width: 44px; height: 44px; }
  .uv-btn--icon[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
  .uv-btn[hidden] { display: none; }

  .uv-overlay { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0,0,0,0.5); z-index: 5; }
  .uv-overlay[hidden] { display: none; }
  .uv-overlay-box { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 26px 30px; border-radius: 22px; text-align: center; max-width: 86%; }
  .uv-overlay-box strong { font-size: 22px; letter-spacing: 0.06em; color: var(--accent); }
  .uv-overlay-box span { color: rgba(255,255,255,0.7); font-size: 13px; }
  .uv-overlay-box b { font-size: 15px; font-weight: 600; }
  .uv-overlay-actions { display: flex; gap: 10px; margin-top: 12px; }

  /* immersive */
  .uv-stage.is-full { position: fixed; inset: 0; z-index: 100000; height: 100vh; height: 100dvh; border-radius: 0; border: 0; contain: none; touch-action: none; }
  .uv-stage.is-full .uv-canvas { touch-action: none; }
  .uv-stage.is-full .uv-hud { padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom)); }
  :global(html.uv-lock), :global(html.uv-lock body) { overflow: hidden !important; overscroll-behavior: none; }

  /* ---------- EXPLORER (markers, legend, panel, zoom) ---------- */
  .uv-legend { display: flex; gap: 6px; margin-top: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; pointer-events: auto; max-width: 100%; }
  .uv-legend::-webkit-scrollbar { display: none; }
  .uv-legend[hidden] { display: none; }
  .uv-stage.is-playing .uv-legend, .uv-stage.is-playing .uv-pois, .uv-stage.is-playing .uv-panel { display: none; }
  :global(.uv-leg) {
    display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; padding: 6px 12px; border-radius: 999px; font: inherit; font-size: 12px; font-weight: 500; color: #fff; cursor: pointer;
    background: rgba(10,10,10,0.6); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  :global(.uv-leg b) { font-size: 10px; font-weight: 600; color: var(--accent); }
  :global(.uv-leg:hover) { border-color: rgba(132,225,12,0.6); }
  :global(.uv-leg[aria-pressed="true"]) { background: var(--accent); border-color: var(--accent); color: #0A0A0A; }
  :global(.uv-leg[aria-pressed="true"] b) { color: #0A0A0A; }

  .uv-pois { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 3; isolation: isolate; }
  .uv-pois[hidden] { display: none; }
  :global(.uv-poi) {
    position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; gap: 7px; padding: 8px; margin: 0; border: 0; background: transparent; color: #fff; cursor: pointer; pointer-events: auto;
    font: inherit; font-size: 12px; font-weight: 500; white-space: nowrap; will-change: transform, opacity; -webkit-tap-highlight-color: transparent;
  }
  :global(.uv-poi[hidden]) { display: none; }
  :global(.uv-poi i) { width: 12px; height: 12px; flex-shrink: 0; background: var(--accent); box-shadow: 0 0 0 3px rgba(132,225,12,0.25), 0 0 14px rgba(132,225,12,0.8); transition: transform 0.2s; }
  :global(.uv-poi[data-g="method"] i) { transform: rotate(45deg); border-radius: 2px; }
  :global(.uv-poi[data-g="skills"] i) { border-radius: 50%; }
  :global(.uv-poi[data-g="projects"] i) { border-radius: 4px; background: transparent; border: 2px solid var(--accent); }
  :global(.uv-poi[data-g="reports"] i), :global(.uv-poi[data-g="achievements"] i), :global(.uv-poi[data-g="experience"] i), :global(.uv-poi[data-g="certs"] i) { clip-path: polygon(50% 0, 100% 100%, 0 100%); border-radius: 0; background: #fff; box-shadow: none; filter: drop-shadow(0 0 6px rgba(255,255,255,0.8)); }
  :global(.uv-poi span) {
    padding: 4px 10px; border-radius: 999px; background: rgba(10,10,10,0.78); border: 1px solid rgba(132,225,12,0.45); max-width: 190px; overflow: hidden; text-overflow: ellipsis;
    opacity: 0; transform: translateX(-4px); transition: opacity 0.2s, transform 0.2s; pointer-events: none;
  }
  :global(.uv-poi.is-label span) { opacity: 1; transform: none; }
  :global(.uv-poi:hover i), :global(.uv-poi:focus-visible i) { transform: scale(1.35); }
  :global(.uv-poi[data-g="method"]:hover i) { transform: rotate(45deg) scale(1.35); }
  :global(.uv-poi:focus-visible) { outline: none; }
  :global(.uv-poi.is-sel i) { background: #fff; box-shadow: 0 0 0 4px rgba(132,225,12,0.7), 0 0 22px rgba(132,225,12,1); }
  :global(.uv-poi.is-sel span) { background: var(--accent); color: #0A0A0A; border-color: var(--accent); }

