---
interface Props {
  src: string;
  /** Delay in ms before the video starts loading after entering the viewport (use for above-the-fold videos). */
  loadDelay?: number;
}

const { src, loadDelay = 0 } = Astro.props;
---

<video
  class="video-bg"
  data-src={src}
  data-load-delay={loadDelay}
  muted
  loop
  playsinline
  preload="none"
  aria-hidden="true"
  tabindex="-1"
>
  <track kind="captions" src="/media/captions.vtt" srclang="en" label="Description" default />
</video>
