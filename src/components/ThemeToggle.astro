<button id="theme-toggle" class="p-2 rounded-xl bg-sage-100 dark:bg-sage-800 transition-all">
  <span class="dark:hidden">🌙 Mode Gelap</span>
  <span class="hidden dark:inline">☀️ Mode Terang</span>
</button>

<script is:inline>
  const setupThemeToggle = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    
    // Cleanup previous listener to prevent duplicates
    btn.removeEventListener("click", window.handleToggleClick);
    
    window.handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");
      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
    
    btn.addEventListener("click", window.handleToggleClick);
  };

  // Run on initial load
  setupThemeToggle();
  // Run on subsequent navigations
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
