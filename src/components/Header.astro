---
// Bagian Import tetap sama...
import { User, Briefcase, FolderKanban, Mail, Sparkles } from "lucide-astro";
import AIChatBot from "./AIChatBot.astro";

const navLinks = [
  { name: "About", href: "/about", icon: User },
  { name: "Projects", href: "/projects", icon: FolderKanban },
  { name: "Home", href: "/", isLogo: true },
  { name: "AI", href: "#", icon: Sparkles, isAI: true },
  { name: "Contact", href: "/contact", icon: Mail },
];

const pathname = new URL(Astro.request.url).pathname;
---

<header transition:persist class="hidden md:block fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
  <div class="container-custom flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-1.5">
      <img src="/logo.png" alt="Logo" class="w-6 h-6 object-contain" />
      <span class="text-lg font-bold text-slate-900 tracking-tight">Wisnu Alfian Nur Ashar<span class="text-slate-400">.</span></span>
    </a>

    <nav class="flex items-center gap-8">
      {navLinks.map((link) => 
        !link.isLogo && !link.isAI && (
        <a href={link.href} class={`text-[13px] tracking-wide transition-all ${pathname === link.href ? "text-slate-950 font-bold border-b-2 border-slate-950" : "text-slate-500 hover:text-slate-950 hover:font-medium"}`}>
          {link.name}
        </a>
      ))}
      <a href="/contact" class="border border-slate-900 text-slate-900 px-4 py-1.5 rounded-full text-xs hover:bg-slate-900 hover:text-white transition-all">
        Contact
      </a>
    </nav>
  </div>
</header>

<div transition:persist class="md:hidden fixed top-2 left-4 right-4 z-50 bg-white/90 backdrop-blur-md px-4 py-2.5 flex justify-between items-center border border-slate-100 rounded-xl shadow-lg ring-1 ring-slate-900/5">
    <a href="/" class="flex items-center gap-1.5">
        <img src="/logo.png" alt="Logo" class="w-6 h-6 object-contain" />
        <span class="text-[15px] font-bold text-slate-900 tracking-tight">Wisnu Alfian Nur Ashar</span>
    </a>
    <a href="/contact" class="text-slate-900 p-1.5 active:scale-95 transition-transform bg-slate-50 rounded-full">
        <Mail size={16} />
    </a>
</div>

<div transition:persist class="md:hidden fixed bottom-4 left-0 w-full px-6 z-[100]">
  <nav class="mx-auto max-w-[360px] bg-white shadow-[0_10px_40px_rgba(0,0,0,0.1)] border border-slate-100 rounded-[2rem] px-2 py-1">
    <div class="flex items-center justify-around">
      {navLinks.map((link) => {
        const isActive = link.href === pathname || (link.href !== '/' && pathname.startsWith(link.href));
        const LinkIcon = link.icon;
        
        if (link.isLogo) {
          return (
            <a href="/" class="relative -translate-y-6 transition-transform active:scale-95" aria-label="Home">
              <div class="w-14 h-14 bg-white rounded-full p-1 shadow-xl border border-slate-100 flex items-center justify-center">
                <img src="/logo.png" alt="Home" class="w-full h-full object-cover rounded-full" />
              </div>
            </a>
          );
        }

        if (link.isAI) {
            return (
                <button id="mobile-ai-trigger" class="flex flex-col items-center py-2 min-w-[50px] transition-transform active:scale-95 cursor-pointer" aria-label="AI Assistant">
                    <div class="text-blue-500">
                         {LinkIcon && <LinkIcon size={22} strokeWidth={2.5} />}
                    </div>
                    <span class="text-[9px] mt-1 font-bold text-blue-600 uppercase tracking-wider">
                        {link.name}
                    </span>
                </button>
            )
        }

        return (
          <a href={link.href} class="flex flex-col items-center py-2 min-w-[52px] transition-all active:scale-90 group" aria-label={link.name}>
            <div class={`transition-all duration-300 ${isActive ? "text-slate-950 scale-110" : "text-slate-400 group-hover:text-slate-600"}`}>
              {LinkIcon && <LinkIcon size={20} strokeWidth={isActive ? 2.5 : 2} />}
            </div>
            <span class={`text-[9px] mt-1 font-bold uppercase tracking-widest transition-colors ${isActive ? "text-slate-950" : "text-slate-400"}`}>
              {link.name}
            </span>
          </a>
        );
      })}
    </div>
  </nav>
</div>

<AIChatBot />

<style>
  @media (max-width: 768px) {
    body {
      padding-bottom: 120px;
      padding-top: 86px; /* Increased for floating header */
    }
  }
  a, button {
    -webkit-tap-highlight-color: transparent;
  }
</style>