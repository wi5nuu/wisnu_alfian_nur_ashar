---
// Bagian Import tetap sama...
import { User, Briefcase, FolderKanban, Mail, Sparkles } from "lucide-astro";
import AIChatBot from "./AIChatBot.astro";

const navLinks = [
  { name: "About", href: "/about", icon: User },
  { name: "Exp.", href: "/experience", icon: Briefcase },
  { name: "Home", href: "/", isLogo: true },
  { name: "AI", href: "#", icon: Sparkles, isAI: true },
  { name: "Projects", href: "/projects", icon: FolderKanban },
];

const pathname = new URL(Astro.request.url).pathname;
---

<header class="hidden md:block fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
  <div class="container-custom flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.png" alt="Logo" class="w-8 h-8 object-contain" />
      <span class="text-xl font-bold text-slate-900 tracking-tight">Wisnu Alfian Nur Ashar<span class="text-slate-400">.</span></span>
    </a>

    <nav class="flex items-center gap-8">
      {navLinks.map((link) => 
        !link.isLogo && !link.isAI && (
        <a href={link.href} class={`text-sm font-medium transition-all ${pathname === link.href ? "text-slate-900 font-bold" : "text-slate-400 hover:text-slate-900"}`}>
          {link.name}
        </a>
      ))}
      <a href="/contact" class="border border-slate-900 text-slate-900 px-5 py-2 rounded-full text-sm hover:bg-slate-900 hover:text-white transition-all">
        Contact
      </a>
    </nav>
  </div>
</header>

<div class="md:hidden fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md px-6 py-4 flex justify-between items-center border-b border-slate-50">
    <a href="/" class="flex items-center gap-2">
        <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain" />
        <span class="text-lg font-bold text-slate-900 tracking-tight">Wisnu<span class="text-slate-400">.</span>dev</span>
    </a>
    <a href="/contact" class="text-slate-900 p-2 active:scale-95 transition-transform bg-slate-50 rounded-full">
        <Mail size={18} />
    </a>
</div>

<div class="md:hidden fixed bottom-8 left-0 w-full px-6 z-[100]">
  <nav class="mx-auto max-w-[380px] bg-white shadow-[0_10px_40px_rgba(0,0,0,0.1)] border border-slate-100 rounded-[2.5rem] px-2 py-2">
    <div class="flex items-center justify-around">
      {navLinks.map((link) => {
        const isActive = link.href === pathname;
        const LinkIcon = link.icon;
        
        if (link.isLogo) {
          return (
            <a href="/" class="relative -translate-y-8 transition-transform active:scale-95">
              <div class="w-16 h-16 bg-white rounded-full p-1 shadow-xl border border-slate-100 flex items-center justify-center">
                <img src="/logo.png" alt="Home" class="w-full h-full object-cover rounded-full" />
              </div>
            </a>
          );
        }

        if (link.isAI) {
            return (
                <button id="mobile-ai-trigger" class="flex flex-col items-center py-2 min-w-[50px] transition-transform active:scale-95 cursor-pointer">
                    <div class="text-blue-500">
                         {LinkIcon && <LinkIcon size={22} strokeWidth={2.5} />}
                    </div>
                    <span class="text-[9px] mt-1 font-bold text-blue-600 uppercase tracking-wider">
                        {link.name}
                    </span>
                </button>
            )
        }

        return (
          <a href={link.href} class="flex flex-col items-center py-2 min-w-[50px] transition-transform active:scale-95">
            <div class={`transition-colors duration-300 ${isActive ? "text-slate-900" : "text-slate-300"}`}>
              {LinkIcon && <LinkIcon size={22} strokeWidth={isActive ? 2.5 : 1.8} />}
            </div>
            <span class={`text-[9px] mt-1 font-semibold uppercase tracking-wider transition-colors ${isActive ? "text-slate-900" : "text-slate-300"}`}>
              {link.name}
            </span>
          </a>
        );
      })}
    </div>
  </nav>
</div>

<AIChatBot />

<style>
  @media (max-width: 768px) {
    body {
      padding-bottom: 120px;
      padding-top: 72px; /* Disesuaikan agar konten tidak tertutup header baru */
    }
  }
  a, button {
    -webkit-tap-highlight-color: transparent;
  }
</style>