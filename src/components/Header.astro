---
import { User, Briefcase, FolderKanban, Mail, Sparkles, GitBranch, Wrench } from "lucide-astro";

const navLinks = [
  { name: "About", href: "/about", icon: User },
  { name: "Projects", href: "/projects", icon: FolderKanban },
  { name: "Open Source", href: "/opensource", icon: GitBranch },
  { name: "Home", href: "/", isLogo: true },
  { name: "AI", href: "#", icon: Sparkles, isAI: true },
  { name: "Skills", href: "/skills", icon: Wrench },
  { name: "Contact", href: "/contact", icon: Mail },
];

const pathname = new URL(Astro.request.url).pathname;
const isId = pathname.startsWith('/id');

const getLocalizedUrl = (path: string, toId: boolean) => {
  const base = toId ? '/id' : '';
  const cleanPath = path.startsWith('/id') ? path.substring(3) : path;
  return `${base}${cleanPath === '' || cleanPath === '/' ? '/' : cleanPath}`;
};
---

<header transition:persist class="hidden md:block fixed top-0 w-full z-50 bg-white/80 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-100 dark:border-transparent">
  <div class="container-custom flex items-center justify-between h-16">
    <a href={getLocalizedUrl("/", isId)} class="flex items-center gap-1.5">
      <img src="/logo.png" alt="Logo" class="w-6 h-6 object-contain" />
      <span class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">Wisnu Alfian Nur Ashar<span class="text-slate-400 dark:text-white">.</span></span>
    </a>

    <nav class="flex items-center gap-6">
      {navLinks.map((link) => {
        if (link.isLogo || link.isAI) return null;
        const localizedHref = getLocalizedUrl(link.href, isId);
        return (
        <a href={localizedHref} class={`text-[13px] tracking-wide transition-all ${pathname === localizedHref ? "text-slate-950 dark:text-white font-bold border-b-2 border-slate-950 dark:border-white" : "text-slate-500 dark:text-white hover:text-slate-950 dark:hover:text-white hover:font-medium"}`}>
          {isId && link.name === "About" ? "Tentang" : 
           isId && link.name === "Projects" ? "Proyek" : 
           isId && link.name === "Open Source" ? "Open Source" : 
           isId && link.name === "Skills" ? "Keahlian" : 
           isId && link.name === "Contact" ? "Kontak" : link.name}
        </a>
        );
      })}
      
      <div class="flex items-center gap-3 border-l border-slate-200 dark:border-transparent pl-6 ml-2">
        <button id="theme-toggle-desktop" class="p-1.5 text-slate-500 hover:text-slate-900 dark:text-white dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-all" aria-label="Toggle Theme">
          <svg id="moon-icon-desktop" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          <svg id="sun-icon-desktop" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        </button>
        
        <button id="lang-toggle-desktop" class="text-xs font-bold text-slate-600 dark:text-white hover:text-black dark:hover:text-white px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 transition-colors" aria-label="Ganti Bahasa">
          {isId ? 'ID' : 'EN'}
        </button>
      </div>

      <a href={getLocalizedUrl("/contact", isId)} class="border border-slate-900 dark:border-white text-slate-900 dark:text-white px-4 py-1.5 rounded-full text-xs hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 transition-all">
        {isId ? 'Hubungi' : 'Contact'}
      </a>
    </nav>
  </div>
</header>

<div transition:persist class="md:hidden fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl px-5 py-3 flex justify-between items-center shadow-[0_2px_15px_rgba(0,0,0,0.08)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
    <a href={getLocalizedUrl("/", isId)} class="flex items-center gap-2">
        <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain rounded-lg shadow-sm" />
        <span class="text-base font-bold text-slate-900 dark:text-white tracking-tight">Wisnu Alfian</span>
    </a>
    
    <div class="flex items-center gap-3">
      <button id="lang-toggle-mobile" class="text-[11px] font-bold text-slate-700 dark:text-slate-200 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition-transform" aria-label="Ganti Bahasa">
        {isId ? 'ID' : 'EN'}
      </button>
      <button id="theme-toggle-mobile" class="p-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition-all" aria-label="Ganti Tema">
        <svg id="moon-icon-mobile" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        <svg id="sun-icon-mobile" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
      </button>
    </div>
</div>

<div transition:persist class="md:hidden fixed bottom-4 left-3 right-3 z-[100]">
  <nav class="mx-auto max-w-[500px] bg-white dark:bg-slate-900 shadow-[0_10px_40px_rgba(0,0,0,0.15)] dark:shadow-[0_10px_40px_rgba(0,0,0,0.6)] border border-slate-100 dark:border-slate-800 rounded-[2rem] px-2 py-2">
    <div class="flex items-center justify-between gap-0.5">
      {navLinks.map((link) => {
        const isActive = link.href === pathname || (link.href !== '/' && pathname.startsWith(link.href));
        const LinkIcon = link.icon;
        
        if (link.isLogo) {
          return (
            <a href={getLocalizedUrl("/", isId)} class="relative -translate-y-8 transition-transform active:scale-90" aria-label="Home">
              <div class="w-16 h-16 bg-white dark:bg-slate-800 rounded-full p-1.5 shadow-[0_5px_15px_rgba(0,0,0,0.2)] border border-slate-100 dark:border-slate-700 flex items-center justify-center">
                <img src="/logo.png" alt="Home" class="w-full h-full object-cover rounded-full" />
              </div>
            </a>
          );
        }

        if (link.isAI) {
            return (
                <button id="mobile-ai-trigger" class="flex flex-col items-center py-2 flex-1 min-w-0 transition-transform active:scale-90 cursor-pointer" aria-label="AI Assistant">
                    <div class="text-blue-500">
                         {LinkIcon && <LinkIcon size={22} strokeWidth={2.5} />}
                    </div>
                    <span class="text-[9px] mt-1 font-bold text-blue-600 uppercase tracking-wider truncate max-w-full">
                        AI
                    </span>
                </button>
            )
        }

        return (
          <a href={getLocalizedUrl(link.href, isId)} class="flex flex-col items-center py-2 flex-1 min-w-0 transition-all active:scale-90 group" aria-label={link.name}>
            <div class={`transition-all duration-300 ${isActive ? "text-slate-900 dark:text-white scale-110" : "text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300"}`}>
              {LinkIcon && <LinkIcon size={link.name === "Open Source" ? 18 : 22} strokeWidth={isActive ? 2.5 : 2} />}
            </div>
            <span class={`text-[9px] mt-1 font-bold uppercase tracking-wider transition-colors truncate max-w-full ${isActive ? "text-slate-900 dark:text-white" : "text-slate-400 dark:text-slate-500"}`}>
              {isId && link.name === "About" ? "Tentang" : 
               isId && link.name === "Projects" ? "Proyek" : 
               isId && link.name === "Open Source" ? "Open Src" : 
               isId && link.name === "Skills" ? "Keahlian" : 
               isId && link.name === "Contact" ? "Kontak" : link.name}
            </span>
          </a>
        );
      })}
    </div>
  </nav>
</div>

<script>
  const setupTheme = () => {
    const themeBtnDesktop = document.getElementById('theme-toggle-desktop');
    const themeBtnMobile = document.getElementById('theme-toggle-mobile');
    const moonIconDesktop = document.getElementById('moon-icon-desktop');
    const sunIconDesktop = document.getElementById('sun-icon-desktop');
    const moonIconMobile = document.getElementById('moon-icon-mobile');
    const sunIconMobile = document.getElementById('sun-icon-mobile');

    const updateIcons = () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        moonIconDesktop?.classList.add('hidden');
        moonIconMobile?.classList.add('hidden');
        sunIconDesktop?.classList.remove('hidden');
        sunIconMobile?.classList.remove('hidden');
      } else {
        sunIconDesktop?.classList.add('hidden');
        sunIconMobile?.classList.add('hidden');
        moonIconDesktop?.classList.remove('hidden');
        moonIconMobile?.classList.remove('hidden');
      }
    };

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    };

    // Remove old listeners before adding new ones (prevents double-toggle on SPA nav)
    themeBtnDesktop?.removeEventListener('click', toggleTheme);
    themeBtnMobile?.removeEventListener('click', toggleTheme);
    
    updateIcons();
    themeBtnDesktop?.addEventListener('click', toggleTheme);
    themeBtnMobile?.addEventListener('click', toggleTheme);
  };

  const setupLang = () => {
    const langBtnDesktop = document.getElementById('lang-toggle-desktop');
    const langBtnMobile = document.getElementById('lang-toggle-mobile');
    
    const toggleLang = () => {
      const isId = window.location.pathname.startsWith('/id');
      const currentPath = window.location.pathname;
      let newPath = '';
      
      if (isId) {
        newPath = currentPath.substring(3);
        if (newPath === '') newPath = '/';
      } else {
        newPath = '/id' + (currentPath === '/' ? '' : currentPath);
      }
      
      window.location.href = newPath;
    };

    langBtnDesktop?.addEventListener('click', toggleLang);
    langBtnMobile?.addEventListener('click', toggleLang);
  };

  document.addEventListener('astro:page-load', () => {
    setupTheme();
    setupLang();
  });
</script>

<style>
  @media (max-width: 768px) {
    body {
      padding-bottom: 130px;
    }
  }
  @media (max-width: 380px) {
    body {
      padding-bottom: 140px;
    }
  }
  a, button {
    -webkit-tap-highlight-color: transparent;
  }
</style>