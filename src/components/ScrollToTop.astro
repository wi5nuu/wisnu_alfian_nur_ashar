---
import { ArrowUp } from "lucide-astro";
---

<button
  id="scroll-to-top"
  class="fixed bottom-6 left-6 z-[100] p-3 bg-slate-900/80 backdrop-blur-md text-white rounded-full shadow-lg border border-white/10 opacity-0 translate-y-10 pointer-events-none transition-all duration-500 hover:bg-slate-800 hover:scale-110 active:scale-90 group"
  aria-label="Scroll to top"
>
  <ArrowUp class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-1" />
</button>

<script>
  let _scrollCleanup: (() => void) | null = null;

  const initScrollToTop = () => {
    // Cleanup previous listener for BFCache
    if (_scrollCleanup) _scrollCleanup();

    const scrollBtn = document.getElementById("scroll-to-top");
    if (!scrollBtn) return;

    let ticking = false;
    const toggleScrollBtn = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 300) {
            scrollBtn.classList.remove("opacity-0", "translate-y-10", "pointer-events-none");
            scrollBtn.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
          } else {
            scrollBtn.classList.add("opacity-0", "translate-y-10", "pointer-events-none");
            scrollBtn.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener("scroll", toggleScrollBtn, { passive: true });
    
    _scrollCleanup = () => {
      window.removeEventListener("scroll", toggleScrollBtn);
    };
    
    scrollBtn.onclick = () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    };
  };

  // Initialize on first load and subsequent view transition page loads
  initScrollToTop();
  document.addEventListener("astro:page-load", initScrollToTop);
  
  // BFCache safe — clean up on page hide
  window.addEventListener("pagehide", () => { if (_scrollCleanup) _scrollCleanup(); });
</script>
