---
import { faq } from "../data/faq";

const isId = Astro.url.pathname.startsWith('/id');
const t = faq[isId ? 'id' : 'en'];
---

<section class="faq" id="faq" aria-labelledby="faq-heading">
  <div class="faq-wrap">
    <header class="faq-head reveal-up">
      <div class="faq-badge"><span></span>{t.badge}</div>
      <h2 id="faq-heading">{t.title[0]}<br />{t.title[1]}</h2>
    </header>

    <div class="faq-list">
      {t.items.map((item, i) => (
        <details class="faq-item reveal-up" style={`transition-delay:${Math.min(i, 4) * 60}ms`} open={i === 0}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: #0A0A0A; color: #fff; padding: clamp(56px, 8vw, 96px) clamp(16px, 3vw, 40px); font-family: var(--font-sans); }
  .faq-wrap { max-width: 880px; margin-inline: auto; }
  .faq-head { margin-bottom: 28px; }
  .faq-badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.3); border-radius: 999px; padding: 6px 16px; font-size: 12.5px; font-weight: 500; letter-spacing: 0.03em; }
  .faq-badge span { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .faq h2 { margin: 14px 0 0; color: #fff; font-family: var(--font-sans); font-size: clamp(28px, 3.2vw, 46px); font-weight: 500; letter-spacing: -0.01em; line-height: 1.1; }

  .faq-list { display: grid; gap: 10px; }
  .faq-item { border: 1px solid rgba(255,255,255,0.12); border-radius: 18px; background: rgba(255,255,255,0.03); transition: border-color 0.25s, background 0.25s; }
  .faq-item[open] { border-color: rgba(132,225,12,0.5); background: rgba(132,225,12,0.04); }
  .faq-item summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; cursor: pointer; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 18px; }
  .faq-q { font-size: 16px; font-weight: 500; line-height: 1.35; color: #fff; }
  .faq-plus { position: relative; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.25); transition: transform 0.3s ease, background 0.3s, border-color 0.3s; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: #fff; transform: translate(-50%, -50%); transition: transform 0.3s, background 0.3s; }
  .faq-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-item[open] .faq-plus { background: var(--accent); border-color: var(--accent); transform: rotate(180deg); }
  .faq-item[open] .faq-plus::before, .faq-item[open] .faq-plus::after { background: #0A0A0A; }
  .faq-item[open] .faq-plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-item p { margin: 0; padding: 0 20px 20px; color: rgba(255,255,255,0.72); font-size: 14.5px; line-height: 1.7; max-width: 70ch; }
  @media (prefers-reduced-motion: reduce) { .faq-plus, .faq-plus::before, .faq-plus::after { transition: none; } }
</style>
