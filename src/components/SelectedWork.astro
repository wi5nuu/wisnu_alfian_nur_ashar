---
import { CornerDownRight } from "lucide-astro";
import { profile as profileEn } from "../data/profile";
import { profile as profileId } from "../data/profile_id";
import ProjectDetailModal from "./ProjectDetailModal.astro";

const isId = Astro.url.pathname.startsWith('/id');
const profile = isId ? profileId : profileEn;

// Get first 5 projects
const selectedProjects = profile.projects.slice(0, 5);
---

<section class="selected-work">
  <div class="header-block">
    <div class="badge">
      <div class="badge-dot"></div>
      <span class="badge-text">{isId ? 'KARYA PILIHAN 2024–2026' : 'SELECTED WORK 2024–2026'}</span>
    </div>

    <h2 class="heading">
      {isId ? 'Membangun Solusi' : 'Building Solutions'}<br />
      {isId ? 'dengan Rekayasa Terbaik' : 'with Engineering Excellence'}
    </h2>
  </div>

  <div class="project-grid">
    {selectedProjects.map((project, index) => (
      <button
        class="project-card group"
        style={`transition-delay: ${index * 100}ms`}
        onclick={`openProjectModal('project-detail-modal', ${JSON.stringify({
          title: project.title,
          role: project.role,
          description: project.description,
          techStack: project.techStack,
          image: project.image || '/projects/placeholder.webp',
          link: project.link,
          github: project.github || '',
        })})`}
      >
        <div class="project-image-wrap">
          <img src={project.image || "/projects/placeholder.webp"} alt={project.title} class="project-image" loading="lazy" />
        </div>
        <div class="project-content">
          <h3 class="project-title">{project.title}</h3>
          <p class="project-role">{project.role}</p>
          <p class="project-desc">{project.description}</p>
          <div class="project-footer">
            <span class="project-status">{project.status}</span>
            <span class="project-badge">{isId ? 'Lihat Detail' : 'Details'}</span>
          </div>
        </div>
      </button>
    ))}
  </div>

  <div class="bottom-cta">
    <a href={isId ? '/id/projects' : '/projects'} class="cta-button group">
      <CornerDownRight class="icon-cta" />
      <span>{isId ? 'Lihat semua karya' : 'Browse all work'}</span>
    </a>
  </div>
</section>

<ProjectDetailModal id="project-detail-modal" />

<style>
  .selected-work {
    background-color: var(--bg);
    color: #ffffff;
    height: auto;
    padding-inline: clamp(20px, 3vw, 40px);
    padding-block: 80px 100px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .badge-text {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #ffffff;
    font-weight: 400;
  }

  .header-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .heading {
    color: #ffffff;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.08;
    margin-top: 12px;
    margin-bottom: 0;
  }

  .project-grid {
    margin-top: 72px;
    display: grid;
    /* Ubah ke 5 kolom di desktop */
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    /* Lebarkan sedikit grid agar 5 card muat dengan nyaman */
    max-width: 1440px;
    margin-inline: auto;
  }

  .project-card {
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    width: 100%;
    padding: 0;
    text-align: left;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.3s ease, transform 0.3s ease;
    min-width: 0;
  }

  .project-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .project-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-content {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .project-title {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.4;
  }

  .project-role {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .project-desc {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 2px;
  }

  .project-status {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .project-badge {
    font-size: 10px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bottom-cta {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }

  .cta-button {
    background-color: var(--accent);
    color: #0A0A0A;
    border-radius: 999px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: filter 0.3s ease;
  }

  .cta-button:hover {
    filter: brightness(1.1);
  }

  .icon-cta {
    width: 16px;
    height: 16px;
    color: #0A0A0A;
  }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .heading {
      font-size: 36px;
    }
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 4px;
    }

    .project-grid::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .project-card {
      flex: 0 0 78%;
      max-width: 320px;
      scroll-snap-align: start;
    }
  }
</style>
