---
import { X, Send, Maximize2, Minimize2 } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
---

<div id="ai-chat-widget" class="z-[110] font-sans">
    <!-- Desktop Toggle Button -->
    <button
        id="chat-toggle-desktop"
        class="hidden md:flex fixed bottom-6 right-6 group bg-slate-900 hover:bg-slate-800 text-white p-2 pr-4 pl-2 rounded-full shadow-lg transition-all duration-300 hover:scale-105 active:scale-95 z-50 items-center gap-3 border border-slate-700/50"
        aria-label={isId ? 'Buka Asisten AI' : 'Toggle AI Assistant'}
    >
        <div class="relative">
            <img
                src="/wisnu-alfian.webp"
                alt="AI"
                width="40"
                height="40"
                class="w-10 h-10 rounded-full object-cover border-2 border-white/20 aspect-square"
                loading="lazy"
                decoding="async"
            />
            <div
                class="absolute top-0 right-0 w-3 h-3 bg-blue-500 rounded-full ai-status-dot border-2 border-slate-900"
            >
            </div>
        </div>

        <div class="flex flex-col items-start">
            <span class="text-sm font-bold text-white leading-tight"
                >{isId ? 'AI Wisnu' : "Wisnu's AI"}</span
            >
            <span class="text-[10px] text-slate-400 font-medium"
                >{isId ? 'Ngobrol dengan saya' : 'Chat with me'}</span
            >
        </div>
    </button>

    <!-- Mobile toggle dihapus — AI diakses lewat ikon di bottom-nav (Navbar) -->

    <div
        id="chat-window"
        class="fixed bottom-24 md:bottom-24 right-4 left-4 md:left-auto md:right-6 w-auto md:w-[380px] bg-white/95 backdrop-blur-xl rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-white/20 transform scale-95 opacity-0 pointer-events-none transition-all duration-500 cubic-bezier(0.34, 1.56, 0.64, 1) origin-bottom-right overflow-hidden flex flex-col max-h-[60vh] md:max-h-[500px] z-[120]"
    >
        <div
            class="bg-slate-900/90 backdrop-blur-md p-4 flex items-center justify-between text-white shrink-0 relative overflow-hidden"
        >
            <div
                class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"
            >
            </div>

            <div class="flex items-center gap-3 relative z-10">
                    <div class="relative">
                    <img
                        src="/wisnu-alfian.webp"
                        alt={isId ? 'Avatar Asisten AI' : 'AI Avatar'}
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-full object-cover border-2 border-white/20 shadow-sm aspect-square"
                        loading="lazy"
                        decoding="async"
                    />
                    <div
                        class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-slate-900 ai-status-dot"
                    >
                    </div>
                </div>
                <div>
                    <h3 class="font-bold text-sm text-white">
                        Wisnu Alfian
                    </h3>
                    <p
                        class="text-[10px] text-blue-300 uppercase tracking-wider font-semibold"
                    >
                        Online
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 relative z-10">
                <button
                    id="chat-fullscreen-toggle"
                    class="p-2 hover:bg-white/10 rounded-full transition-all duration-300 text-white/80 hover:text-white"
                    aria-label={isId ? 'Layar penuh' : 'Toggle fullscreen'}
                    title={isId ? 'Layar penuh' : 'Toggle fullscreen'}
                >
                    <Maximize2 class="w-5 h-5 fullscreen-icon-expand" />
                    <Minimize2 class="w-5 h-5 fullscreen-icon-collapse hidden" />
                </button>
                <button
                    id="chat-close"
                    class="p-2 hover:bg-white/10 rounded-full transition-all duration-300 text-white/80 hover:text-white hover:rotate-90"
                    aria-label={isId ? 'Tutup chat' : 'Close chat'}
                >
                    <X class="w-5 h-5" />
                </button>
            </div>
        </div>

        <div
            id="chat-messages"
            class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-50/30 h-[350px] scroll-smooth text-slate-900"
        >
            <div class="flex gap-3 items-start animate-fade-in">
                <img
                    src="/wisnu-alfian.webp"
                    alt="AI"
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                    class="w-8 h-8 min-w-[2rem] min-h-[2rem] max-w-[2rem] max-h-[2rem] rounded-full object-cover border border-slate-200 shrink-0 shadow-sm aspect-square self-start"
                />
                <div
                    class="bg-white p-3 rounded-2xl rounded-tl-sm shadow-[0_2px_10px_rgba(0,0,0,0.05)] border border-slate-100 text-sm text-slate-800 leading-relaxed"
                >
                    {isId ? (
                        <>
                            Halo! 👋 Saya <strong>Wisnu Alfian Nur Ashar</strong>, seorang <strong>mahasiswa IT di President University</strong> dengan spesialisasi <strong>Full-Stack Engineering</strong> dan <strong>1.500+ kontribusi GitHub</strong> di 90+ repositori.<br><br>

                            Saya telah membangun sistem production yang melayani <strong>15.000+ pengguna</strong>, termasuk platform ERP/POS, serta berkontribusi ke proyek open-source di <strong>NASA, Microsoft, Google, dan NVIDIA</strong>. Saat ini <strong>Web Development Intern di GAOTEK INC (New York)</strong> dan sedang aktif mencari <strong>peluang full-time</strong>.<br><br>

                            💻 <strong>Tech Stack:</strong> Laravel, Next.js, React, TypeScript, PostgreSQL, Go, Python, AWS<br>
                            🏆 <strong>Prestasi Terbaru:</strong> Juara 1 Web Developer - TechSprint Innovation Cup 2026<br><br>

                            Tanyakan apa saja tentang proyek, pengalaman, atau keahlian teknis saya!
                        </>
                    ) : (
                        <>
                            Hi! 👋 I'm <strong>Wisnu Alfian Nur Ashar</strong>, an <strong>IT student at President University</strong> specializing in <strong>Full-Stack Engineering</strong> with <strong>1,500+ GitHub contributions</strong> across 90+ repositories.<br><br>

                            I've built production systems serving <strong>15,000+ users</strong> including an ERP/POS platform, and contributed to open-source projects at <strong>NASA, Microsoft, Google, and NVIDIA</strong>. Currently a <strong>Web Development Intern at GAOTEK INC (New York)</strong> and actively seeking <strong>full-time opportunities</strong>.<br><br>

                            💻 <strong>Tech Stack:</strong> Laravel, Next.js, React, TypeScript, PostgreSQL, Go, Python, AWS<br>
                            🏆 <strong>Recent Win:</strong> 1st Place Web Developer - TechSprint Innovation Cup 2026<br><br>

                            Ask me anything about my projects, experience, or technical skills!
                        </>
                    )}
                </div>
            </div>
        </div>

        <form
            id="chat-form"
            class="p-3 border-t border-slate-100 bg-white/80 backdrop-blur-md flex gap-2 shrink-0"
        >
            <input
                type="text"
                id="chat-input"
                placeholder={isId ? 'Tanyakan apa saja tentang pengalaman, keahlian, atau proyek saya...' : 'Ask me anything about my experience, skills, or projects...'}
                class="flex-1 bg-slate-100 border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-slate-900/5 focus:outline-none placeholder:text-slate-500 transition-all"
                autocomplete="off"
            />
            <button
                type="submit"
                id="send-button"
                class="p-2 bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed active:scale-90 shadow-lg shadow-slate-900/10 relative"
                aria-label={isId ? 'Kirim pesan' : 'Send message'}
            >
                <Send class="w-4 h-4 send-icon" />
                <svg class="w-4 h-4 send-loading hidden animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </button>
        </form>
    </div>
</div>

<script>
    const isId = window.location.pathname.startsWith('/id');

    const initChatBot = () => {
        const desktopToggle = document.getElementById("chat-toggle-desktop");
        const closeBtn = document.getElementById("chat-close");
        const fullscreenToggle = document.getElementById("chat-fullscreen-toggle");
        const windowEl = document.getElementById("chat-window");
        const form = document.getElementById("chat-form") as HTMLFormElement;
        const input = document.getElementById("chat-input") as HTMLInputElement;
        const messagesContainer = document.getElementById("chat-messages");

        // Mobile trigger via event delegation (no global leak, BFCache-safe)
        const handleMobileTrigger = (e: MouseEvent) => {
            if ((e.target as Element).closest("#mobile-ai-trigger")) {
                e.preventDefault();
                toggleChat();
            }
        };
        document.body.addEventListener("click", handleMobileTrigger, { once: false });
        
        // Cleanup on page navigation to allow BFCache
        const cleanup = () => {
            document.body.removeEventListener("click", handleMobileTrigger);
        };
        document.addEventListener("astro:before-swap", cleanup, { once: true });
        window.addEventListener("pagehide", cleanup, { once: true });

        let isOpen = false;
        let isFullscreen = false;

        function toggleChat() {
            isOpen = !isOpen;
            if (isOpen) {
                windowEl?.classList.remove(
                    "scale-95",
                    "opacity-0",
                    "pointer-events-none",
                );
                windowEl?.classList.add(
                    "scale-100",
                    "opacity-100",
                    "pointer-events-auto",
                );
                
                // Auto-fullscreen on mobile devices
                if (window.innerWidth <= 768) {
                    setTimeout(() => {
                        toggleFullscreen();
                    }, 300);
                }
                
                setTimeout(() => input?.focus(), 300);
            } else {
                windowEl?.classList.add(
                    "scale-95",
                    "opacity-0",
                    "pointer-events-none",
                );
                windowEl?.classList.remove(
                    "scale-100",
                    "opacity-100",
                    "pointer-events-auto",
                );
                // Exit fullscreen when closing chat
                if (isFullscreen) {
                    toggleFullscreen();
                }
            }
        }

        function toggleFullscreen() {
            isFullscreen = !isFullscreen;
            const expandIcon = document.querySelector('.fullscreen-icon-expand');
            const collapseIcon = document.querySelector('.fullscreen-icon-collapse');
            
            if (isFullscreen) {
                // Enter fullscreen mode
                windowEl?.classList.add('chat-fullscreen');
                expandIcon?.classList.add('hidden');
                collapseIcon?.classList.remove('hidden');
            } else {
                // Exit fullscreen mode
                windowEl?.classList.remove('chat-fullscreen');
                expandIcon?.classList.remove('hidden');
                collapseIcon?.classList.add('hidden');
            }
        }

        if (desktopToggle) {
            desktopToggle.onclick = toggleChat;
        }

        if (closeBtn) {
            closeBtn.onclick = toggleChat;
        }

        if (fullscreenToggle) {
            fullscreenToggle.onclick = toggleFullscreen;
        }

        // Conversation history (keep last 10 messages for context)
        let conversationHistory: Array<{ role: string; content: string }> = [];

        const handleQuerySubmit = async (query: string) => {
            if (!query || !input || !messagesContainer) return;

            const sendButton = document.getElementById("send-button");
            const sendIcon = sendButton?.querySelector(".send-icon");
            const sendLoading = sendButton?.querySelector(".send-loading");

            // Show loading state
            if (sendButton) sendButton.disabled = true;
            if (sendIcon) sendIcon.classList.add("hidden");
            if (sendLoading) sendLoading.classList.remove("hidden");

            addMessage(query, "user");
            input.value = "";
            const typingId = showTypingIndicator();
            input.disabled = true;

            try {
                // Detect language (simple check: if contains Indonesian words, use 'id')
                const hasIndonesian = /\b(apa|siapa|dimana|kenapa|bagaimana|saya|kamu|anda|gue|lo)\b/i.test(query);
                const lang = hasIndonesian ? 'id' : 'en';

                // Call new OpenRouter-based API endpoint
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: query,
                        history: conversationHistory,
                        lang: lang
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
                    throw new Error(errorData.error || 'API request failed');
                }

                const data = await response.json();
                const aiResponse = data.response || (isId ? 'Maaf, ada error. Coba lagi ya!' : 'Sorry, an error occurred. Please try again!');

                // Add to conversation history
                conversationHistory.push(
                    { role: 'user', content: query },
                    { role: 'assistant', content: aiResponse }
                );

                // Keep only last 10 messages (5 exchanges)
                if (conversationHistory.length > 10) {
                    conversationHistory = conversationHistory.slice(-10);
                }

                // Calculate typing delay based on response length (2-4 seconds)
                const typingDelay = Math.min(Math.max(2000, aiResponse.length * 15), 4000);
                
                setTimeout(() => {
                    if (typingId) removeTypingIndicator(typingId);
                    addMessage(aiResponse, "ai");
                    if (input) {
                        input.disabled = false;
                        input.focus();
                    }
                    // Hide loading state
                    if (sendButton) sendButton.disabled = false;
                    if (sendIcon) sendIcon.classList.remove("hidden");
                    if (sendLoading) sendLoading.classList.add("hidden");
                }, typingDelay);
            } catch (error: any) {
                console.error("AI Error:", error);
                if (typingId) removeTypingIndicator(typingId);
                addMessage(error.message || (isId ? "Maaf, terjadi kesalahan. Coba lagi nanti." : "Sorry, something went wrong. Please try again later."), "ai");
                if (input) input.disabled = false;
                // Hide loading state on error
                if (sendButton) sendButton.disabled = false;
                if (sendIcon) sendIcon.classList.remove("hidden");
                if (sendLoading) sendLoading.classList.add("hidden");
            }
        };

        if (form) {
            form.onsubmit = (e) => {
                e.preventDefault();
                if (input) {
                    handleQuerySubmit(input.value.trim());
                }
            };
        }

        function addMessage(text: string, sender: "user" | "ai") {
            if (!messagesContainer) return;

            // Extract suggestions [[Suggestion]]
            const suggestions: string[] = [];
            const cleanText = text.replace(/\[\[(.*?)\]\]/g, (match, p1) => {
                suggestions.push(p1);
                return "";
            });

            const div = document.createElement("div");
            const isAi = sender === "ai";
            div.className = `flex gap-3 items-start ${isAi ? "animate-reveal-up" : "flex-row-reverse"}`;

            // Menggunakan IMG tag untuk AI, dan teks "You" untuk user
            const iconHtml = isAi
                ? `<img src="/wisnu-alfian.webp" alt="AI" class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0 shadow-sm" />`
                : `<div class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center shrink-0 text-white text-xs font-bold shadow-md">${isId ? 'Anda' : 'You'}</div>`;

            const bubbleClass = isAi
                ? "bg-white border border-slate-100 text-slate-800 rounded-tl-sm"
                : "bg-slate-900 text-white rounded-tr-sm shadow-indigo-500/10";

            // Security Patch: Simple escaping + Markdown-lite rendering
            const escapeHtml = (unsafe: string) => {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            };

            const renderMessage = (content: string) => {
                let escaped = escapeHtml(content);
                // Support Bold (**text**)
                escaped = escaped.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
                // Support Line Breaks
                return escaped.replace(/\n/g, "<br>");
            };

            div.innerHTML = `
                 ${iconHtml}
                 <div class="p-3 rounded-2xl shadow-sm max-w-[85%] text-[13px] leading-relaxed ${bubbleClass}">
                   ${renderMessage(cleanText.trim())}
                 </div>
               `;
            messagesContainer.appendChild(div);

            // Render Suggestions as clickable chips
            if (isAi && suggestions.length > 0) {
                const suggestionDiv = document.createElement("div");
                suggestionDiv.className =
                    "flex flex-wrap gap-2 mt-2 ml-11 mb-2 animate-reveal-up delay-300";

                suggestions.forEach((s) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.setAttribute("aria-label", s);
                    btn.className =
                        "px-3 py-1.5 bg-white border border-slate-200 rounded-full text-[11px] text-slate-500 hover:text-slate-900 hover:border-slate-900 transition-all active:scale-95 shadow-sm";
                    btn.innerHTML = s;
                    btn.onclick = () => {
                        handleQuerySubmit(s);
                    };
                    suggestionDiv.appendChild(btn);
                });
                messagesContainer.appendChild(suggestionDiv);
            }

            if (messagesContainer)
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showTypingIndicator() {
            if (!messagesContainer) return null;
            const id = "typing-" + Date.now();
            const div = document.createElement("div");
            div.id = id;
            div.className = "flex gap-3 items-start";
            
            // Create typing text with wave animation using DOM
            const text = isId ? "sedang mengetik" : "typing";
            const typingWrapper = document.createElement('span');
            typingWrapper.className = 'text-xs text-slate-500 italic typing-text-wrapper';
            
            // Add each character as a span with animation
            text.split('').forEach((char, index) => {
                const charSpan = document.createElement('span');
                if (char === ' ') {
                    charSpan.innerHTML = '&nbsp;';
                    charSpan.style.display = 'inline-block';
                } else {
                    charSpan.textContent = char;
                    charSpan.className = 'typing-char';
                    charSpan.style.animationDelay = `${index * 0.15}s`;
                }
                typingWrapper.appendChild(charSpan);
            });
            
            // Add ellipsis
            const ellipsis = document.createElement('span');
            ellipsis.className = 'typing-ellipsis';
            typingWrapper.appendChild(ellipsis);
            
            // Build the complete structure
            div.innerHTML = `
                 <img src="/wisnu-alfian.webp" alt="AI" class="w-8 h-8 min-w-[2rem] min-h-[2rem] max-w-[2rem] max-h-[2rem] rounded-full object-cover border border-slate-200 shrink-0 shadow-sm aspect-square self-start" />
                 <div class="bg-white px-4 py-3 rounded-2xl rounded-tl-sm border border-slate-100 shadow-sm flex flex-col gap-2">
                   <div class="typing-text-container"></div>
                   <div class="flex gap-1 items-center">
                     <span class="typing-dot"></span>
                     <span class="typing-dot"></span>
                     <span class="typing-dot"></span>
                   </div>
                 </div>`;
            
            // Append typing wrapper to container
            const container = div.querySelector('.typing-text-container');
            if (container) {
                container.appendChild(typingWrapper);
            }
            
            messagesContainer.appendChild(div);
            if (messagesContainer)
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return id;
        }
        function removeTypingIndicator(id: string) {
            document.getElementById(id)?.remove();
        }
    };

    // Initialize on first load and subsequent view transition page loads
    initChatBot();
    document.addEventListener("astro:page-load", initChatBot);
</script>

<style>
  /* Composited animation — hanya pakai opacity & transform agar tidak trigger reflow */
  .ai-status-dot {
    animation: ai-pulse 2s ease-in-out infinite;
  }

  @keyframes ai-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  /* Typing text animation container */
  .typing-text-wrapper {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  /* Wave animation for each character - MORE VISIBLE */
  .typing-char {
    display: inline-block !important;
    animation: typing-wave 0.8s ease-in-out infinite !important;
    transform-origin: center bottom;
    will-change: transform;
    font-style: italic;
  }

  @keyframes typing-wave {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  /* Animated ellipsis for "typing..." effect */
  .typing-ellipsis::after {
    content: '';
    animation: typing-ellipsis-animation 1.5s infinite;
  }

  @keyframes typing-ellipsis-animation {
    0% { content: ''; }
    25% { content: '.'; }
    50% { content: '..'; }
    75% { content: '...'; }
    100% { content: ''; }
  }

  /* WhatsApp-style typing indicator animation */
  .typing-dot {
    width: 8px;
    height: 8px;
    background-color: #94a3b8;
    border-radius: 50%;
    display: inline-block;
    animation: typing-bounce 1.4s infinite ease-in-out;
  }

  .typing-dot:nth-child(1) {
    animation-delay: 0s;
  }

  .typing-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.7;
    }
    30% {
      transform: translateY(-10px);
      opacity: 1;
    }
  }

  /* Fullscreen mode styling */
  .chat-fullscreen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
    transform: scale(1) !important;
    z-index: 9999 !important;
  }

  .chat-fullscreen #chat-messages {
    height: calc(100vh - 140px) !important;
    max-height: calc(100vh - 140px) !important;
  }

  /* Hide scroll to top button when chat is fullscreen */
  .chat-fullscreen ~ #scroll-to-top {
    display: none;
  }
</style>
