---
import { X, Send } from "lucide-astro";
---

<div id="ai-chat-widget" class="z-[110] font-sans">
    <button
        id="chat-toggle-desktop"
        class="hidden md:flex fixed bottom-6 right-6 group bg-slate-900 hover:bg-slate-800 text-white p-2 pr-4 pl-2 rounded-full shadow-lg transition-all duration-300 hover:scale-105 active:scale-95 z-50 items-center gap-3 border border-slate-700/50"
        aria-label="Toggle AI Assistant"
    >
        <div class="relative">
            <img
                src="/logo.png"
                alt="AI"
                loading="lazy"
                decoding="async"
                class="w-10 h-10 rounded-full object-cover border-2 border-white/20"
            />
            <div
                class="absolute top-0 right-0 w-3 h-3 bg-blue-500 rounded-full animate-pulse border-2 border-slate-900"
            >
            </div>
        </div>

        <div class="flex flex-col items-start">
            <span class="text-sm font-bold text-white leading-tight"
                >Wisnu's AI</span
            >
            <span class="text-[10px] text-slate-400 font-medium"
                >Chat with me</span
            >
        </div>
    </button>

    <div
        id="chat-window"
        class="fixed bottom-28 md:bottom-24 right-4 left-4 md:left-auto md:right-6 w-auto md:w-[380px] bg-white/95 backdrop-blur-xl rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-white/20 transform scale-95 opacity-0 pointer-events-none transition-all duration-500 cubic-bezier(0.34, 1.56, 0.64, 1) origin-bottom-right overflow-hidden flex flex-col max-h-[60vh] md:max-h-[500px] z-[120]"
    >
        <div
            class="bg-slate-900/90 backdrop-blur-md p-4 flex items-center justify-between text-white shrink-0 relative overflow-hidden"
        >
            <div
                class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"
            >
            </div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="relative">
                    <img
                        src="/logo.png"
                        alt="AI Avatar"
                        loading="lazy"
                        decoding="async"
                        class="w-10 h-10 rounded-full object-cover border-2 border-white/20 shadow-sm"
                    />
                    <div
                        class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-slate-900 animate-pulse"
                    >
                    </div>
                </div>
                <div>
                    <h3 class="font-bold text-sm text-white">
                        Wisnu's Career Coach
                    </h3>
                    <p
                        class="text-[10px] text-blue-300 uppercase tracking-wider font-semibold"
                    >
                        Online
                    </p>
                </div>
            </div>
            <button
                id="chat-close"
                class="p-2 hover:bg-white/10 rounded-full transition-all duration-300 relative z-10 text-white/80 hover:text-white hover:rotate-90"
            >
                <X class="w-5 h-5" />
            </button>
        </div>

        <div
            id="chat-messages"
            class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-50/30 h-[350px] scroll-smooth"
        >
            <div class="flex gap-3 animate-fade-in">
                <img
                    src="/logo.png"
                    alt="AI"
                    loading="lazy"
                    decoding="async"
                    class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0 shadow-sm"
                />
                <div
                    class="bg-white p-3 rounded-2xl rounded-tl-sm shadow-[0_2px_10px_rgba(0,0,0,0.05)] border border-slate-100 text-sm text-slate-600 leading-relaxed"
                >
                    Hi! I'm Wisnu's <strong>International Career Coach</strong>.
                    Ask me about his <strong>skills</strong>, <strong
                        >projects</strong
                    >, or how he's prepared for <strong>overseas work</strong>!
                </div>
            </div>
        </div>

        <form
            id="chat-form"
            class="p-3 border-t border-slate-100 bg-white/80 backdrop-blur-md flex gap-2 shrink-0"
        >
            <input
                type="text"
                id="chat-input"
                placeholder="Ask about careers, projects..."
                class="flex-1 bg-slate-100/50 border-none rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-slate-900/5 focus:outline-none placeholder:text-slate-400 transition-all"
                autocomplete="off"
            />
            <button
                type="submit"
                class="p-2 bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-all duration-300 disabled:opacity-50 active:scale-90 shadow-lg shadow-slate-900/10"
            >
                <Send class="w-4 h-4" />
            </button>
        </form>
    </div>
</div>

<script>
    import { AIService } from "../utils/AIService";

    const initChatBot = () => {
        const desktopToggle = document.getElementById("chat-toggle-desktop");
        const closeBtn = document.getElementById("chat-close");
        const windowEl = document.getElementById("chat-window");
        const form = document.getElementById("chat-form") as HTMLFormElement;
        const input = document.getElementById("chat-input") as HTMLInputElement;
        const messagesContainer = document.getElementById("chat-messages");

        // Clean up mobile trigger listener if it was previously added
        const handleMobileTrigger = (e: MouseEvent) => {
            if ((e.target as Element).closest("#mobile-ai-trigger")) {
                e.preventDefault();
                toggleChat();
            }
        };
        document.body.removeEventListener("click", (window as any)._mobileTriggerHandler);
        (window as any)._mobileTriggerHandler = handleMobileTrigger;
        document.body.addEventListener("click", handleMobileTrigger);

        let isOpen = false;

        function toggleChat() {
            isOpen = !isOpen;
            if (isOpen) {
                windowEl?.classList.remove(
                    "scale-95",
                    "opacity-0",
                    "pointer-events-none",
                );
                windowEl?.classList.add(
                    "scale-100",
                    "opacity-100",
                    "pointer-events-auto",
                );
                setTimeout(() => input?.focus(), 300);
            } else {
                windowEl?.classList.add(
                    "scale-95",
                    "opacity-0",
                    "pointer-events-none",
                );
                windowEl?.classList.remove(
                    "scale-100",
                    "opacity-100",
                    "pointer-events-auto",
                );
            }
        }

        if (desktopToggle) {
            desktopToggle.onclick = toggleChat;
        }

        if (closeBtn) {
            closeBtn.onclick = toggleChat;
        }

        const handleQuerySubmit = async (query: string) => {
            if (!query || !input || !messagesContainer) return;

            addMessage(query, "user");
            input.value = "";
            const typingId = showTypingIndicator();
            input.disabled = true;

            try {
                // Get response from service
                const response = await AIService.getResponse(query);

                // Professional 3-second delay
                setTimeout(() => {
                    if (typingId) removeTypingIndicator(typingId);
                    addMessage(response, "ai");
                    if (input) {
                        input.disabled = false;
                        input.focus();
                    }
                }, 3000);
            } catch (error) {
                console.error("AI Error:", error);
                if (typingId) removeTypingIndicator(typingId);
                addMessage("Maaf, terjadi kesalahan. Coba lagi nanti.", "ai");
                if (input) input.disabled = false;
            }
        };

        if (form) {
            form.onsubmit = (e) => {
                e.preventDefault();
                if (input) {
                    handleQuerySubmit(input.value.trim());
                }
            };
        }

        function addMessage(text: string, sender: "user" | "ai") {
            if (!messagesContainer) return;

            // Extract suggestions [[Suggestion]]
            const suggestions: string[] = [];
            const cleanText = text.replace(/\[\[(.*?)\]\]/g, (match, p1) => {
                suggestions.push(p1);
                return "";
            });

            const div = document.createElement("div");
            const isAi = sender === "ai";
            div.className = `flex gap-3 ${isAi ? "animate-reveal-up" : "flex-row-reverse"}`;

            // Menggunakan IMG tag untuk AI, dan teks "You" untuk user
            const iconHtml = isAi
                ? `<img src="/logo.png" alt="AI" class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0 shadow-sm" />`
                : `<div class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center shrink-0 text-white text-xs font-bold shadow-md">You</div>`;

            const bubbleClass = isAi
                ? "bg-white border border-slate-100 text-slate-600 rounded-tl-sm"
                : "bg-slate-900 text-white rounded-tr-sm shadow-indigo-500/10";

            // Security Patch: Simple escaping + Markdown-lite rendering
            const escapeHtml = (unsafe: string) => {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            };

            const renderMessage = (content: string) => {
                let escaped = escapeHtml(content);
                // Support Bold (**text**)
                escaped = escaped.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
                // Support Line Breaks
                return escaped.replace(/\n/g, "<br>");
            };

            div.innerHTML = `
                 ${iconHtml}
                 <div class="p-3 rounded-2xl shadow-sm max-w-[85%] text-[13px] leading-relaxed ${bubbleClass}">
                   ${renderMessage(cleanText.trim())}
                 </div>
               `;
            messagesContainer.appendChild(div);

            // Render Suggestions as clickable chips
            if (isAi && suggestions.length > 0) {
                const suggestionDiv = document.createElement("div");
                suggestionDiv.className =
                    "flex flex-wrap gap-2 mt-2 ml-11 mb-2 animate-reveal-up delay-300";

                suggestions.forEach((s) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className =
                        "px-3 py-1.5 bg-white border border-slate-200 rounded-full text-[11px] text-slate-500 hover:text-slate-900 hover:border-slate-900 transition-all active:scale-95 shadow-sm";
                    btn.innerHTML = s;
                    btn.onclick = () => {
                        handleQuerySubmit(s);
                    };
                    suggestionDiv.appendChild(btn);
                });
                messagesContainer.appendChild(suggestionDiv);
            }

            if (messagesContainer)
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showTypingIndicator() {
            if (!messagesContainer) return null;
            const id = "typing-" + Date.now();
            const div = document.createElement("div");
            div.id = id;
            div.className = "flex gap-3";
            // Menggunakan IMG tag untuk indikator typing juga
            div.innerHTML = `
                 <img src="/logo.png" alt="AI" class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0 shadow-sm" />
                 <div class="bg-white p-3 rounded-2xl flex gap-1 items-center h-10 border border-slate-100 shadow-sm">
                   <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce"></span>
                   <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce delay-75"></span>
                   <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce delay-150"></span>
                 </div>`;
            messagesContainer.appendChild(div);
            if (messagesContainer)
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return id;
        }
        function removeTypingIndicator(id: string) {
            document.getElementById(id)?.remove();
        }
    };

    // Initialize on first load and subsequent view transition page loads
    initChatBot();
    document.addEventListener("astro:page-load", initChatBot);
</script>
