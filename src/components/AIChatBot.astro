---
import { X, Send, Maximize2, Minimize2 } from "lucide-astro";

const isId = Astro.url.pathname.startsWith('/id');
const t = isId
  ? {
      open: 'Buka Asisten AI', name: 'AI Wisnu', sub: 'Ngobrol dengan saya', close: 'Tutup chat', full: 'Layar penuh',
      send: 'Kirim pesan', ph: 'Tanya soal proyek, keahlian, atau pengalaman…', status: 'Online · asisten AI', ava: 'Avatar Asisten AI',
      starters: ['Proyek terbaik kamu?', 'Keahlian cyber security', 'Tersedia untuk magang?', 'Cara menghubungi'],
    }
  : {
      open: 'Toggle AI Assistant', name: "Wisnu's AI", sub: 'Chat with me', close: 'Close chat', full: 'Toggle fullscreen',
      send: 'Send message', ph: 'Ask about projects, skills or experience…', status: 'Online · AI assistant', ava: 'AI avatar',
      starters: ['Best projects?', 'Cyber security skills', 'Open to internships?', 'How to contact you'],
    };
---

<div id="ai-chat-widget" class="aic">
    <!-- Desktop launcher (mobile uses the AI icon in the bottom nav) -->
    <button id="chat-toggle-desktop" class="aic-fab" aria-label={t.open} aria-expanded="false" aria-controls="chat-window" type="button">
        <span class="aic-ava">
            <img src="/wisnu-avatar-96.webp" alt="" width="40" height="40" loading="lazy" decoding="async" />
            <i class="aic-dot" aria-hidden="true"></i>
        </span>
        <span class="aic-fab-txt"><b>{t.name}</b><small>{t.sub}</small></span>
    </button>

    <section id="chat-window" class="aic-win" role="dialog" aria-label={t.name} aria-hidden="true">
        <header class="aic-head">
            <span class="aic-ava">
                <img src="/wisnu-avatar-96.webp" alt={t.ava} width="40" height="40" loading="lazy" decoding="async" />
                <i class="aic-dot" aria-hidden="true"></i>
            </span>
            <div class="aic-head-txt">
                <h3>Wisnu Alfian</h3>
                <p>{t.status}</p>
            </div>
            <button id="chat-fullscreen-toggle" class="aic-icon" aria-label={t.full} title={t.full} type="button">
                <Maximize2 class="fullscreen-icon-expand" size={18} />
                <Minimize2 class="fullscreen-icon-collapse" size={18} style="display:none" />
            </button>
            <button id="chat-close" class="aic-icon" aria-label={t.close} type="button">
                <X size={18} />
            </button>
        </header>

        <div id="chat-messages" class="aic-msgs" role="log" aria-live="polite">
            <div class="aic-msg aic-msg--ai">
                <img src="/wisnu-avatar-96.webp" alt="" width="32" height="32" loading="lazy" decoding="async" class="aic-msg-av" />
                <div class="aic-bubble">
                    {isId ? (
                        <>
                            Halo! 👋 Saya <strong>Wisnu Alfian Nur Ashar</strong>, seorang <strong>mahasiswa IT di President University</strong> dengan spesialisasi <strong>Full-Stack Engineering</strong> dan <strong>3.300+ kontribusi GitHub</strong> di 100+ repositori.<br><br>

                            Saya telah membangun sistem production yang melayani <strong>ribuan pelanggan melalui website toko saya</strong>, termasuk platform ERP/POS, serta berkontribusi ke proyek open-source di <strong>NASA, Microsoft, Google, dan NVIDIA</strong>. Saat ini <strong>Web Development Intern di GAOTEK INC (New York)</strong> dan sedang aktif mencari <strong>peluang full-time</strong>.<br><br>

                            💻 <strong>Tech Stack:</strong> Laravel, Next.js, React, TypeScript, PostgreSQL, Go, Python, AWS<br>
                            🏆 <strong>Prestasi Terbaru:</strong> Juara 1 Web Developer - TechSprint Innovation Cup 2026<br><br>

                            Tanyakan apa saja tentang proyek, pengalaman, atau keahlian teknis saya!<br><br>
                            Btw, aku bicara dengan siapa nih? Boleh sebut nama / nama lengkap? Siapa tahu kita teman 😊
                        </>
                    ) : (
                        <>
                            Hi! 👋 I'm <strong>Wisnu Alfian Nur Ashar</strong>, an <strong>IT student at President University</strong> specializing in <strong>Full-Stack Engineering</strong> with <strong>3,300+ GitHub contributions</strong> across 100+ repositories.<br><br>

                            I've built production systems serving <strong>thousands of customers through my store website</strong> including an ERP/POS platform, and contributed to open-source projects at <strong>NASA, Microsoft, Google, and NVIDIA</strong>. Currently a <strong>Web Development Intern at GAOTEK INC (New York)</strong> and actively seeking <strong>full-time opportunities</strong>.<br><br>

                            💻 <strong>Tech Stack:</strong> Laravel, Next.js, React, TypeScript, PostgreSQL, Go, Python, AWS<br>
                            🏆 <strong>Recent Win:</strong> 1st Place Web Developer - TechSprint Innovation Cup 2026<br><br>

                            Ask me anything about my projects, experience, or technical skills!<br><br>
                            Btw, who am I talking to? Feel free to tell me your name / full name — maybe we're friends 😊
                        </>
                    )}
                </div>
            </div>
        </div>

            <div class="aic-starters aic-starters--dock" id="chat-starters">
                {t.starters.map((s) => <button type="button" class="aic-chip" data-q={s}>{s}</button>)}
            </div>

        <form id="chat-form" class="aic-form" autocomplete="off">
            <input type="text" id="chat-input" placeholder={t.ph} aria-label={t.ph} autocomplete="off" enterkeyhint="send" />
            <button type="submit" id="send-button" class="aic-send" aria-label={t.send}>
                <Send size={17} class="send-icon" />
                <svg class="send-loading" width="17" height="17" viewBox="0 0 24 24" fill="none" style="display:none" aria-hidden="true">
                    <circle opacity=".25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path opacity=".85" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
            </button>
        </form>
    </section>
</div>

<script>
    const isId = window.location.pathname.startsWith('/id');
    let ctl: AbortController | null = null;

    const initChatBot = () => {
        // one set of listeners per page: abort the previous page's before binding new ones
        ctl?.abort();
        ctl = new AbortController();
        const { signal } = ctl;

        const desktopToggle = document.getElementById("chat-toggle-desktop");
        const closeBtn = document.getElementById("chat-close");
        const fullscreenToggle = document.getElementById("chat-fullscreen-toggle");
        const windowEl = document.getElementById("chat-window");
        const form = document.getElementById("chat-form") as HTMLFormElement;
        const input = document.getElementById("chat-input") as HTMLInputElement;
        const messagesContainer = document.getElementById("chat-messages");
        const starters = document.getElementById("chat-starters");

        // Mobile trigger via event delegation (BFCache-safe)
        document.body.addEventListener("click", (e) => {
            if ((e.target as Element).closest("#mobile-ai-trigger")) {
                e.preventDefault();
                toggleChat();
            }
        }, { signal });

        let isOpen = false;
        let isFullscreen = false;

        function toggleChat() {
            isOpen = !isOpen;
            const aiTrigger = document.getElementById("mobile-ai-trigger");
            windowEl?.classList.toggle("is-open", isOpen);
            windowEl?.setAttribute("aria-hidden", String(!isOpen));
            desktopToggle?.setAttribute("aria-expanded", String(isOpen));
            aiTrigger?.classList.toggle("bottom-nav-item--active", isOpen);
            if (isOpen) {
                // Fullscreen langsung di mobile
                if (window.innerWidth <= 768 && !isFullscreen) setFullscreen(true);
                setTimeout(() => input?.focus({ preventScroll: true }), 250);
            } else if (isFullscreen) {
                setFullscreen(false);
            }
        }

        function setFullscreen(on: boolean) {
            isFullscreen = on;
            const expandIcon = document.querySelector<HTMLElement>('.fullscreen-icon-expand');
            const collapseIcon = document.querySelector<HTMLElement>('.fullscreen-icon-collapse');
            windowEl?.classList.toggle('chat-fullscreen', on);
            document.documentElement.classList.toggle('aic-lock', on);
            if (expandIcon) expandIcon.style.display = on ? 'none' : '';
            if (collapseIcon) collapseIcon.style.display = on ? '' : 'none';
            if (!on && windowEl) {
                windowEl.style.height = "";
                windowEl.style.top = "";
            }
            onViewportResize();
        }

        // Jaga chat tetap di atas keyboard saat mobile
        const viewport = window.visualViewport;
        const onViewportResize = () => {
            if (!windowEl || !viewport) return;
            if (isFullscreen) {
                windowEl.style.height = viewport.height + "px";
                windowEl.style.top = viewport.offsetTop + "px";
            }
        };
        viewport?.addEventListener("resize", onViewportResize, { signal });
        viewport?.addEventListener("scroll", onViewportResize, { signal });

        desktopToggle?.addEventListener("click", toggleChat, { signal });
        closeBtn?.addEventListener("click", toggleChat, { signal });
        fullscreenToggle?.addEventListener("click", () => setFullscreen(!isFullscreen), { signal });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && isOpen) toggleChat();
        }, { signal });
        // never leave scroll locked if the page is swapped while the chat is fullscreen
        signal.addEventListener("abort", () => document.documentElement.classList.remove('aic-lock'));

        // Conversation history (keep last 10 messages for context)
        // Khusus kekasih: history + status verifikasi disimpan di HP dia (localStorage)
        // agar AI selalu ingat di kunjungan berikutnya. Pengunjung umum TETAP stateless.
        let conversationHistory: Array<{ role: string; content: string }> = [];
        const GF_KEY = 'wisnu_ai_girlfriend';
        const GF_HIST = 'wisnu_ai_girlfriend_history';

        const containsGirlfriendNameLocal = (q: string) => {
            const s = ` ${(q || '').toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim()} `;
            return s.includes(' sitti ') && s.includes('nurfadhila') && s.includes(' zahra ') && s.includes(' syam ')
                && s.indexOf('sitti') < s.indexOf('nurfadhila')
                && s.indexOf('nurfadhila') < s.indexOf('zahra')
                && s.indexOf('zahra') < s.indexOf('syam');
        };

        // Restore sesi kekasih dari HP dia (jika pernah terverifikasi)
        try {
            if (localStorage.getItem(GF_KEY) === '1') {
                const saved = JSON.parse(localStorage.getItem(GF_HIST) || '[]');
                if (Array.isArray(saved) && saved.length > 0) {
                    conversationHistory = saved.slice(-20);
                }
                setTimeout(() => {
                    addMessage(isId
                        ? 'Hai sayang 🥰 Aku masih ingat kamu dari HP ini. Kangen? Cerita aja, aku dengerin dengan manja~ 💕'
                        : 'Hi my love 🥰 I still remember you on this phone. Miss me? Tell me anything~ 💕', 'ai');
                }, 800);
            }
        } catch { /* abaikan jika localStorage tidak tersedia */ }

        const setBusy = (busy: boolean) => {
            const sendButton = document.getElementById("send-button") as HTMLButtonElement | null;
            const sendIcon = sendButton?.querySelector<HTMLElement>(".send-icon");
            const sendLoading = sendButton?.querySelector<HTMLElement>(".send-loading");
            if (sendButton) sendButton.disabled = busy;
            if (sendIcon) sendIcon.style.display = busy ? "none" : "";
            if (sendLoading) sendLoading.style.display = busy ? "" : "none";
            if (input) {
                input.disabled = busy;
                if (!busy) input.focus({ preventScroll: true });
            }
        };

        const handleQuerySubmit = async (query: string) => {
            if (!query || !input || !messagesContainer) return;

            starters?.remove();
            setBusy(true);
            addMessage(query, "user");
            input.value = "";
            const typingId = showTypingIndicator();

            try {
                // Detect language (simple check: if contains Indonesian words, use 'id')
                const hasIndonesian = /\b(apa|siapa|dimana|kenapa|bagaimana|saya|kamu|anda|gue|lo)\b/i.test(query);
                const lang = hasIndonesian ? 'id' : 'en';

                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: query, history: conversationHistory, lang: lang })
                });

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
                    throw new Error(errorData.error || 'API request failed');
                }

                const data = await response.json();
                const aiResponse = data.response || (isId ? 'Maaf, ada error. Coba lagi ya!' : 'Sorry, an error occurred. Please try again!');

                conversationHistory.push(
                    { role: 'user', content: query },
                    { role: 'assistant', content: aiResponse }
                );

                // Keep only last 10 messages (5 exchanges) for server context
                if (conversationHistory.length > 10) {
                    conversationHistory = conversationHistory.slice(-10);
                }

                // Jika terkonfirmasi kekasih (server girlfriend-mode ATAU nama lengkap di pesan),
                // simpan status + history di HP dia agar AI selalu ingat.
                try {
                    const isGf = (data.model && String(data.model).includes('girlfriend')) || data.girlfriend === true || containsGirlfriendNameLocal(query);
                    if (isGf) {
                        localStorage.setItem(GF_KEY, '1');
                        localStorage.setItem(GF_HIST, JSON.stringify(conversationHistory.slice(-20)));
                    } else if (localStorage.getItem(GF_KEY) === '1') {
                        // Sesi kekasih lanjutan: tetap simpan agar ingatan tidak putus
                        localStorage.setItem(GF_HIST, JSON.stringify(conversationHistory.slice(-20)));
                    }
                } catch { /* abaikan */ }

                // Short "human" pause only (the answer is already here) — keeps the chat feeling instant
                const typingDelay = Math.min(Math.max(500, aiResponse.length * 5), 1500);

                setTimeout(() => {
                    if (typingId) removeTypingIndicator(typingId);
                    addMessage(aiResponse, "ai");
                    setBusy(false);
                }, typingDelay);
            } catch (error: any) {
                console.error("AI Error:", error);
                if (typingId) removeTypingIndicator(typingId);
                addMessage(error.message || (isId ? "Maaf, terjadi kesalahan. Coba lagi nanti." : "Sorry, something went wrong. Please try again later."), "ai");
                setBusy(false);
            }
        };

        form?.addEventListener("submit", (e) => {
            e.preventDefault();
            if (input) handleQuerySubmit(input.value.trim());
        }, { signal });

        starters?.addEventListener("click", (e) => {
            const b = (e.target as Element).closest<HTMLElement>("[data-q]");
            if (b) handleQuerySubmit(b.dataset.q || "");
        }, { signal });

        // Security: escape first, then allow only **bold** and line breaks
        const escapeHtml = (unsafe: string) =>
            unsafe.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        const renderMessage = (content: string) =>
            escapeHtml(content).replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>").replace(/\n/g, "<br>");

        function addMessage(text: string, sender: "user" | "ai") {
            if (!messagesContainer) return;

            // Extract suggestions [[Suggestion]]
            const suggestions: string[] = [];
            const cleanText = text.replace(/\[\[(.*?)\]\]/g, (_m, p1) => {
                suggestions.push(p1);
                return "";
            });

            const isAi = sender === "ai";
            const div = document.createElement("div");
            div.className = `aic-msg ${isAi ? "aic-msg--ai" : "aic-msg--user"}`;
            div.innerHTML = `${isAi ? `<img src="/wisnu-avatar-96.webp" alt="" width="32" height="32" class="aic-msg-av" />` : ""}<div class="aic-bubble">${renderMessage(cleanText.trim())}</div>`;
            messagesContainer.appendChild(div);

            // Render Suggestions as clickable chips
            if (isAi && suggestions.length > 0) {
                const suggestionDiv = document.createElement("div");
                suggestionDiv.className = "aic-starters";
                suggestions.forEach((s) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "aic-chip";
                    btn.setAttribute("aria-label", s);
                    btn.textContent = s;
                    btn.onclick = () => { suggestionDiv.remove(); handleQuerySubmit(s); };
                    suggestionDiv.appendChild(btn);
                });
                messagesContainer.appendChild(suggestionDiv);
            }

            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showTypingIndicator() {
            if (!messagesContainer) return null;
            const id = "typing-" + Date.now();
            const div = document.createElement("div");
            div.id = id;
            div.className = "aic-msg aic-msg--ai";
            div.innerHTML = `<img src="/wisnu-avatar-96.webp" alt="" width="32" height="32" class="aic-msg-av" />
                <div class="aic-bubble aic-typing" role="status" aria-label="${isId ? "sedang mengetik" : "typing"}"><i></i><i></i><i></i></div>`;
            messagesContainer.appendChild(div);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return id;
        }
        function removeTypingIndicator(id: string) {
            document.getElementById(id)?.remove();
        }
    };

    // fires on first load and after every client-side navigation
    document.addEventListener("astro:page-load", initChatBot);
    document.addEventListener("astro:before-swap", () => ctl?.abort());
</script>

<style is:global>
  .aic { font-family: var(--font-sans); }

  /* ---------- launcher ---------- */
  .aic-fab {
    position: fixed; right: 24px; bottom: 24px; z-index: 50;
    display: none; align-items: center; gap: 12px;
    padding: 6px 18px 6px 6px; border-radius: 999px;
    background: #0A0A0A; color: #fff; cursor: pointer;
    border: 1px solid rgba(132, 225, 12, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 0 rgba(132, 225, 12, 0.35);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    animation: aic-ring 3.2s ease-out 2s 2;
  }
  @media (min-width: 768px) { .aic-fab { display: inline-flex; } }
  .aic-fab:hover { transform: translateY(-2px); border-color: #84E10C; box-shadow: 0 14px 36px rgba(0, 0, 0, 0.5), 0 0 28px rgba(132, 225, 12, 0.25); }
  .aic-fab:active { transform: scale(0.97); }
  .aic-fab:focus-visible, .aic-icon:focus-visible, .aic-chip:focus-visible, .aic-send:focus-visible { outline: 2px solid #84E10C; outline-offset: 2px; }
  .aic-fab-txt { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.15; text-align: left; }
  .aic-fab-txt b { font-size: 14px; font-weight: 600; }
  .aic-fab-txt small { font-size: 10.5px; color: rgba(255, 255, 255, 0.55); }
  @keyframes aic-ring { 0% { box-shadow: 0 10px 30px rgba(0,0,0,.45), 0 0 0 0 rgba(132,225,12,.45); } 70%,100% { box-shadow: 0 10px 30px rgba(0,0,0,.45), 0 0 0 16px rgba(132,225,12,0); } }

  .aic-ava { position: relative; display: inline-flex; flex-shrink: 0; }
  .aic-ava img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.18); }
  .aic-dot { position: absolute; right: 0; bottom: 0; width: 11px; height: 11px; border-radius: 50%; background: #84E10C; border: 2px solid #0A0A0A; }

  /* ---------- window ---------- */
  .aic-win {
    position: fixed; z-index: 120; left: 12px; right: 12px; bottom: 76px;
    display: flex; flex-direction: column; max-height: min(70dvh, 560px);
    background: rgba(12, 12, 12, 0.97); color: #f1f1f1;
    border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 22px; overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(132, 225, 12, 0.07);
    visibility: hidden; opacity: 0; transform: translateY(14px) scale(0.97); transform-origin: bottom right; pointer-events: none;
    transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.28s;
  }
  .aic-win.is-open { visibility: visible; opacity: 1; transform: none; pointer-events: auto; transition-delay: 0s; }
  @media (min-width: 768px) { .aic-win { left: auto; right: 24px; bottom: 92px; width: 392px; max-height: 540px; } }

  .aic-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; flex-shrink: 0;
    background: radial-gradient(120% 140% at 100% 0%, rgba(132, 225, 12, 0.16), transparent 60%), #0f0f0f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .aic-head-txt { flex: 1; min-width: 0; }
  .aic-head-txt h3 { margin: 0; font-family: var(--font-sans); font-size: 14.5px; font-weight: 600; color: #fff; line-height: 1.2; }
  .aic-head-txt p { margin: 2px 0 0; font-size: 11px; color: #84E10C; font-weight: 500; letter-spacing: 0.02em; }
  .aic-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 0; background: transparent; color: rgba(255, 255, 255, 0.7); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .aic-icon:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

  .aic-msgs { flex: 1; min-height: 240px; overflow-y: auto; overscroll-behavior: contain; padding: 16px 14px; display: flex; flex-direction: column; gap: 12px; scroll-behavior: smooth; border-bottom: 1px solid rgba(255,255,255,.08); }
  .aic-msg { display: flex; gap: 10px; align-items: flex-start; max-width: 100%; animation: aic-in 0.3s ease both; }
  .aic-msg--user { flex-direction: row-reverse; }
  .aic-msg-av { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(255, 255, 255, 0.16); }
  .aic-bubble { padding: 10px 13px; border-radius: 16px; font-size: 13.5px; line-height: 1.55; max-width: 86%; word-break: break-word; }
  .aic-msg--ai .aic-bubble { background: #181818; border: 1px solid rgba(255, 255, 255, 0.09); color: #e9e9e9; border-top-left-radius: 5px; }
  .aic-msg--user .aic-bubble { background: #84E10C; color: #0A0A0A; font-weight: 500; border-top-right-radius: 5px; }
  .aic-bubble strong { font-weight: 600; color: inherit; }
  .aic-msg--ai .aic-bubble strong { color: #b4f461; }
  @keyframes aic-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .aic-typing { display: inline-flex; gap: 5px; align-items: center; padding: 14px 15px; }
  .aic-typing i { width: 7px; height: 7px; border-radius: 50%; background: #84E10C; opacity: 0.4; animation: aic-bounce 1.2s infinite ease-in-out; }
  .aic-typing i:nth-child(2) { animation-delay: 0.15s; }
  .aic-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes aic-bounce { 0%, 70%, 100% { transform: translateY(0); opacity: 0.4; } 35% { transform: translateY(-5px); opacity: 1; } }

  .aic-starters { display: flex; flex-wrap: wrap; gap: 7px; margin-left: 42px; animation: aic-in 0.4s ease 0.15s both; }
  .aic-starters--dock { margin: 0; padding: 8px 12px 0; flex-wrap: nowrap; overflow-x: auto; flex-shrink: 0; background: #0f0f0f; scrollbar-width: none; }
  .aic-starters--dock::-webkit-scrollbar { display: none; }
  .aic-starters--dock .aic-chip { white-space: nowrap; flex-shrink: 0; }
  .aic-chip { padding: 7px 12px; border-radius: 999px; background: transparent; color: #cfe9a8; font: inherit; font-size: 12px; cursor: pointer;
    border: 1px solid rgba(132, 225, 12, 0.4); transition: background 0.2s, color 0.2s, transform 0.15s; }
  .aic-chip:hover { background: #84E10C; color: #0A0A0A; }
  .aic-chip:active { transform: scale(0.96); }

  .aic-form { display: flex; gap: 8px; padding: 10px 12px; flex-shrink: 0; background: #0f0f0f; }
  .aic-form input { flex: 1; min-width: 0; padding: 11px 15px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); background: #171717; color: #fff;
    font: inherit; font-size: 16px; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
